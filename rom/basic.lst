AF3E  0A                    asl
AF3F  18                    clc
AF40  69 05                 adc #5
AF42  A8                    tay                     ; 見出しの中の次元の大きさの位置
AF43  B1 AF                 lda (index1),Y
AF45  85 C0                 sta bt0
AF47  C8                    iny
AF48  B1 AF                 lda (index1),Y
AF4A  85 C1                 sta bt1
AF4C  DA                    phx
AF4D  20 AB AF              jsr mul16
AF50  FA                    plx
AF51  68                    pla                     ; 添字(下位)
AF52  85 C4                 sta bt4
AF54  68                    pla                     ; 添字(上位)
AF55  85 C5                 sta bt5
                            ; 添字 < 大きさ か
AF57  C5 C1                 cmp bt1
AF59  90 08                 bcc pe_ok
AF5B  D0 49                 bne pe_bs
AF5D  A5 C4                 lda bt4
AF5F  C5 C0                 cmp bt0
AF61  B0 43                 bcs pe_bs
                    pe_ok:
AF63  18                    clc
AF64  A5 C2                 lda bt2
AF66  65 C4                 adc bt4
AF68  85 C2                 sta bt2
AF6A  A5 C3                 lda bt3
AF6C  65 C5                 adc bt5
AF6E  85 C3                 sta bt3
AF70  CA                    dex
AF71  10 CA                 bpl pe_1
                            ; 番地 = 見出し + 5 + 2 × 次元数 + 番号 × (5 か 3)
AF73  A5 C2                 lda bt2
AF75  85 C0                 sta bt0
AF77  A5 C3                 lda bt3
AF79  85 C1                 sta bt1
AF7B  A9 05                 lda #5
AF7D  A6 9C                 ldx valtyp
AF7F  F0 02                 beq pe_2
AF81  A9 03                 lda #3
                    pe_2:
AF83  85 C4                 sta bt4
AF85  20 DB AF              jsr mul_small
AF88  A0 04                 ldy #4
AF8A  B1 AF                 lda (index1),Y
AF8C  0A                    asl
AF8D  69 05                 adc #5
AF8F  18                    clc
AF90  65 C0                 adc bt0
AF92  85 C0                 sta bt0
AF94  90 02                 bcc pe_3
AF96  E6 C1                 inc bt1
                    pe_3:
AF98  18                    clc
AF99  A5 AF                 lda index1
AF9B  65 C0                 adc bt0
AF9D  85 9D                 sta varptr
AF9F  A5 B0                 lda index1+1
AFA1  65 C1                 adc bt1
AFA3  85 9E                 sta varptr+1
AFA5  60                    rts
                    pe_bs:
                            ; スタックの残りの添字は、エラー処理でスタックごと捨てる
AFA6  A2 07                 ldx #EN_BS
AFA8  4C 8E A8              jmp b_error
                    
                    ; bt2/bt3 = bt2/bt3 × bt0/bt1(符号なし16ビット)。あふれたら C=1
                    mul16:
AFAB  64 C4                 stz bt4
AFAD  64 C5                 stz bt5
AFAF  A2 10                 ldx #16
                    m16_1:
AFB1  06 C4                 asl bt4
AFB3  26 C5                 rol bt5
AFB5  B0 22                 bcs m16_ov
AFB7  06 C2                 asl bt2
AFB9  26 C3                 rol bt3
AFBB  90 0F                 bcc m16_2
AFBD  18                    clc
AFBE  A5 C4                 lda bt4
AFC0  65 C0                 adc bt0
AFC2  85 C4                 sta bt4
AFC4  A5 C5                 lda bt5
AFC6  65 C1                 adc bt1
AFC8  85 C5                 sta bt5
AFCA  B0 0D                 bcs m16_ov
                    m16_2:
AFCC  CA                    dex
AFCD  D0 E2                 bne m16_1
AFCF  A5 C4                 lda bt4
AFD1  85 C2                 sta bt2
AFD3  A5 C5                 lda bt5
AFD5  85 C3                 sta bt3
AFD7  18                    clc
AFD8  60                    rts
                    m16_ov:
AFD9  38                    sec
AFDA  60                    rts
                    
                    ; bt0/bt1 = bt0/bt1 × bt4(3 か 5)。あふれたら C=1
                    mul_small:
AFDB  A5 C0                 lda bt0
AFDD  85 C2                 sta bt2
AFDF  A5 C1                 lda bt1
AFE1  85 C3                 sta bt3
AFE3  06 C0                 asl bt0                 ; ×2
AFE5  26 C1                 rol bt1
AFE7  B0 1A                 bcs ms_ov
AFE9  A5 C4                 lda bt4
AFEB  C9 03                 cmp #3
AFED  F0 06                 beq ms_add
AFEF  06 C0                 asl bt0                 ; ×4
AFF1  26 C1                 rol bt1
AFF3  B0 0E                 bcs ms_ov
                    ms_add:
AFF5  18                    clc
AFF6  A5 C0                 lda bt0
AFF8  65 C2                 adc bt2
AFFA  85 C0                 sta bt0
AFFC  A5 C1                 lda bt1
AFFE  65 C3                 adc bt3
B000  85 C1                 sta bt1
B002  60                    rts
                    ms_ov:
B003  38                    sec
B004  60                    rts
                    
                    ; index1 から movlen バイトを 0 にする
                    zero_fill:
B005  A5 AF                 lda index1
B007  85 BA                 sta dest
B009  A5 B0                 lda index1+1
B00B  85 BB                 sta dest+1
B00D  A9 00                 lda #0
B00F  A6 BF                 ldx movlen+1
B011  F0 0C                 beq zf_2
B013  A0 00                 ldy #0
                    zf_1:
B015  91 BA                 sta (dest),Y
B017  C8                    iny
B018  D0 FB                 bne zf_1
B01A  E6 BB                 inc dest+1
B01C  CA                    dex
B01D  D0 F6                 bne zf_1
                    zf_2:
B01F  A4 BE                 ldy movlen
B021  F0 07                 beq zf_4
                    zf_3:
B023  88                    dey
B024  91 BA                 sta (dest),Y
B026  C0 00                 cpy #0
B028  D0 F9                 bne zf_3
                    zf_4:
B02A  60                    rts
                    
                    ; ===================================================================
                    ; 関数の表(TK_SGN から)
                    ; ===================================================================
                    func_table:
B02B  6A B0 81 B0 +         .word fn_sgn, fn_int, fn_abs, fn_fre, fn_sqr, fn_rnd, fn_ln, fn_log, fn_exp
B03D  9C CE 89 CE +         .word fn_cos, fn_sin, fn_tan, fn_atn, fn_peek, fn_len, fn_strs, fn_val, fn_asc
B04F  D8 B3 1D B4 +         .word fn_chrs, fn_hexs, fn_point, fn_pi, fn_inkeys, fn_lefts, fn_rights, fn_mids, fn_instr
                    
                    ; ( 式 ) を数として読む
                    par_num:
B061  20 CA A3              jsr chkopen
B064  20 40 A9              jsr frmnum
B067  4C CE A3              jmp chkclose
                    
                    fn_sgn:
B06A  20 61 B0              jsr par_num
B06D  A5 80                 lda fac_e
B06F  F0 0F                 beq fs_done
B071  A9 D4                 lda #<c_one
B073  A0 DA                 ldy #>c_one
B075  A6 85                 ldx fac_s
B077  10 04                 bpl fs_1
B079  A9 D9                 lda #<c_mone
B07B  A0 DA                 ldy #>c_mone
                    fs_1:
B07D  4C F3 D2              jmp fac_ld
                    fs_done:
B080  60                    rts
                    
                    fn_int:
B081  20 61 B0              jsr par_num
B084  4C 45 D7              jmp fac_int
                    
                    fn_abs:
B087  20 61 B0              jsr par_num
B08A  64 85                 stz fac_s
B08C  60                    rts
                    
                    fn_fre:
B08D  20 61 B0              jsr par_num
B090  20 52 B1              jsr garbag
B093  20 33 A9              jsr fre_bytes
B096  64 9C                 stz valtyp
B098  4C D9 D6              jmp fac_u16
                    
                    fn_peek:
B09B  20 61 B0              jsr par_num
B09E  20 78 D7              jsr getint16
B0A1  B2 B5                 lda (linnum)
B0A3  4C EC D6              jmp fac_u8
                    
                    fn_pi:
B0A6  64 9C                 stz valtyp
B0A8  A9 ED                 lda #<c_pi
B0AA  A0 DA                 ldy #>c_pi
B0AC  4C F3 D2              jmp fac_ld
                    
                    ; PX-65 BASIC: 文字列
                    ;
                    ; 文字列の記述子は3バイト(長さ、番地の下位、上位)。文字列の本体は STRTOP($7FFF)の手前から下へ
                    ; 積んでいく(fretop が下端)。プログラムの中の "..." は、プログラムの中を指したまま使う。
                    ; 足りなくなったら、使われている文字列だけを上へ詰める(garbag)。
                    
                    gc_end     = $03F3          ; 2 ガーベジコレクション: 配列の終わり
                    gc_len     = $03F5          ; いちばん上の文字列の長さ
                    gs_len     = $03F6          ; getspa の長さ
                    str_save   = $03F7          ; VAL で一時的に 0 にしたバイト
                    sub_lo     = $03F8          ; 部分文字列の元の一時記述子(番地の下位。上位は >tempst)
                    ft_a       = $03F9          ; free_ay の作業
                    ft_b       = $03FA
                    
                    ; ===================================================================
                    ; 一時記述子
                    ; ===================================================================
                    
                    ; 一時記述子を作って FAC をその文字列にする。A = 長さ、X = 番地の下位、Y = 上位
                    put_temp:
B0AF  48                    pha
B0B0  A5 B9                 lda temppt
B0B2  C9 08                 cmp #TEMPMAX
B0B4  90 03                 bcc pt_1
B0B6  4C E8 A8              jmp err_om              ; 式が複雑すぎる
                    pt_1:
B0B9  0A                    asl                     ; 3 × temppt
B0BA  65 B9                 adc temppt
B0BC  DA                    phx
B0BD  AA                    tax
B0BE  68                    pla
B0BF  9D 81 03              sta tempst+1,X
B0C2  98                    tya
B0C3  9D 82 03              sta tempst+2,X
B0C6  68                    pla
B0C7  9D 80 03              sta tempst,X
B0CA  8A                    txa
B0CB  18                    clc
B0CC  69 80                 adc #<tempst
B0CE  85 81                 sta fac_m1
B0D0  A9 03                 lda #>tempst
B0D2  85 82                 sta fac_m2
B0D4  E6 B9                 inc temppt
B0D6  A9 FF                 lda #$FF
B0D8  85 9C                 sta valtyp
B0DA  64 86                 stz fac_x
B0DC  64 80                 stz fac_e
B0DE  60                    rts
                    
                    ; FAC の文字列が一番上の一時記述子なら、それを捨てる
                    free_fac:
B0DF  A5 81                 lda fac_m1
B0E1  A4 82                 ldy fac_m2
B0E3  80 04                 bra free_ay
                    ; ARG の文字列が一番上の一時記述子なら、それを捨てる
                    free_arg:
B0E5  A5 88                 lda arg_m1
B0E7  A4 89                 ldy arg_m2
                    free_ay:
B0E9  C0 03                 cpy #>tempst
B0EB  D0 19                 bne fr_done
B0ED  A6 B9                 ldx temppt
B0EF  F0 15                 beq fr_done
B0F1  8D F9 03              sta ft_a
B0F4  CA                    dex
B0F5  8A                    txa
B0F6  8D FA 03              sta ft_b
B0F9  0A                    asl
B0FA  6D FA 03              adc ft_b                ; 3 × (temppt - 1)
B0FD  69 80                 adc #<tempst
B0FF  CD F9 03              cmp ft_a
B102  D0 02                 bne fr_done
B104  C6 B9                 dec temppt
                    fr_done:
B106  60                    rts
                    
                    ; FAC の文字列の長さを A に、番地を strp に
                    fac_str:
B107  A5 81                 lda fac_m1
B109  85 D4                 sta strp2
B10B  A5 82                 lda fac_m2
B10D  85 D5                 sta strp2+1
B10F  A0 01                 ldy #1
B111  B1 D4                 lda (strp2),Y
B113  85 D2                 sta strp
B115  C8                    iny
B116  B1 D4                 lda (strp2),Y
B118  85 D3                 sta strp+1
B11A  B2 D4                 lda (strp2)
B11C  60                    rts
                    
                    ; ===================================================================
                    ; 文字列の領域
                    ; ===================================================================
                    
                    ; A バイトの文字列の場所を取る。strp = 番地。足りなければ詰め直し、それでもなければ OM
                    getspa:
B11D  8D F6 03              sta gs_len
B120  20 31 B1              jsr gs_try
B123  90 0B                 bcc gs_ok
B125  20 52 B1              jsr garbag
B128  20 31 B1              jsr gs_try
B12B  90 03                 bcc gs_ok
B12D  4C E8 A8              jmp err_om
                    gs_ok:
B130  60                    rts
                    gs_try:
B131  38                    sec                     ; fretop - 長さ
B132  A5 A7                 lda fretop
B134  ED F6 03              sbc gs_len
B137  AA                    tax
B138  A5 A8                 lda fretop+1
B13A  E9 00                 sbc #0
B13C  C5 A6                 cmp strend+1            ; >= strend か
B13E  90 10                 bcc gst_no
B140  D0 04                 bne gst_yes
B142  E4 A5                 cpx strend
B144  90 0A                 bcc gst_no
                    gst_yes:
B146  85 A8                 sta fretop+1
B148  86 A7                 stx fretop
B14A  85 D3                 sta strp+1
B14C  86 D2                 stx strp
B14E  18                    clc
B14F  60                    rts
                    gst_no:
B150  38                    sec
B151  60                    rts
                    
                    ; 使われている文字列だけを STRTOP の下に詰める
                    garbag:
B152  A9 FF                 lda #<STRTOP
B154  85 D8                 sta gclim
B156  85 DC                 sta gcnew
B158  A9 7F                 lda #>STRTOP
B15A  85 D9                 sta gclim+1
B15C  85 DD                 sta gcnew+1
                    gc_round:
B15E  64 DA                 stz gcbest              ; まだ動かしていない中で、一番上の文字列を探す
B160  64 DB                 stz gcbest+1
B162  9C DC 03              stz gcflag
B165  20 AF B1              jsr gc_scan
B168  A5 DB                 lda gcbest+1
B16A  F0 3A                 beq gc_done             ; もうない
B16C  38                    sec                     ; 動かす先 = gcnew - 長さ
B16D  A5 DC                 lda gcnew
B16F  ED F5 03              sbc gc_len
B172  85 BA                 sta dest
B174  A5 DD                 lda gcnew+1
B176  E9 00                 sbc #0
B178  85 BB                 sta dest+1
B17A  A5 DA                 lda gcbest
B17C  85 BC                 sta srcp
B17E  A5 DB                 lda gcbest+1
B180  85 BD                 sta srcp+1
B182  AD F5 03              lda gc_len
B185  85 BE                 sta movlen
B187  64 BF                 stz movlen+1
B189  20 77 A6              jsr move_up
B18C  A5 BA                 lda dest
B18E  85 DC                 sta gcnew
B190  A5 BB                 lda dest+1
B192  85 DD                 sta gcnew+1
B194  A9 01                 lda #1                  ; その文字列を指す記述子を全部書き換える
B196  8D DC 03              sta gcflag
B199  20 AF B1              jsr gc_scan
B19C  A5 DA                 lda gcbest
B19E  85 D8                 sta gclim
B1A0  A5 DB                 lda gcbest+1
B1A2  85 D9                 sta gclim+1
B1A4  80 B8                 bra gc_round
                    gc_done:
B1A6  A5 DC                 lda gcnew
B1A8  85 A7                 sta fretop
B1AA  A5 DD                 lda gcnew+1
B1AC  85 A8                 sta fretop+1
B1AE  60                    rts
                    
                    ; すべての文字列の記述子について gc_visit を呼ぶ(変数、配列、一時記述子)
                    gc_scan:
B1AF  A5 A1                 lda vartab
B1B1  85 B1                 sta index2
B1B3  A5 A2                 lda vartab+1
B1B5  85 B2                 sta index2+1
                    gsc_1:
B1B7  A5 B1                 lda index2
B1B9  C5 A3                 cmp arytab
B1BB  D0 06                 bne gsc_2
B1BD  A5 B2                 lda index2+1
B1BF  C5 A4                 cmp arytab+1
B1C1  F0 23                 beq gsc_arr
                    gsc_2:
B1C3  A0 01                 ldy #1
B1C5  B1 B1                 lda (index2),Y
B1C7  10 10                 bpl gsc_3               ; 数の変数
B1C9  18                    clc
B1CA  A5 B1                 lda index2
B1CC  69 02                 adc #2
B1CE  85 D6                 sta gcp
B1D0  A5 B2                 lda index2+1
B1D2  69 00                 adc #0
B1D4  85 D7                 sta gcp+1
B1D6  20 64 B2              jsr gc_visit
                    gsc_3:
B1D9  18                    clc
B1DA  A5 B1                 lda index2
B1DC  69 07                 adc #7
B1DE  85 B1                 sta index2
B1E0  90 D5                 bcc gsc_1
B1E2  E6 B2                 inc index2+1
B1E4  80 D1                 bra gsc_1
                    gsc_arr:
B1E6  A5 B1                 lda index2
B1E8  C5 A5                 cmp strend
B1EA  D0 06                 bne gsc_a1
B1EC  A5 B2                 lda index2+1
B1EE  C5 A6                 cmp strend+1
B1F0  F0 54                 beq gsc_tmp
                    gsc_a1:
B1F2  A0 02                 ldy #2                  ; 配列の終わり
B1F4  18                    clc
B1F5  B1 B1                 lda (index2),Y
B1F7  65 B1                 adc index2
B1F9  8D F3 03              sta gc_end
B1FC  C8                    iny
B1FD  B1 B1                 lda (index2),Y
B1FF  65 B2                 adc index2+1
B201  8D F4 03              sta gc_end+1
B204  A0 01                 ldy #1
B206  B1 B1                 lda (index2),Y
B208  10 30                 bpl gsc_anext           ; 数の配列
B20A  A0 04                 ldy #4                  ; 最初の要素 = 見出し + 5 + 2 × 次元数
B20C  B1 B1                 lda (index2),Y
B20E  0A                    asl
B20F  69 05                 adc #5
B211  18                    clc
B212  65 B1                 adc index2
B214  85 D6                 sta gcp
B216  A5 B2                 lda index2+1
B218  69 00                 adc #0
B21A  85 D7                 sta gcp+1
                    gsc_a2:
B21C  A5 D6                 lda gcp
B21E  CD F3 03              cmp gc_end
B221  D0 07                 bne gsc_a3
B223  A5 D7                 lda gcp+1
B225  CD F4 03              cmp gc_end+1
B228  F0 10                 beq gsc_anext
                    gsc_a3:
B22A  20 64 B2              jsr gc_visit
B22D  18                    clc
B22E  A5 D6                 lda gcp
B230  69 03                 adc #3
B232  85 D6                 sta gcp
B234  90 E6                 bcc gsc_a2
B236  E6 D7                 inc gcp+1
B238  80 E2                 bra gsc_a2
                    gsc_anext:
B23A  AD F3 03              lda gc_end
B23D  85 B1                 sta index2
B23F  AD F4 03              lda gc_end+1
B242  85 B2                 sta index2+1
B244  80 A0                 bra gsc_arr
                    gsc_tmp:
B246  A9 80                 lda #<tempst
B248  85 D6                 sta gcp
B24A  A9 03                 lda #>tempst
B24C  85 D7                 sta gcp+1
B24E  A2 00                 ldx #0
                    gsc_t1:
B250  E4 B9                 cpx temppt
B252  F0 0F                 beq gsc_done
B254  DA                    phx
B255  20 64 B2              jsr gc_visit
B258  FA                    plx
B259  18                    clc
B25A  A5 D6                 lda gcp
B25C  69 03                 adc #3
B25E  85 D6                 sta gcp
B260  E8                    inx
B261  80 ED                 bra gsc_t1
                    gsc_done:
B263  60                    rts
                    
                    ; gcp の記述子を調べる。gcflag 0: 一番上の文字列を探す、1: 動かした文字列の番地を書き換える
                    gc_visit:
B264  B2 D6                 lda (gcp)
B266  F0 36                 beq gv_ret              ; 空の文字列
B268  A0 01                 ldy #1
B26A  B1 D6                 lda (gcp),Y
B26C  AA                    tax
B26D  C8                    iny
B26E  B1 D6                 lda (gcp),Y             ; 番地 = A(上位)X(下位)
B270  AC DC 03              ldy gcflag
B273  D0 2A                 bne gv_update
                            ; 文字列の領域の中(>= fretop)か
B275  C5 A8                 cmp fretop+1
B277  90 25                 bcc gv_ret
B279  D0 04                 bne gv_1
B27B  E4 A7                 cpx fretop
B27D  90 1F                 bcc gv_ret
                    gv_1:
                            ; まだ動かしていない(< gclim)か
B27F  C5 D9                 cmp gclim+1
B281  90 06                 bcc gv_2
B283  D0 19                 bne gv_ret
B285  E4 D8                 cpx gclim
B287  B0 15                 bcs gv_ret
                    gv_2:
                            ; いままでの候補より上か
B289  C5 DB                 cmp gcbest+1
B28B  90 11                 bcc gv_ret
B28D  D0 06                 bne gv_best
B28F  E4 DA                 cpx gcbest
B291  90 0B                 bcc gv_ret
B293  F0 09                 beq gv_ret
                    gv_best:
B295  85 DB                 sta gcbest+1
B297  86 DA                 stx gcbest
B299  B2 D6                 lda (gcp)
B29B  8D F5 03              sta gc_len
                    gv_ret:
B29E  60                    rts
                    gv_update:
B29F  C5 DB                 cmp gcbest+1
B2A1  D0 FB                 bne gv_ret
B2A3  E4 DA                 cpx gcbest
B2A5  D0 F7                 bne gv_ret
B2A7  A0 01                 ldy #1
B2A9  A5 BA                 lda dest
B2AB  91 D6                 sta (gcp),Y
B2AD  C8                    iny
B2AE  A5 BB                 lda dest+1
B2B0  91 D6                 sta (gcp),Y
B2B2  60                    rts
                    
                    ; ===================================================================
                    ; 連結と比較
                    ; ===================================================================
                    
                    ; FAC = ARG + FAC(文字列)
                    str_concat:
B2B3  A5 88                 lda arg_m1
B2B5  85 D4                 sta strp2
B2B7  A5 89                 lda arg_m2
B2B9  85 D5                 sta strp2+1
B2BB  B2 D4                 lda (strp2)
B2BD  85 C0                 sta bt0                 ; 左の長さ
B2BF  20 07 B1              jsr fac_str
B2C2  85 C1                 sta bt1                 ; 右の長さ
B2C4  18                    clc
B2C5  65 C0                 adc bt0
B2C7  90 05                 bcc sc_1
B2C9  A2 09                 ldx #EN_LS
B2CB  4C 8E A8              jmp b_error
                    sc_1:
B2CE  85 C2                 sta bt2                 ; 合わせた長さ
B2D0  20 1D B1              jsr getspa
B2D3  A5 D2                 lda strp
B2D5  85 BA                 sta dest
B2D7  A5 D3                 lda strp+1
B2D9  85 BB                 sta dest+1
B2DB  A5 88                 lda arg_m1              ; 左を写す(詰め直しで動いたかもしれないので記述子から読み直す)
B2DD  A4 89                 ldy arg_m2
B2DF  20 03 B3              jsr copy_desc
B2E2  18                    clc
B2E3  A5 BA                 lda dest
B2E5  65 C0                 adc bt0
B2E7  85 BA                 sta dest
B2E9  90 02                 bcc sc_2
B2EB  E6 BB                 inc dest+1
                    sc_2:
B2ED  A5 81                 lda fac_m1              ; 右を写す
B2EF  A4 82                 ldy fac_m2
B2F1  20 03 B3              jsr copy_desc
B2F4  20 DF B0              jsr free_fac
B2F7  20 E5 B0              jsr free_arg
B2FA  A5 C2                 lda bt2
B2FC  A6 D2                 ldx strp
B2FE  A4 D3                 ldy strp+1
B300  4C AF B0              jmp put_temp
                    
                    ; A(下位)Y(上位)の記述子の文字列を dest へ写す(dest は変えない)。X, bt0-bt2 は保存
                    copy_desc:
B303  85 D4                 sta strp2
B305  84 D5                 sty strp2+1
B307  A0 01                 ldy #1
B309  B1 D4                 lda (strp2),Y
B30B  85 BC                 sta srcp
B30D  C8                    iny
B30E  B1 D4                 lda (strp2),Y
B310  85 BD                 sta srcp+1
B312  B2 D4                 lda (strp2)
B314  A8                    tay
B315  F0 09                 beq cd_done
                    cd_1:
B317  88                    dey
B318  B1 BC                 lda (srcp),Y
B31A  91 BA                 sta (dest),Y
B31C  C0 00                 cpy #0
B31E  D0 F7                 bne cd_1
                    cd_done:
B320  60                    rts
                    
                    ; ARG と FAC の文字列を比べる。A = 1(ARG が大きい)、0、$FF(ARG が小さい)
                    str_cmp:
B321  A5 88                 lda arg_m1
B323  85 D4                 sta strp2
B325  A5 89                 lda arg_m2
B327  85 D5                 sta strp2+1
B329  B2 D4                 lda (strp2)
B32B  85 C0                 sta bt0                 ; 左の長さ
B32D  A0 01                 ldy #1
B32F  B1 D4                 lda (strp2),Y
B331  85 B1                 sta index2
B333  C8                    iny
B334  B1 D4                 lda (strp2),Y
B336  85 B2                 sta index2+1
B338  20 07 B1              jsr fac_str
B33B  85 C1                 sta bt1                 ; 右の長さ。右は strp
B33D  20 DF B0              jsr free_fac
B340  20 E5 B0              jsr free_arg
B343  A0 00                 ldy #0
                    scm_1:
B345  C4 C0                 cpy bt0
B347  F0 0D                 beq scm_lend
B349  C4 C1                 cpy bt1
B34B  F0 12                 beq scm_gt              ; 右が先に終わった
B34D  B1 B1                 lda (index2),Y
B34F  D1 D2                 cmp (strp),Y
B351  D0 0A                 bne scm_ne
B353  C8                    iny
B354  80 EF                 bra scm_1
                    scm_lend:
B356  C4 C1                 cpy bt1
B358  F0 08                 beq scm_eq
                    scm_lt:
B35A  A9 FF                 lda #$FF
B35C  60                    rts
                    scm_ne:
B35D  90 FB                 bcc scm_lt
                    scm_gt:
B35F  A9 01                 lda #1
B361  60                    rts
                    scm_eq:
B362  A9 00                 lda #0
B364  60                    rts
                    
                    ; ===================================================================
                    ; 代入
                    ; ===================================================================
                    
                    ; forpnt の変数(5バイトか3バイトの記述子)に FAC の値を入れる。型は valtyp
                    let_value:
B365  A5 9C                 lda valtyp
B367  D0 07                 bne lv_str
B369  A5 B7                 lda forpnt
B36B  A4 B8                 ldy forpnt+1
B36D  4C 45 D3              jmp fac_st
                    lv_str:
B370  20 07 B1              jsr fac_str             ; A = 長さ、strp = 本体
B373  85 C0                 sta bt0
                            ; 本体が入力行の中($0300-$03FF)なら、文字列の領域へ写す
B375  A6 D3                 ldx strp+1
B377  E0 03                 cpx #>LINEBUF
B379  D0 1E                 bne lv_store
B37B  C9 00                 cmp #0
B37D  F0 1A                 beq lv_store
B37F  20 1D B1              jsr getspa
B382  A5 D2                 lda strp
B384  85 BA                 sta dest
B386  A5 D3                 lda strp+1
B388  85 BB                 sta dest+1
B38A  A5 81                 lda fac_m1
B38C  A4 82                 ldy fac_m2
B38E  20 03 B3              jsr copy_desc
B391  A5 BA                 lda dest
B393  85 D2                 sta strp
B395  A5 BB                 lda dest+1
B397  85 D3                 sta strp+1
                    lv_store:
B399  20 DF B0              jsr free_fac
B39C  A0 00                 ldy #0
B39E  A5 C0                 lda bt0
B3A0  91 B7                 sta (forpnt),Y
B3A2  C8                    iny
B3A3  A5 D2                 lda strp
B3A5  91 B7                 sta (forpnt),Y
B3A7  C8                    iny
B3A8  A5 D3                 lda strp+1
B3AA  91 B7                 sta (forpnt),Y
B3AC  60                    rts
                    
                    ; ===================================================================
                    ; 文字列の関数
                    ; ===================================================================
                    
                    ; ( 文字列の式 ) を読む。A = 長さ、strp = 本体(一時記述子は捨てる)
                    par_str:
B3AD  20 CA A3              jsr chkopen
B3B0  20 48 A9              jsr frmstr
B3B3  20 CE A3              jsr chkclose
B3B6  20 07 B1              jsr fac_str
B3B9  48                    pha
B3BA  20 DF B0              jsr free_fac
B3BD  68                    pla
B3BE  60                    rts
                    
                    fn_len:
B3BF  20 AD B3              jsr par_str
B3C2  64 9C                 stz valtyp
B3C4  4C EC D6              jmp fac_u8
                    
                    fn_asc:
B3C7  20 AD B3              jsr par_str
B3CA  C9 00                 cmp #0
B3CC  D0 03                 bne fa_1
B3CE  4C CA DA              jmp err_fc
                    fa_1:
B3D1  B2 D2                 lda (strp)
B3D3  64 9C                 stz valtyp
B3D5  4C EC D6              jmp fac_u8
                    
                    fn_chrs:
B3D8  20 61 B0              jsr par_num
B3DB  20 C1 D7              jsr getbyte
                    make_char:                      ; A の1文字の文字列を作る
B3DE  48                    pha
B3DF  A9 01                 lda #1
B3E1  20 1D B1              jsr getspa
B3E4  68                    pla
B3E5  92 D2                 sta (strp)
B3E7  A9 01                 lda #1
                    make_str:                       ; strp からの A バイトを一時文字列に
B3E9  A6 D2                 ldx strp
B3EB  A4 D3                 ldy strp+1
B3ED  4C AF B0              jmp put_temp
                    
                    fn_inkeys:
B3F0  20 06 FF              jsr BIOS_KEYCHK
B3F3  B0 E9                 bcs make_char
B3F5  A9 00                 lda #0
B3F7  80 F0                 bra make_str
                    
                    fn_strs:
B3F9  20 61 B0              jsr par_num
B3FC  20 27 D9              jsr fout
B3FF  A2 00                 ldx #0                  ; fbuffr の長さ
                    fst_1:
B401  BD 98 03              lda fbuffr,X
B404  F0 03                 beq fst_2
B406  E8                    inx
B407  80 F8                 bra fst_1
                    fst_2:
B409  8A                    txa
                    str_from_buf:                   ; fbuffr の A バイトを文字列に
B40A  48                    pha
B40B  20 1D B1              jsr getspa
B40E  7A                    ply
B40F  5A                    phy
                    fsb_1:
B410  88                    dey
B411  30 07                 bmi fsb_2
B413  B9 98 03              lda fbuffr,Y
B416  91 D2                 sta (strp),Y
B418  80 F6                 bra fsb_1
                    fsb_2:
B41A  68                    pla
B41B  80 CC                 bra make_str
                    
                    fn_hexs:
B41D  20 61 B0              jsr par_num
B420  20 78 D7              jsr getint16
B423  A2 00                 ldx #0                  ; 16進数の4桁を fbuffr に(先頭の0は除く)
B425  A5 B6                 lda linnum+1
B427  20 50 B4              jsr hex_byte
B42A  A5 B5                 lda linnum
B42C  20 50 B4              jsr hex_byte
B42F  A2 00                 ldx #0                  ; 先頭の0を飛ばす(最後の1桁は残す)
                    fh_1:
B431  E0 03                 cpx #3
B433  F0 0A                 beq fh_2
B435  BD 98 03              lda fbuffr,X
B438  C9 30                 cmp #'0'
B43A  D0 03                 bne fh_2
B43C  E8                    inx
B43D  80 F2                 bra fh_1
                    fh_2:
B43F  A0 00                 ldy #0                  ; 前へ詰める
                    fh_3:
B441  BD 98 03              lda fbuffr,X
B444  99 98 03              sta fbuffr,Y
B447  C8                    iny
B448  E8                    inx
B449  E0 04                 cpx #4
B44B  D0 F4                 bne fh_3
B44D  98                    tya
B44E  80 BA                 bra str_from_buf
                    hex_byte:
B450  48                    pha
B451  4A                    lsr
B452  4A                    lsr
B453  4A                    lsr
B454  4A                    lsr
B455  20 5B B4              jsr hex_nib
B458  68                    pla
B459  29 0F                 and #$0F
                    hex_nib:
B45B  C9 0A                 cmp #10
B45D  90 02                 bcc hn_1
B45F  69 06                 adc #6
                    hn_1:
B461  69 30                 adc #'0'
B463  9D 98 03              sta fbuffr,X
B466  E8                    inx
B467  60                    rts
                    
                    fn_val:
B468  20 AD B3              jsr par_str
B46B  A8                    tay                     ; 文字列の後ろを一時的に 0 にして数として読む
B46C  D0 05                 bne fv_1                ; (空の文字列は番地が決まっていないことがあるので、書かずに 0)
B46E  64 9C                 stz valtyp
B470  4C A5 D3              jmp fac_zero
                    fv_1:
B473  B1 D2                 lda (strp),Y
B475  8D F7 03              sta str_save
B478  98                    tya                     ; 0 にする番地を覚える(fin が ?OV などで抜けても、
B479  18                    clc                     ;  ready と b_warm が val_restore で戻す)
B47A  65 D2                 adc strp
B47C  8D FB 02              sta val_ptr
B47F  A5 D3                 lda strp+1
B481  69 00                 adc #0
B483  8D FC 02              sta val_ptr+1
B486  A9 00                 lda #0
B488  91 D2                 sta (strp),Y
B48A  A5 98                 lda txtptr
B48C  48                    pha
B48D  A5 99                 lda txtptr+1
B48F  48                    pha
B490  A5 D2                 lda strp
B492  85 98                 sta txtptr
B494  A5 D3                 lda strp+1
B496  85 99                 sta txtptr+1
B498  5A                    phy
B499  20 F0 D7              jsr fin
B49C  7A                    ply
B49D  AD F7 03              lda str_save
B4A0  91 D2                 sta (strp),Y
B4A2  9C FC 02              stz val_ptr+1           ; 戻したので、覚えた番地を消す
B4A5  68                    pla
B4A6  85 99                 sta txtptr+1
B4A8  68                    pla
B4A9  85 98                 sta txtptr
B4AB  64 9C                 stz valtyp
B4AD  60                    rts
                    
                    ; VAL がエラーなどで途中で抜けたとき、一時的に0にしたバイトを戻す(ready と b_warm から呼ぶ)。
                    ; index1 を壊す
                    val_restore:
B4AE  AD FC 02              lda val_ptr+1
B4B1  F0 0F                 beq vr_done
B4B3  85 B0                 sta index1+1
B4B5  AD FB 02              lda val_ptr
B4B8  85 AF                 sta index1
B4BA  AD F7 03              lda str_save
B4BD  92 AF                 sta (index1)
B4BF  9C FC 02              stz val_ptr+1
                    vr_done:
B4C2  60                    rts
                    
                    ; LEFT$(s$,n) RIGHT$(s$,n) MID$(s$,p[,n])
                    ; 文字列と数を読んで、bt0 = 元の長さ、bt1 = 始め(0から)、bt2 = 長さ にしてから sub_str
                    fn_lefts:
B4C3  20 61 B5              jsr par_sn              ; ( s$ , n
B4C6  20 CE A3              jsr chkclose
B4C9  64 C1                 stz bt1
B4CB  80 3F                 bra sub_str
                    fn_rights:
B4CD  20 61 B5              jsr par_sn
B4D0  20 CE A3              jsr chkclose
B4D3  A5 C2                 lda bt2                 ; 始め = 元の長さ - n(負なら 0)
B4D5  C5 C0                 cmp bt0
B4D7  90 04                 bcc fr_1
B4D9  A5 C0                 lda bt0
B4DB  85 C2                 sta bt2
                    fr_1:
B4DD  38                    sec
B4DE  A5 C0                 lda bt0
B4E0  E5 C2                 sbc bt2
B4E2  85 C1                 sta bt1
B4E4  80 26                 bra sub_str
                    fn_mids:
B4E6  20 61 B5              jsr par_sn              ; ( s$ , p
B4E9  A5 C2                 lda bt2                 ; p は1以上
B4EB  D0 03                 bne fm_1
B4ED  4C CA DA              jmp err_fc
                    fm_1:
B4F0  3A                    dec
B4F1  85 C1                 sta bt1
B4F3  A9 FF                 lda #255
B4F5  85 C2                 sta bt2
B4F7  20 9E A3              jsr chrgot
B4FA  C9 2C                 cmp #','
B4FC  D0 0B                 bne fm_2
B4FE  20 98 A3              jsr chrget
B501  20 40 A9              jsr frmnum
B504  20 C1 D7              jsr getbyte
B507  85 C2                 sta bt2
                    fm_2:
B509  20 CE A3              jsr chkclose
                            ; そのまま sub_str へ
                    
                    ; ARG の位置の一時記述子(par_sn で積んだもの)の文字列の、bt1 から bt2 文字を新しい文字列に
                    sub_str:
B50C  A5 C1                 lda bt1                 ; 始めが長さを超えたら空
B50E  C5 C0                 cmp bt0
B510  90 04                 bcc ss_1
B512  64 C2                 stz bt2
B514  80 0B                 bra ss_2
                    ss_1:
B516  38                    sec                     ; 長さ = min(bt2, 元の長さ - 始め)
B517  A5 C0                 lda bt0
B519  E5 C1                 sbc bt1
B51B  C5 C2                 cmp bt2
B51D  B0 02                 bcs ss_2
B51F  85 C2                 sta bt2
                    ss_2:
B521  A5 C2                 lda bt2
B523  20 1D B1              jsr getspa              ; ここで詰め直しが起きても記述子は書き換わる
B526  A5 D2                 lda strp
B528  85 BA                 sta dest
B52A  A5 D3                 lda strp+1
B52C  85 BB                 sta dest+1
B52E  AD F8 03              lda sub_lo              ; 元の文字列(記述子から読み直す)
B531  85 D4                 sta strp2
B533  A9 03                 lda #>tempst
B535  85 D5                 sta strp2+1
B537  A0 01                 ldy #1
B539  B1 D4                 lda (strp2),Y
B53B  18                    clc
B53C  65 C1                 adc bt1
B53E  85 BC                 sta srcp
B540  C8                    iny
B541  B1 D4                 lda (strp2),Y
B543  69 00                 adc #0
B545  85 BD                 sta srcp+1
B547  A4 C2                 ldy bt2
B549  F0 09                 beq ss_4
                    ss_3:
B54B  88                    dey
B54C  B1 BC                 lda (srcp),Y
B54E  91 BA                 sta (dest),Y
B550  C0 00                 cpy #0
B552  D0 F7                 bne ss_3
                    ss_4:
B554  AD F8 03              lda sub_lo              ; 元の一時記述子を捨てる
B557  A0 03                 ldy #>tempst
B559  20 E9 B0              jsr free_ay
B55C  A5 C2                 lda bt2
B55E  4C E9 B3              jmp make_str
                    
                    ; ( 文字列 , 数 を読む。sub_lo = 文字列の一時記述子、bt0 = その長さ、bt2 = 数(0-255)
                    par_sn:
B561  20 CA A3              jsr chkopen
B564  20 48 A9              jsr frmstr
B567  B2 81                 lda (fac_m1)
B569  48                    pha
B56A  A5 81                 lda fac_m1
B56C  48                    pha
B56D  20 C6 A3              jsr chkcom
B570  20 40 A9              jsr frmnum
B573  20 C1 D7              jsr getbyte
B576  85 C2                 sta bt2
B578  68                    pla
B579  8D F8 03              sta sub_lo
B57C  68                    pla
B57D  85 C0                 sta bt0
B57F  60                    rts
                    
                    ; INSTR([p,]s$,t$)
                    fn_instr:
B580  20 CA A3              jsr chkopen
B583  A9 01                 lda #1
B585  85 C3                 sta bt3                 ; 探し始める位置(1から)
B587  20 53 A9              jsr frmevl
B58A  A5 9C                 lda valtyp
B58C  D0 12                 bne fi_s
B58E  20 C1 D7              jsr getbyte             ; 最初が数なら位置
B591  C9 00                 cmp #0
B593  D0 03                 bne fi_p
B595  4C CA DA              jmp err_fc
                    fi_p:
B598  85 C3                 sta bt3
B59A  20 C6 A3              jsr chkcom
B59D  20 48 A9              jsr frmstr
                    fi_s:
B5A0  A5 81                 lda fac_m1              ; s$ の記述子を積む
B5A2  48                    pha
B5A3  A5 82                 lda fac_m2
B5A5  48                    pha
B5A6  A5 C3                 lda bt3
B5A8  48                    pha
B5A9  20 C6 A3              jsr chkcom
B5AC  20 48 A9              jsr frmstr
B5AF  20 CE A3              jsr chkclose
B5B2  68                    pla
B5B3  85 C3                 sta bt3
B5B5  68                    pla
B5B6  85 D5                 sta strp2+1
B5B8  68                    pla
B5B9  85 D4                 sta strp2
                            ; s$ = index2(本体)、bt0(長さ)。t$ = strp(本体)、bt1(長さ)
B5BB  A0 01                 ldy #1
B5BD  B1 D4                 lda (strp2),Y
B5BF  85 B1                 sta index2
B5C1  C8                    iny
B5C2  B1 D4                 lda (strp2),Y
B5C4  85 B2                 sta index2+1
B5C6  B2 D4                 lda (strp2)
B5C8  85 C0                 sta bt0
B5CA  A5 D4                 lda strp2
B5CC  48                    pha
B5CD  A5 D5                 lda strp2+1
B5CF  48                    pha
B5D0  20 07 B1              jsr fac_str
B5D3  85 C1                 sta bt1
B5D5  20 DF B0              jsr free_fac
B5D8  68                    pla
B5D9  A8                    tay
B5DA  68                    pla
B5DB  20 E9 B0              jsr free_ay
                            ; 位置 p から探す
B5DE  A6 C3                 ldx bt3
B5E0  CA                    dex                     ; X = 0 から数えた位置
                    fi_1:
B5E1  8A                    txa                     ; 残り(長さ - X)が t$ より短ければ見つからない
B5E2  18                    clc
B5E3  65 C1                 adc bt1
B5E5  B0 28                 bcs fi_no
B5E7  C5 C0                 cmp bt0
B5E9  F0 02                 beq fi_2
B5EB  B0 22                 bcs fi_no
                    fi_2:
B5ED  A0 00                 ldy #0                  ; X の位置で比べる
                    fi_3:
B5EF  C4 C1                 cpy bt1
B5F1  F0 15                 beq fi_yes
B5F3  84 C4                 sty bt4
B5F5  8A                    txa
B5F6  18                    clc
B5F7  65 C4                 adc bt4
B5F9  A8                    tay
B5FA  B1 B1                 lda (index2),Y
B5FC  A4 C4                 ldy bt4
B5FE  D1 D2                 cmp (strp),Y
B600  D0 03                 bne fi_next
B602  C8                    iny
B603  80 EA                 bra fi_3
                    fi_next:
B605  E8                    inx
B606  80 D9                 bra fi_1
                    fi_yes:
B608  E8                    inx                     ; 1から数えた位置
B609  8A                    txa
B60A  64 9C                 stz valtyp
B60C  4C EC D6              jmp fac_u8
                    fi_no:
B60F  A9 00                 lda #0
B611  64 9C                 stz valtyp
B613  4C EC D6              jmp fac_u8
                    
                    ; PX-65 BASIC: 命令
                    ;
                    ; 命令の処理は、txtptr が命令のトークンの次の文字を指し(chrget 済み)、A にその文字が
                    ; 入った状態で呼ばれる。終わったら文の終わり(: か 0)を指して rts する。
                    
                    ; 命令の表(TK_END から TK_ELSE の順)
                    stmt_table:
B616  6A B6 55 B8 +         .word st_end, st_for, st_next, st_data, st_input, st_dim, st_read, st_let
B626  EE B6 BE B6 +         .word st_goto, st_run, st_if, st_restore, st_gosub, st_return, st_rem, st_stop
B636  81 B7 1F BD +         .word st_on, st_wait, st_load, st_save, st_poke, st_print, st_cont, st_list
B646  B5 B6 AF B6 +         .word st_clear, st_new, st_cls, st_locate, st_pset, st_preset, st_line, st_circle
B656  37 C9 69 BD +         .word st_beep, st_deg, st_rad, st_randomize, st_call, st_files, st_mon, st_edit
B666  7F BF 4F B8           .word st_delete, st_rem
                    
                    ; FOR の積み上げ(スタック上、印のバイトから):
                    ;   +0 TK_FOR  +1,2 変数の番地  +3-7 STEP  +8-12 終わりの値  +13,14 行番号  +15,16 位置
                    FORSIZE    = 17
                    ; GOSUB の積み上げ: +0 TK_GOSUB  +1,2 行番号  +3,4 位置
                    GOSUBSIZE  = 5
                    
                    ; ===================================================================
                    ; 流れ
                    ; ===================================================================
                    
                    st_end:
B66A  4C 83 A2              jmp ready
                    
                    st_stop:
B66D  AE BF 03              ldx framesp
B670  9A                    txs
