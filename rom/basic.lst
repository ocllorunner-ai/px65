                    ; PX-65 BASIC
                    ;
                    ;   node tools/rom.js        # rom/basic.s とモニターを合わせて rom/px65.bin を作る
                    ;
                    ; 仕様と使い方は docs/basic.md を参照。ROM の $A000-$DFFF に置く。
                    ; モニターの BIOS(px65.inc の BIOS_*)を使う。
                    ;
                    ; ファイル:
                    ;   basic.s        このファイル。メモリの割り当て、入口、ほかのファイルの読み込み
                    ;   basic_fp.s     浮動小数点の四則演算、比較、変換
                    ;   basic_math.s   数学関数(SQR、三角関数、指数、対数、べき乗、乱数)
                    ;   basic_main.s   入力、トークン化、プログラムの保存、実行の中心、エラー
                    ;   basic_expr.s   式、変数、配列、関数
                    ;   basic_str.s    文字列とガーベジコレクション
                    ;   basic_stmt.s   命令
                    ;   basic_io.s     グラフィック、音、テープ
                    ;   basic_const.s  浮動小数点の定数(tools/mkfpconst.js が生成)
                    
                    ; PX-65 の共通定義(モニターと BASIC の両方が .include する)
                    ;
                    ; ここにあるアドレスと番号は、ROM の外のプログラムからも使ってよい(今後も変えない)。
                    
                    ; ---- I/O ----
                    KEY_ROW    = $8000
                    KEY_COL    = $8001
                    LCD_ANN    = $8002
                    LCD_CTRL   = $8003
                    TIMER_CTRL = $8010
                    BEEP       = $8020
                    TAPE_DATA  = $8030
                    TAPE_CTRL  = $8031
                    
                    TAPE_STOP  = $00            ; TAPE_CTRL に書くコマンド
                    TAPE_PLAY  = $01
                    TAPE_REC   = $02
                    TAPE_APPEND = $03
                    TAPE_CANCEL = $04            ; 録音をやめ、録音前の中身に戻す
                    TAPE_FULL  = $20            ; TAPE_CTRL を読んだときのビット: 録音中に、いっぱいで書けなかった
                    
                    ANN_BUSY   = $01            ; LCD_ANN のビット
                    ANN_SHIFT  = $02
                    ANN_CAPS   = $04
                    ANN_DEG    = $08
                    ANN_RAD    = $10
                    ANN_RUN    = $20
                    ANN_PRO    = $40
                    ANN_LOW    = $80
                    
                    VRAM       = $0400          ; 96バイト × 4ページ
                    COLS       = 16
                    ROWS       = 4
                    
                    ; ---- キーコード(GETKEY が返す値) ----
                    K_DEL      = $08
                    K_CLS      = $0C            ; CHROUT に渡すと画面を消す
                    K_RET      = $0D
                    K_LEFT     = $11
                    K_RIGHT    = $12
                    K_UP       = $13
                    K_DOWN     = $14
                    
                    ; ---- ゼロページ(モニターが使う $E0-$FF のうち、外から読んでよいもの) ----
                    cur_x      = $EE            ; カーソルの桁(0-15。16は「次の文字で改行」)
                    cur_y      = $EF            ; カーソルの行(0-3)
                    ticks      = $F2            ; 2 タイマー割り込みの回数(64Hz)
                    
                    ; ---- 入力行 ----
                    LINEBUF    = $0300          ; 64 GETLINE が読んだ行
                    HISTBUF    = $0340          ; 64 直前に入力した行
                    LINEMAX    = 58             ; 1行の最大文字数
                    LINELEN    = $0250          ; LINEBUF の文字数
                    HISTLEN    = $0251
                    
                    ; ---- テープの読み書き(BIOS_TSAVE, BIOS_TFIND, BIOS_TLOAD に渡す値) ----
                    T_TYPE     = $02A0          ; 種類
                    T_NAME     = $02A1          ; 8 名前(足りない分は空白)
                    T_START    = $02A9          ; 2 開始番地
                    T_LEN      = $02AB          ; 2 長さ
                    
                    TT_MEM     = $01            ; T_TYPE: メモリ(モニターの W)
                    TT_BASIC   = $02            ; T_TYPE: BASIC のプログラム
                    
                    TE_NOTAPE  = 1              ; テープのエラー(C=1 のときの A)
                    TE_NOTFOUND = 2
                    TE_BAD     = 3
                    TE_FULL    = 4              ; 保存: テープがいっぱい(テープは保存前のまま)
                    
                    ; ---- BIOS のジャンプテーブル ----
                    BIOS_CHROUT    = $FF00          ; A の文字を出力。A, X, Y を保存
                    BIOS_GETKEY    = $FF03          ; キーを待つ -> A。X, Y を保存
                    BIOS_KEYCHK    = $FF06          ; キーがあれば C=1, A。X, Y を保存
                    BIOS_GETLINE   = $FF09          ; 1行入力 -> LINEBUF, LINELEN。A, X を壊す
                    BIOS_PRHEX     = $FF0C          ; A を16進数2桁で出力
                    BIOS_PRINT     = $FF0F          ; JSR の後ろの文字列(0終わり)を出力
                    BIOS_BEEP      = $FF12          ; A=高さ X=長さ。A, X, Y を壊す
                    BIOS_CLS       = $FF15          ; 画面を消す。A, X を壊す
                    BIOS_LOCATE    = $FF18          ; X=桁 Y=行
                    BIOS_MONITOR   = $FF1B          ; モニターに戻ってレジスタを表示
                    BIOS_GETLINE_ED= $FF1E          ; LINEBUF の LINELEN 文字を表示してから入力を続ける
                    BIOS_MONENTER  = $FF21          ; モニターのプロンプトに入る(戻らない)
                    BIOS_TSAVE     = $FF24          ; T_* のブロックをテープの最後に足す
                    BIOS_TFIND     = $FF27          ; A=0 で先頭から、A=1 で続きから、次のブロックの見出しを T_* に読む
                    BIOS_TLOAD     = $FF2A          ; BIOS_TFIND で見つけたブロックのデータを T_START から読む
                    BIOS_CUROFF    = $FF2D          ; 点滅中のカーソルを消す(入力を途中でやめたとき)
                    
                    ; $02C6-$02FF は BASIC が使う
                    
                    ; ---- RAM ベクタ(割り込みの処理の番地。書き換えてよい) ----
                    IRQVEC     = $02C0
                    BRKVEC     = $02C2
                    NMIVEC     = $02C4
                    
                    ; ---- BASIC の入口(BASIC の ROM の先頭) ----
                    BASIC_COLD = $A000
                    BASIC_WARM = $A003         ; C=0 リセットから(変数を消す)、C=1 モニターの Q から(変数を残す)
                    BASIC_SIG  = $A006          ; "BASIC" があれば BASIC が入っている
                    
                    
                    ; ===================================================================
                    ; ゼロページ($80-$DF)
                    ; ===================================================================
                    
                    ; ---- 浮動小数点 ----
                    ; FAC(浮動小数点アキュムレーター)と ARG。指数、仮数4バイト、符号($00/$80)、
                    ; 仮数の下に続く1バイト(丸め用)。値 = 0.1mmm…(2進) × 2^(指数-128)、指数0は値0
                    fac_e      = $80
                    fac_m1     = $81
                    fac_m2     = $82
                    fac_m3     = $83
                    fac_m4     = $84
                    fac_s      = $85
                    fac_x      = $86
                    arg_e      = $87
                    arg_m1     = $88
                    arg_m2     = $89
                    arg_m3     = $8A
                    arg_m4     = $8B
                    arg_s      = $8C
                    arg_x      = $8D
                    ft0        = $8E            ; 浮動小数点の計算用(ft0-ft9)
                    ft1        = $8F
                    ft2        = $90
                    ft3        = $91
                    ft4        = $92
                    ft5        = $93
                    ft6        = $94
                    ft7        = $95
                    ft8        = $96
                    ft9        = $97
                    
                    ; ---- インタプリタ ----
                    txtptr     = $98            ; 2 いま読んでいるプログラムの位置
                    curlin     = $9A            ; 2 実行中の行番号($FFFF なら直接実行)
                    valtyp     = $9C            ; 式の型: 0 数、$FF 文字列
                    varptr     = $9D            ; 2 変数の値の番地
                    varnam     = $9F            ; 2 変数の名前
                    vartab     = $A1            ; 2 単純変数の始まり(プログラムの終わり)
                    arytab     = $A3            ; 2 配列の始まり
                    strend     = $A5            ; 2 配列の終わり(ここから上が空き)
                    fretop     = $A7            ; 2 文字列領域の下端(ここから STRTOP の手前までが文字列)
                    oldlin     = $A9            ; 2 CONT で続ける行番号
                    oldtxt     = $AB            ; 2 CONT で続ける位置
                    datptr     = $AD            ; 2 次に READ する DATA の位置
                    index1     = $AF            ; 2 汎用ポインター
                    index2     = $B1            ; 2
                    lowtr      = $B3            ; 2 行を探した結果
                    linnum     = $B5            ; 2 行番号や16ビット整数
                    forpnt     = $B7            ; 2 FOR の変数の番地
                    temppt     = $B9            ; 一時文字列の数
                    dest       = $BA            ; 2 転送先
                    srcp       = $BC            ; 2 転送元
                    movlen     = $BE            ; 2 転送の長さ
                    bt0        = $C0            ; 汎用(bt0-bt7)
                    bt1        = $C1
                    bt2        = $C2
                    bt3        = $C3
                    bt4        = $C4
                    bt5        = $C5
                    bt6        = $C6
                    bt7        = $C7
                    fptr       = $C8            ; 2 浮動小数点の読み書きのポインター
                    fin_dexp   = $CA            ; 数の読み書き: 10進の指数
                    fin_pt     = $CB            ; 小数点を見た
                    fin_neg    = $CC            ; 負
                    fin_nd     = $CD            ; 読んだ桁数
                    fin_ev     = $CE            ; 指数部の値
                    fin_eneg   = $CF            ; 指数部が負
                    dimflg     = $D0            ; DIM の中なら1
                    subcnt     = $D1            ; 添字の数
                    strp       = $D2            ; 2 文字列のポインター
                    strp2      = $D4            ; 2
                    gcp        = $D6            ; 2 ガーベジコレクション用
                    gclim      = $D8            ; 2
                    gcbest     = $DA            ; 2
                    gcnew      = $DC            ; 2
                    errnum     = $DE            ; エラーの番号
                    listrow    = $DF            ; LIST の表示行数
                    
                    ; ===================================================================
                    ; ワークエリア($0380-$03FF)
                    ; ===================================================================
                    tempst     = $0380          ; 24 一時文字列の記述子(3バイト × 8)
                    TEMPMAX    = 8
                    fbuffr     = $0398          ; 16 数を文字列にしたもの
                    fodig      = $03A8          ; 9 数を文字列にするときの各桁
                    rndseed    = $03B1          ; 4 乱数の種
                    rndlast    = $03B5          ; 5 直前の乱数
                    angmode    = $03BA          ; 0 ラジアン、1 度
                    bmagic     = $03BB          ; 2 ウォームスタートの目印
                    brkflag    = $03BD          ; BREAK が押された
                    bstate     = $03BE          ; 0 入力待ち、1 実行中、2 INPUT、3 CALL、4 C> で入力待ち
                    framesp    = $03BF          ; FOR/GOSUB の積み上げの上端(文の始めのスタックポインター)
                    monnmi     = $03C0          ; 2 モニターの NMI 処理の番地
                    fpt1       = $03C2          ; 5 浮動小数点の一時置き場
                    fpt2       = $03C7          ; 5
                    fpt3       = $03CC          ; 5
                    fpt4       = $03D1          ; 5
                    contok     = $03D6          ; CONT できるなら1
                    fo_e       = $03D7          ; 数の表示: 小数点の位置
                    fo_nd      = $03D8          ; 数の表示: 桁数
                    poly_n     = $03D9          ; 多項式: 残りの係数の数
                    poly_p     = $03DA          ; 2 多項式: 係数の番地
                    gcflag     = $03DC          ; ガーベジコレクションの段階
                    datlin     = $03DD          ; 2 DATA の行番号(エラー表示用)
                    grmode     = $03DF          ; PSET などのモード
                    pf_ret     = $03E0          ; 2 push_fac / pop_arg の戻り先
                    ptype      = $03E2          ; pop_arg で戻した値の型
                    dimbuf_lo  = $03E3          ; 8 配列を作るときの各次元の大きさ
                    dimbuf_hi  = $03EB          ; 8
                    MAXDIM     = 8
                    ; $03F3-$03FF は basic_str.s、basic_stmt.s が使う
                    
                    ; ---- $02C6-$02FF(モニターのワークエリアのうち BASIC が使う部分) ----
                    fpt5       = $02C6          ; 5 浮動小数点の一時置き場(多項式)
                    fpt6       = $02CB          ; 5
                    fpt7       = $02D0          ; 5
                    exp_n      = $02D5          ; EXP、LN: 2 のべき
                    sin_q      = $02D6          ; SIN: 象限
                    atn_s      = $02D7          ; ATN: 符号
                    trig_s     = $02D7          ; SIN、COS、TAN: 引数の符号(ATN とは同時に使わない)
                    atn_f      = $02D8          ; ATN: 変換の印
                    pow_n      = $02D9          ; 2 べき乗: 指数
                    gx0        = $02DB          ; 2 グラフィック: 座標(gx0, gy0, gx1, gy1 の順に並べる)
                    gy0        = $02DD          ; 2
                    gx1        = $02DF          ; 2
                    gy1        = $02E1          ; 2
                    gdx        = $02E3          ; 2
                    gdy        = $02E5          ; 2(gdx の2バイト後ろ)
                    gsx        = $02E7
                    gsy        = $02E8
                    gerr       = $02E9          ; 2
                    bp_half    = $02EB          ; 2 BEEP: 半周期の待ち
                    bp_cnt     = $02ED          ; 2 BEEP: 半周期の数
                    bp_lvl     = $02EF          ; BEEP: 出力
                    tname      = $02F0          ; 8 テープの名前
                    calcmode   = $02F8          ; 1 なら計算モード(CALC。プロンプトが C>)
                    fin_dexph  = $02F9          ; 数を読むとき: 10進の指数(fin_dexp)の上位バイト
                    fin_evh    = $02FA          ; 数を読むとき: 指数部の値(fin_ev)の上位バイト
                    val_ptr    = $02FB          ; 2 VAL が一時的に0にした番地(上位が0なら、していない)。エラーで抜けても戻すため
                    ; $02FD-$02FF は空き
                    
                    ; RENUM はグラフィックと同時には動かないので、gx0-gerr と同じ場所を使う
                    rn_new     = $02DB          ; 2 新しい開始番号
                    rn_inc     = $02DD          ; 2 増分
                    rn_old     = $02DF          ; 2 元の開始番号
                    rn_grow    = $02E1          ; 2 行が伸びる分の合計(下調べ)
                    rn_cur     = $02E3          ; 2 振り直した行の番号
                    rn_first   = $02E5          ; 1 なら次が振り直す最初の行
                    rn_mode    = $02E6          ; 0 下調べ、1 書き換える
                    rn_ref     = $02E7          ; 行番号の前のトークン
                    rn_olen    = $02E8          ; 元の行番号の桁数(参照)
                    rn_nlen    = $02E9          ; 新しい行番号の桁数
                    ; RENUM は BEEP、テープとも同時には動かないので、bp_half-tname も使う
                    rn_cnt     = $02EB          ; 2 振り直す行の数
                    rn_tab     = $02ED          ; 2 元の番号の表の始め
                    rn_dst0    = $02F0          ; 2 参照の数字を書き始めた位置
                    rn_val     = $02F2          ; 2 参照の新しい番号
                    rn_lnew    = $02F4          ; 2 いま読んでいる行の新しい番号
                    rn_quiet   = $02F6          ; 1 ならない行への参照を知らせない
                    
                    MEMSIZ     = $8000          ; RAM の上端 + 1
                    STRTOP     = $7FFF          ; 文字列領域の上端 + 1。$7FFF は VAL が文字列の直後を一時的に0にするのに使う
                                                ; (文字列の直後がいつも RAM の中で、BASIC の持ち物になるように)
                    PRGSTART   = $0800          ; プログラムの始まり
                    BMAGIC1    = $B5
                    BMAGIC2    = $C1
                    
                    ; ---- エラーの番号(err_msgs の順) ----
                    EN_SN     = 0
                    EN_OV     = 1
                    EN_DIV0   = 2
                    EN_FC     = 3
                    EN_UL     = 4
                    EN_OM     = 5
                    EN_TM     = 6
                    EN_BS     = 7
                    EN_DD     = 8
                    EN_LS     = 9
                    EN_NF     = 10
                    EN_RG     = 11
                    EN_OD     = 12
                    EN_CN     = 13
                    EN_ID     = 14
                    EN_NT     = 15
                    EN_TP     = 16
                    EN_TF     = 17
                    EN_BREAK  = $FF            ; BREAK(エラーではない)
                    
                    ; ===================================================================
                    ; 入口
                    ; ===================================================================
0000  FF FF FF FF +         .org $A000
A000  4C 4E A1              jmp b_cold              ; $A000 コールドスタート
A003  4C 93 A1              jmp b_warm              ; $A003 ウォームスタート
A006  42 41 53 49 +         .byte "BASIC"           ; $A006 BASIC が入っている印
                    
                    ; BEEP の待ち: bt0/bt1 回 × 14 サイクル。ほかのコードが増えてもページの境目を
                    ; またがないように、ここ(番地が変わらない場所)に置く
                    beep_wait:
                    bw_1:
A00B  A5 C0                 lda bt0
A00D  D0 06                 bne bw_2
A00F  A5 C1                 lda bt1
A011  F0 06                 beq bw_3
A013  C6 C1                 dec bt1
                    bw_2:
A015  C6 C0                 dec bt0
A017  80 F2                 bra bw_1
                    bw_3:
A019  60                    rts
                    
                    ; PX-65 BASIC: 起動、入力、トークン化、プログラムの保存、実行の中心、エラー
                    
                    ; ===================================================================
                    ; トークン(kwtab の順。$80 から)
                    ; ===================================================================
                    TK_END     = $80
                    TK_FOR     = $81
                    TK_NEXT    = $82
                    TK_DATA    = $83
                    TK_INPUT   = $84
                    TK_DIM     = $85
                    TK_READ    = $86
                    TK_LET     = $87
                    TK_GOTO    = $88
                    TK_RUN     = $89
                    TK_IF      = $8A
                    TK_RESTORE = $8B
                    TK_GOSUB   = $8C
                    TK_RETURN  = $8D
                    TK_REM     = $8E
                    TK_STOP    = $8F
                    TK_ON      = $90
                    TK_WAIT    = $91
                    TK_LOAD    = $92
                    TK_SAVE    = $93
                    TK_POKE    = $94
                    TK_PRINT   = $95
                    TK_CONT    = $96
                    TK_LIST    = $97
                    TK_CLEAR   = $98
                    TK_NEW     = $99
                    TK_CLS     = $9A
                    TK_LOCATE  = $9B
                    TK_PSET    = $9C
                    TK_PRESET  = $9D
                    TK_LINE    = $9E
                    TK_CIRCLE  = $9F
                    TK_BEEP    = $A0
                    TK_DEG     = $A1
                    TK_RAD     = $A2
                    TK_RANDOM  = $A3
                    TK_CALL    = $A4
                    TK_FILES   = $A5
                    TK_MON     = $A6
                    TK_EDIT    = $A7
                    TK_DELETE  = $A8
                    TK_ELSE    = $A9            ; 命令として扱う最後のトークン
                    TK_TO      = $AA
                    TK_STEP    = $AB
                    TK_THEN    = $AC
                    TK_TAB     = $AD
                    TK_SPC     = $AE
                    TK_AND     = $AF
                    TK_OR      = $B0
                    TK_NOT     = $B1
                    TK_SGN     = $B2            ; ここから関数
                    TK_INT     = $B3
                    TK_ABS     = $B4
                    TK_FRE     = $B5
                    TK_SQR     = $B6
                    TK_RND     = $B7
                    TK_LN      = $B8
                    TK_LOG     = $B9
                    TK_EXP     = $BA
                    TK_COS     = $BB
                    TK_SIN     = $BC
                    TK_TAN     = $BD
                    TK_ATN     = $BE
                    TK_PEEK    = $BF
                    TK_LEN     = $C0
                    TK_STRS    = $C1
                    TK_VAL     = $C2
                    TK_ASC     = $C3
                    TK_CHRS    = $C4
                    TK_HEXS    = $C5
                    TK_POINT   = $C6
                    TK_PI      = $C7
                    TK_INKEYS  = $C8
                    TK_LEFTS   = $C9
                    TK_RIGHTS  = $CA
                    TK_MIDS    = $CB
                    TK_INSTR   = $CC            ; 最後の関数
                    TK_RENUM   = $CD            ; 後から足した命令(保存したプログラムのトークンが変わらないように最後に置く)
                    TK_CALC    = $CE            ; 後から足した命令
                    
                    ; キーワード(最後の文字は bit7 を立てる)。この順がトークンの番号
                    kwtab:
A01A  45 4E C4              .byte "EN", 'D'+$80
A01D  46 4F D2              .byte "FO", 'R'+$80
A020  4E 45 58 D4           .byte "NEX", 'T'+$80
A024  44 41 54 C1           .byte "DAT", 'A'+$80
A028  49 4E 50 55 +         .byte "INPU", 'T'+$80
A02D  44 49 CD              .byte "DI", 'M'+$80
A030  52 45 41 C4           .byte "REA", 'D'+$80
A034  4C 45 D4              .byte "LE", 'T'+$80
A037  47 4F 54 CF           .byte "GOT", 'O'+$80
A03B  52 55 CE              .byte "RU", 'N'+$80
A03E  49 C6                 .byte "I", 'F'+$80
A040  52 45 53 54 +         .byte "RESTOR", 'E'+$80
A047  47 4F 53 55 +         .byte "GOSU", 'B'+$80
A04C  52 45 54 55 +         .byte "RETUR", 'N'+$80
A052  52 45 CD              .byte "RE", 'M'+$80
A055  53 54 4F D0           .byte "STO", 'P'+$80
A059  4F CE                 .byte "O", 'N'+$80
A05B  57 41 49 D4           .byte "WAI", 'T'+$80
A05F  4C 4F 41 C4           .byte "LOA", 'D'+$80
A063  53 41 56 C5           .byte "SAV", 'E'+$80
A067  50 4F 4B C5           .byte "POK", 'E'+$80
A06B  50 52 49 4E +         .byte "PRIN", 'T'+$80
A070  43 4F 4E D4           .byte "CON", 'T'+$80
A074  4C 49 53 D4           .byte "LIS", 'T'+$80
A078  43 4C 45 41 +         .byte "CLEA", 'R'+$80
A07D  4E 45 D7              .byte "NE", 'W'+$80
A080  43 4C D3              .byte "CL", 'S'+$80
A083  4C 4F 43 41 +         .byte "LOCAT", 'E'+$80
A089  50 53 45 D4           .byte "PSE", 'T'+$80
A08D  50 52 45 53 +         .byte "PRESE", 'T'+$80
A093  4C 49 4E C5           .byte "LIN", 'E'+$80
A097  43 49 52 43 +         .byte "CIRCL", 'E'+$80
A09D  42 45 45 D0           .byte "BEE", 'P'+$80
A0A1  44 45 C7              .byte "DE", 'G'+$80
A0A4  52 41 C4              .byte "RA", 'D'+$80
A0A7  52 41 4E 44 +         .byte "RANDOMIZ", 'E'+$80
A0B0  43 41 4C CC           .byte "CAL", 'L'+$80
A0B4  46 49 4C 45 +         .byte "FILE", 'S'+$80
A0B9  4D 4F CE              .byte "MO", 'N'+$80
A0BC  45 44 49 D4           .byte "EDI", 'T'+$80
A0C0  44 45 4C 45 +         .byte "DELET", 'E'+$80
A0C6  45 4C 53 C5           .byte "ELS", 'E'+$80
A0CA  54 CF                 .byte "T", 'O'+$80
A0CC  53 54 45 D0           .byte "STE", 'P'+$80
A0D0  54 48 45 CE           .byte "THE", 'N'+$80
A0D4  54 41 42 A8           .byte "TAB", '('+$80
A0D8  53 50 43 A8           .byte "SPC", '('+$80
A0DC  41 4E C4              .byte "AN", 'D'+$80
A0DF  4F D2                 .byte "O", 'R'+$80
A0E1  4E 4F D4              .byte "NO", 'T'+$80
A0E4  53 47 CE              .byte "SG", 'N'+$80
A0E7  49 4E D4              .byte "IN", 'T'+$80
A0EA  41 42 D3              .byte "AB", 'S'+$80
A0ED  46 52 C5              .byte "FR", 'E'+$80
A0F0  53 51 D2              .byte "SQ", 'R'+$80
A0F3  52 4E C4              .byte "RN", 'D'+$80
A0F6  4C CE                 .byte "L", 'N'+$80
A0F8  4C 4F C7              .byte "LO", 'G'+$80
A0FB  45 58 D0              .byte "EX", 'P'+$80
A0FE  43 4F D3              .byte "CO", 'S'+$80
A101  53 49 CE              .byte "SI", 'N'+$80
A104  54 41 CE              .byte "TA", 'N'+$80
A107  41 54 CE              .byte "AT", 'N'+$80
A10A  50 45 45 CB           .byte "PEE", 'K'+$80
A10E  4C 45 CE              .byte "LE", 'N'+$80
A111  53 54 52 A4           .byte "STR", '$'+$80
A115  56 41 CC              .byte "VA", 'L'+$80
A118  41 53 C3              .byte "AS", 'C'+$80
A11B  43 48 52 A4           .byte "CHR", '$'+$80
A11F  48 45 58 A4           .byte "HEX", '$'+$80
A123  50 4F 49 4E +         .byte "POIN", 'T'+$80
A128  50 C9                 .byte "P", 'I'+$80
A12A  49 4E 4B 45 +         .byte "INKEY", '$'+$80
A130  4C 45 46 54 +         .byte "LEFT", '$'+$80
A135  52 49 47 48 +         .byte "RIGHT", '$'+$80
A13B  4D 49 44 A4           .byte "MID", '$'+$80
A13F  49 4E 53 54 +         .byte "INST", 'R'+$80
A144  52 45 4E 55 +         .byte "RENU", 'M'+$80
A149  43 41 4C C3           .byte "CAL", 'C'+$80
A14D  00                    .byte 0
                    
                    ; ===================================================================
                    ; 起動
                    ; ===================================================================
                    
                    ; コールドスタート: プログラムを消して起動する
                    b_cold:
A14E  20 18 A2              jsr b_sys
A151  9C FC 02              stz val_ptr+1           ; RAM の中身は意味がないので、VAL の戻しはしない
A154  20 AD A6              jsr b_new_mem
A157  9C BA 03              stz angmode
A15A  A9 A5                 lda #$A5                ; 乱数の種(0 以外)
A15C  8D B1 03              sta rndseed
A15F  8D B2 03              sta rndseed+1
A162  8D B3 03              sta rndseed+2
A165  8D B4 03              sta rndseed+3
A168  A9 B5                 lda #BMAGIC1
A16A  8D BB 03              sta bmagic
A16D  A9 C1                 lda #BMAGIC2
A16F  8D BC 03              sta bmagic+1
A172  20 FF A1              jsr b_banner
A175  20 33 A9              jsr fre_bytes           ; "30719 BYTES FREE"
A178  20 D9 D6              jsr fac_u16
A17B  20 27 D9              jsr fout
A17E  20 13 A9              jsr out_fbuf_nosign
A181  20 F7 A8              jsr strout_inline
A184  20 42 59 54 +         .byte " BYTES FREE", 0
A190  4C 83 A2              jmp ready
                    
                    ; ウォームスタート: プログラムを残して起動する(リセット、モニターの Q)
                    ; ウォームスタート。C=0 ならリセットから(変数を消し、画面を消して名前を出す)。
                    ; C=1 ならモニターの Q から(変数を残し、画面はそのままでプロンプトを出す)
                    b_warm:
A193  A9 00                 lda #0                  ; C を覚える(b_sys はスタックを空にする)
A195  2A                    rol
A196  85 C1                 sta bt1
A198  20 18 A2              jsr b_sys
A19B  AD BB 03              lda bmagic
A19E  C9 B5                 cmp #BMAGIC1
A1A0  D0 AC                 bne b_cold
A1A2  AD BC 03              lda bmagic+1
A1A5  C9 C1                 cmp #BMAGIC2
A1A7  D0 A5                 bne b_cold
A1A9  20 AE B4              jsr val_restore         ; VAL の途中でリセットされたら、0にしたバイトを戻す(fix_program の前に)
A1AC  A5 A1                 lda vartab              ; プログラムの終わり(fix_program が作り直す前)
A1AE  48                    pha
A1AF  A5 A2                 lda vartab+1
A1B1  48                    pha
A1B2  20 DC A6              jsr fix_program         ; プログラムが壊れていれば消す
A1B5  A5 C1                 lda bt1
A1B7  D0 0B                 bne bw_q
A1B9  68                    pla
A1BA  68                    pla
A1BB  20 C3 A6              jsr clearc
A1BE  20 FF A1              jsr b_banner
A1C1  4C 83 A2              jmp ready
                    bw_q:
                            ; 変数を残すのは、メモリの使い方の記録に矛盾がないときだけ
                            ;   vartab が変わっていない、vartab <= arytab <= strend <= fretop <= STRTOP($7FFF)
A1C4  68                    pla
A1C5  C5 A2                 cmp vartab+1
A1C7  D0 2F                 bne bw_clr1
A1C9  68                    pla
A1CA  C5 A1                 cmp vartab
A1CC  D0 2B                 bne bw_clr
A1CE  38                    sec
A1CF  A5 A3                 lda arytab
A1D1  E5 A1                 sbc vartab
A1D3  A5 A4                 lda arytab+1
A1D5  E5 A2                 sbc vartab+1
A1D7  90 20                 bcc bw_clr
A1D9  38                    sec
A1DA  A5 A5                 lda strend
A1DC  E5 A3                 sbc arytab
A1DE  A5 A6                 lda strend+1
A1E0  E5 A4                 sbc arytab+1
A1E2  90 15                 bcc bw_clr
A1E4  38                    sec
A1E5  A5 A7                 lda fretop
A1E7  E5 A5                 sbc strend
A1E9  A5 A8                 lda fretop+1
A1EB  E5 A6                 sbc strend+1
A1ED  90 0A                 bcc bw_clr
A1EF  A5 A8                 lda fretop+1            ; fretop <= $7FFF なら上位バイトの最上位ビットが0
A1F1  30 06                 bmi bw_clr
                    bw_ok:
A1F3  64 B9                 stz temppt              ; 一時文字列だけ捨てる
A1F5  4C 83 A2              jmp ready
                    bw_clr1:
A1F8  68                    pla
                    bw_clr:
A1F9  20 C3 A6              jsr clearc
A1FC  4C 83 A2              jmp ready
                    
                    b_banner:
A1FF  20 15 FF              jsr BIOS_CLS
A202  20 F7 A8              jsr strout_inline
A205  50 58 2D 36 +         .byte "PX-65 BASIC 0.11", K_RET, 0
A217  60                    rts
                    
                    ; 割り込みなどを BASIC 用にする(スタックも空にする)
                    b_sys:
A218  68                    pla                     ; 戻り先
A219  AA                    tax
A21A  68                    pla
A21B  A8                    tay
A21C  78                    sei
A21D  D8                    cld
A21E  86 C0                 stx bt0
A220  A2 FF                 ldx #$FF
A222  9A                    txs
A223  5A                    phy
A224  A6 C0                 ldx bt0
A226  DA                    phx
A227  AD C4 02              lda NMIVEC              ; モニターの NMI 処理を覚えておく(CALL 中の BREAK 用)
A22A  C9 46                 cmp #<b_nmi
A22C  D0 07                 bne bs_1
A22E  AD C5 02              lda NMIVEC+1
A231  C9 A8                 cmp #>b_nmi
A233  F0 0C                 beq bs_2
                    bs_1:
A235  AD C4 02              lda NMIVEC
A238  8D C0 03              sta monnmi
A23B  AD C5 02              lda NMIVEC+1
A23E  8D C1 03              sta monnmi+1
                    bs_2:
A241  A9 46                 lda #<b_nmi
A243  8D C4 02              sta NMIVEC
A246  A9 A8                 lda #>b_nmi
A248  8D C5 02              sta NMIVEC+1
A24B  9C BE 03              stz bstate
A24E  9C BD 03              stz brkflag
A251  9C D6 03              stz contok
A254  9C F8 02              stz calcmode            ; 起動したときと、モニターから戻ったときは計算モードをやめる
A257  9C 31 80              stz TAPE_CTRL
A25A  A9 81                 lda #$81
A25C  8D 10 80              sta TIMER_CTRL
A25F  AD 03 80              lda LCD_CTRL
A262  09 01                 ora #$01
A264  8D 03 80              sta LCD_CTRL
A267  A9 01                 lda #ANN_BUSY
A269  1C 02 80              trb LCD_ANN
A26C  20 71 A2              jsr show_angle
A26F  58                    cli
A270  60                    rts
                    
                    ; 角度の単位の表示(DEG か RAD)を点ける
                    show_angle:
A271  A9 18                 lda #ANN_DEG+ANN_RAD
A273  1C 02 80              trb LCD_ANN
A276  A9 10                 lda #ANN_RAD
A278  AE BA 03              ldx angmode
A27B  F0 02                 beq sa_1
A27D  A9 08                 lda #ANN_DEG
                    sa_1:
A27F  0C 02 80              tsb LCD_ANN
A282  60                    rts
                    
                    ; ===================================================================
                    ; 入力待ち
                    ; ===================================================================
                    
                    ; ready: スタックを空にしてプロンプトへ(FOR/GOSUB も消える)
                    ready:
A283  A2 FF                 ldx #$FF
A285  9A                    txs
A286  9C D6 03              stz contok
                    ; ready_keep: スタックはそのまま(STOP、BREAK の後。CONT で続けられるように)
                    ready_keep:
A289  D8                    cld
A28A  20 AE B4              jsr val_restore         ; VAL がエラーで抜けたら、0にしたバイトを戻す
A28D  58                    cli
A28E  64 D0                 stz dimflg
A290  9C BE 03              stz bstate
A293  9C BD 03              stz brkflag
A296  A9 FF                 lda #$FF
A298  85 9A                 sta curlin
A29A  85 9B                 sta curlin+1
A29C  A9 21                 lda #ANN_BUSY+ANN_RUN   ; 液晶の BUSY と RUN を消す
A29E  1C 02 80              trb LCD_ANN
                    main_loop:
A2A1  20 8E A3              jsr crlf_if
A2A4  AD F8 02              lda calcmode            ; 計算モードのプロンプトは C>
A2A7  F0 0A                 beq ml_1
A2A9  A9 04                 lda #4                  ; C> で入力を待っている(ここで BREAK なら計算モードをやめる)
A2AB  8D BE 03              sta bstate
A2AE  A9 43                 lda #'C'
A2B0  20 00 FF              jsr BIOS_CHROUT
                    ml_1:
A2B3  A9 3E                 lda #'>'
A2B5  20 00 FF              jsr BIOS_CHROUT
A2B8  20 09 FF              jsr BIOS_GETLINE
                    main_line:
A2BB  20 F1 A2              jsr line_setup
A2BE  AD F8 02              lda calcmode
A2C1  D0 3A                 bne main_calc
                    main_prog:
A2C3  20 98 A3              jsr chrget
A2C6  B0 0E                 bcs main_direct
A2C8  20 D6 A4              jsr linget              ; 行番号があればプログラムに入れる
A2CB  20 4D A5              jsr store_line
A2CE  A2 FF                 ldx #$FF                ; プログラムが変わったので FOR/GOSUB は消す
A2D0  9A                    txs
A2D1  9C D6 03              stz contok
A2D4  80 CB                 bra main_loop
                    main_direct:
A2D6  F0 C9                 beq main_loop           ; 空の行
A2D8  A9 01                 lda #1
A2DA  8D BE 03              sta bstate
A2DD  BA                    tsx
A2DE  8E BF 03              stx framesp
A2E1  64 B9                 stz temppt
A2E3  20 9E A3              jsr chrgot
A2E6  20 80 A7              jsr exec_stmt
A2E9  4C 1A A7              jmp newstt
                    
                    ; EDIT で直した行: 計算モードでも、いつもの行として扱う(行番号があればプログラムに入れる)
                    main_edit:
A2EC  20 F1 A2              jsr line_setup
A2EF  80 D2                 bra main_prog
                    
                    ; 入力行をトークンにして、txtptr をその前に置く
                    line_setup:
A2F1  20 D7 A3              jsr tokenize
A2F4  A9 FF                 lda #<(LINEBUF-1)
A2F6  85 98                 sta txtptr
A2F8  A9 02                 lda #>(LINEBUF-1)
A2FA  85 99                 sta txtptr+1
A2FC  60                    rts
                    
                    ; 計算モードの1行。行番号は付けられない(数で始まる行も式)
                    ;   命令で始まる行: いつもの直接実行。「変数=」で始まる行: 代入。それ以外: 式の値を表示する
                    main_calc:
A2FD  20 98 A3              jsr chrget
A300  D0 03                 bne mc_1
A302  4C A1 A2              jmp main_loop           ; 空の行
                    mc_1:
A305  A9 01                 lda #1
A307  8D BE 03              sta bstate
A30A  BA                    tsx
A30B  8E BF 03              stx framesp
A30E  64 B9                 stz temppt
A310  20 9E A3              jsr chrgot
A313  90 0E                 bcc mc_print            ; 数字で始まる
A315  C9 80                 cmp #$80
A317  B0 10                 bcs mc_tok
A319  20 3E AC              jsr isletter
A31C  90 05                 bcc mc_print            ; ( - " . など
A31E  20 3A A3              jsr is_assign
A321  B0 0E                 bcs mc_stmt
                    mc_print:
A323  20 03 BA              jsr st_print
A326  4C 1A A7              jmp newstt
                    mc_tok:
A329  C9 AA                 cmp #TK_TO              ; TK_END-TK_ELSE は命令
A32B  90 04                 bcc mc_stmt
A32D  C9 CD                 cmp #TK_RENUM           ; NOT、関数、PI など: 式
A32F  90 F2                 bcc mc_print
                    mc_stmt:
A331  20 9E A3              jsr chrgot
A334  20 80 A7              jsr exec_stmt
A337  4C 1A A7              jmp newstt
                    
                    ; いまの位置から「変数名 [(…)] =」が続けば C=1(代入の文)。txtptr は変えない
                    is_assign:
A33A  A0 00                 ldy #0
                    ia_name:
A33C  20 84 A3              jsr ia_next             ; 名前の2文字目から: 英字と数字
A33F  20 3E AC              jsr isletter
A342  B0 F8                 bcs ia_name
A344  C9 30                 cmp #'0'
A346  90 04                 bcc ia_1
A348  C9 3A                 cmp #'9'+1
A34A  90 F0                 bcc ia_name
                    ia_1:
A34C  C9 24                 cmp #'$'
A34E  D0 03                 bne ia_2
A350  20 84 A3              jsr ia_next
                    ia_2:
A353  C9 28                 cmp #'('                ; 添字: 対応する ) まで飛ばす
A355  D0 25                 bne ia_4
A357  A2 01                 ldx #1
                    ia_3:
A359  20 84 A3              jsr ia_next
A35C  F0 22                 beq ia_no               ; 行の終わり
A35E  C9 22                 cmp #'"'                ; 文字列の中の ( ) は数えない
A360  D0 0B                 bne ia_3q
                    ia_3s:
A362  C8                    iny
A363  B1 98                 lda (txtptr),Y
A365  F0 19                 beq ia_no
A367  C9 22                 cmp #'"'
A369  D0 F7                 bne ia_3s
A36B  80 EC                 bra ia_3
                    ia_3q:
A36D  C9 28                 cmp #'('
A36F  D0 01                 bne ia_3a
A371  E8                    inx
                    ia_3a:
A372  C9 29                 cmp #')'
A374  D0 E3                 bne ia_3
A376  CA                    dex
A377  D0 E0                 bne ia_3
A379  20 84 A3              jsr ia_next
                    ia_4:
A37C  C9 3D                 cmp #'='
A37E  F0 02                 beq ia_yes
                    ia_no:
A380  18                    clc
A381  60                    rts
                    ia_yes:
A382  38                    sec
A383  60                    rts
                    ; 次の文字(空白は飛ばす)。A = 文字、Z=1 なら行の終わり
                    ia_next:
A384  C8                    iny
A385  B1 98                 lda (txtptr),Y
A387  C9 20                 cmp #' '
A389  F0 F9                 beq ia_next
A38B  C9 00                 cmp #0
A38D  60                    rts
                    
                    ; 改行(行の途中にいるときだけ)
                    crlf_if:
A38E  A5 EE                 lda cur_x
A390  F0 05                 beq ci_1
                    crlf:
A392  A9 0D                 lda #K_RET
A394  4C 00 FF              jmp BIOS_CHROUT
                    ci_1:
A397  60                    rts
                    
                    ; ===================================================================
                    ; 1文字読む
                    ; ===================================================================
                    
                    ; chrget: 次の文字へ進んで読む。chrgot: いまの文字を読む。どちらも空白は飛ばす。
                    ; A = 文字。Z=1 なら文の終わり(0、:、ELSE)。C=0 なら数字
                    chrget:
A398  E6 98                 inc txtptr
A39A  D0 02                 bne chrgot
A39C  E6 99                 inc txtptr+1
                    chrgot:
A39E  A0 00                 ldy #0
A3A0  B1 98                 lda (txtptr),Y
A3A2  C9 20                 cmp #' '
A3A4  F0 F2                 beq chrget
A3A6  C9 3A                 cmp #':'
A3A8  F0 08                 beq cg_done             ; Z=1, C=1
A3AA  B0 07                 bcs cg_hi
A3AC  38                    sec                     ; 数字なら C=0、0 なら Z=1
A3AD  E9 30                 sbc #'0'
A3AF  38                    sec
A3B0  E9 D0                 sbc #$D0
                    cg_done:
A3B2  60                    rts
                    cg_hi:
A3B3  C9 A9                 cmp #TK_ELSE            ; ELSE も文の終わり(Z=1, C=1)
A3B5  F0 FB                 beq cg_done
A3B7  C9 00                 cmp #0                  ; Z=0, C=1
A3B9  60                    rts
                    
                    ; いまの文字が A でなければ SN エラー。同じなら次へ進む
                    synchr:
A3BA  A0 00                 ldy #0
A3BC  D1 98                 cmp (txtptr),Y
A3BE  D0 03                 bne syn_err
A3C0  4C 98 A3              jmp chrget
                    syn_err:
A3C3  4C E3 A8              jmp err_sn
                    
                    ; "," "(" ")" を読む
                    chkcom:
A3C6  A9 2C                 lda #','
A3C8  80 06                 bra syn_ch
                    chkopen:
A3CA  A9 28                 lda #'('
A3CC  80 02                 bra syn_ch
                    chkclose:
A3CE  A9 29                 lda #')'
                    syn_ch:
A3D0  48                    pha
A3D1  20 9E A3              jsr chrgot
A3D4  68                    pla
A3D5  80 E3                 bra synchr
                    
                    ; ===================================================================
                    ; トークン化
                    ; ===================================================================
                    
                    ; LINEBUF(LINELEN 文字)のキーワードをトークンにして、0 で終わらせる。
                    ; " の中、DATA の後(: まで)、REM の後はそのまま。それ以外の英小文字は大文字にする
                    tokenize:
A3D7  A2 00                 ldx #0                  ; 読む位置
A3D9  A0 00                 ldy #0                  ; 書く位置
A3DB  64 C5                 stz bt5                 ; 0: ふつう、2: DATA の後、3: REM の後
A3DD  64 C6                 stz bt6                 ; " の中なら1
                    tk_loop:
A3DF  EC 50 02              cpx LINELEN
A3E2  90 03                 bcc *+5
A3E4  4C 75 A4              jmp tok_end
A3E7  A5 C5                 lda bt5
A3E9  C9 03                 cmp #3
A3EB  F0 7D                 beq tk_copy             ; REM の後
A3ED  BD 00 03              lda LINEBUF,X
A3F0  C9 22                 cmp #'"'
A3F2  D0 08                 bne tk_2
A3F4  A5 C6                 lda bt6
A3F6  49 01                 eor #1
A3F8  85 C6                 sta bt6
A3FA  80 6E                 bra tk_copy
                    tk_2:
A3FC  A5 C6                 lda bt6
A3FE  D0 6A                 bne tk_copy             ; " の中
A400  A5 C5                 lda bt5
A402  C9 02                 cmp #2
A404  D0 0B                 bne tk_3
A406  BD 00 03              lda LINEBUF,X           ; DATA の後: : で終わり
A409  C9 3A                 cmp #':'
A40B  D0 5D                 bne tk_copy
A40D  64 C5                 stz bt5
A40F  80 59                 bra tk_copy
                    tk_3:
A411  BD 00 03              lda LINEBUF,X
A414  C9 3F                 cmp #'?'
A416  D0 04                 bne tk_4
A418  A9 95                 lda #TK_PRINT
A41A  80 46                 bra tk_put1
                    tk_4:
A41C  C9 27                 cmp #$27                ; ' は REM
A41E  D0 08                 bne tk_5
A420  A9 03                 lda #3
A422  85 C5                 sta bt5
A424  A9 8E                 lda #TK_REM
A426  80 3A                 bra tk_put1
                    tk_5:
A428  20 CB A4              jsr toupper
A42B  C9 41                 cmp #'A'
A42D  90 2B                 bcc tk_put
A42F  C9 5B                 cmp #'Z'+1
A431  B0 27                 bcs tk_put
A433  84 C4                 sty bt4                 ; 英字: キーワードを探す
A435  20 7B A4              jsr kw_match
A438  A4 C4                 ldy bt4
A43A  90 18                 bcc tk_letter
A43C  99 00 03              sta LINEBUF,Y           ; トークン(X は進んでいる)
A43F  C8                    iny
A440  C9 8E                 cmp #TK_REM
A442  F0 0A                 beq tok_rem
A444  C9 83                 cmp #TK_DATA
A446  D0 97                 bne tk_loop
A448  A9 02                 lda #2
A44A  85 C5                 sta bt5
A44C  80 91                 bra tk_loop
                    tok_rem:
A44E  A9 03                 lda #3
A450  85 C5                 sta bt5
A452  80 8B                 bra tk_loop
                    tk_letter:
A454  BD 00 03              lda LINEBUF,X
A457  20 CB A4              jsr toupper
                    tk_put:
A45A  99 00 03              sta LINEBUF,Y
A45D  C8                    iny
A45E  E8                    inx
A45F  4C DF A3              jmp tk_loop
                    tk_put1:
A462  99 00 03              sta LINEBUF,Y
A465  C8                    iny
A466  E8                    inx
A467  4C DF A3              jmp tk_loop
                    tk_copy:
A46A  BD 00 03              lda LINEBUF,X
A46D  99 00 03              sta LINEBUF,Y
A470  C8                    iny
A471  E8                    inx
A472  4C DF A3              jmp tk_loop
                    tok_end:
A475  A9 00                 lda #0
A477  99 00 03              sta LINEBUF,Y
A47A  60                    rts
                    
                    ; LINEBUF の X の位置からキーワードを探す。見つかれば C=1、A = トークン、X は進む
                    kw_match:
A47B  A9 1A                 lda #<kwtab
A47D  85 AF                 sta index1
A47F  A9 A0                 lda #>kwtab
A481  85 B0                 sta index1+1
A483  A9 80                 lda #$80
A485  85 C1                 sta bt1                 ; トークン
A487  86 C2                 stx bt2                 ; 始めの位置
                    km_word:
A489  A0 00                 ldy #0
A48B  B1 AF                 lda (index1),Y
A48D  F0 38                 beq km_none
                    km_char:
A48F  B1 AF                 lda (index1),Y
A491  29 7F                 and #$7F
A493  85 C3                 sta bt3
A495  BD 00 03              lda LINEBUF,X
A498  20 CB A4              jsr toupper
A49B  C5 C3                 cmp bt3
A49D  D0 0B                 bne km_next
A49F  B1 AF                 lda (index1),Y
A4A1  30 1F                 bmi km_ok
A4A3  C8                    iny
A4A4  E8                    inx
A4A5  EC 50 02              cpx LINELEN             ; 入力の終わりを越えたら不一致
A4A8  90 E5                 bcc km_char
                    km_next:
A4AA  A0 00                 ldy #0                  ; 次のキーワードへ
                    kmn_1:
A4AC  B1 AF                 lda (index1),Y
A4AE  C8                    iny
A4AF  0A                    asl
A4B0  90 FA                 bcc kmn_1
A4B2  98                    tya
A4B3  18                    clc
A4B4  65 AF                 adc index1
A4B6  85 AF                 sta index1
A4B8  90 02                 bcc kmn_2
A4BA  E6 B0                 inc index1+1
                    kmn_2:
A4BC  E6 C1                 inc bt1
A4BE  A6 C2                 ldx bt2
A4C0  80 C7                 bra km_word
                    km_ok:
A4C2  E8                    inx
A4C3  A5 C1                 lda bt1
A4C5  38                    sec
A4C6  60                    rts
                    km_none:
A4C7  A6 C2                 ldx bt2
A4C9  18                    clc
A4CA  60                    rts
                    
                    toupper:
A4CB  C9 61                 cmp #'a'
A4CD  90 06                 bcc tu_1
A4CF  C9 7B                 cmp #'z'+1
A4D1  B0 02                 bcs tu_1
A4D3  29 DF                 and #$DF
                    tu_1:
A4D5  60                    rts
                    
                    ; ===================================================================
                    ; 行番号とプログラムの行
                    ; ===================================================================
                    
                    ; txtptr の数字を行番号として読み、linnum に置く(0-63999)。数字の次の文字で止まる
                    linget:
A4D6  64 B5                 stz linnum
A4D8  64 B6                 stz linnum+1
                    lg_1:
A4DA  B0 3D                 bcs lg_done             ; 数字でない
A4DC  29 0F                 and #$0F
A4DE  48                    pha
A4DF  A5 B6                 lda linnum+1            ; 6400 以上に10をかけると 63999 を超える
A4E1  C9 19                 cmp #$19
A4E3  B0 30                 bcs lg_err
A4E5  A5 B5                 lda linnum              ; linnum × 10 = (×4 + ×1) × 2
A4E7  85 C0                 sta bt0
A4E9  A5 B6                 lda linnum+1
A4EB  85 C1                 sta bt1
A4ED  06 B5                 asl linnum
A4EF  26 B6                 rol linnum+1
A4F1  06 B5                 asl linnum
A4F3  26 B6                 rol linnum+1
A4F5  18                    clc
A4F6  A5 B5                 lda linnum
A4F8  65 C0                 adc bt0
A4FA  85 B5                 sta linnum
A4FC  A5 B6                 lda linnum+1
A4FE  65 C1                 adc bt1
A500  85 B6                 sta linnum+1
A502  06 B5                 asl linnum
A504  26 B6                 rol linnum+1
A506  68                    pla
A507  18                    clc
A508  65 B5                 adc linnum
A50A  85 B5                 sta linnum
A50C  90 02                 bcc lg_2
A50E  E6 B6                 inc linnum+1
                    lg_2:
A510  20 98 A3              jsr chrget
A513  80 C5                 bra lg_1
                    lg_err:
A515  68                    pla
A516  4C E3 A8              jmp err_sn
                    lg_done:
A519  60                    rts
                    
                    ; linnum の行を探す。lowtr = その行か、それより大きい最初の行(なければ終わりの印)。
                    ; ちょうどその行があれば C=1
                    fndlin:
A51A  A9 00                 lda #<PRGSTART
A51C  85 B3                 sta lowtr
A51E  A9 08                 lda #>PRGSTART
A520  85 B4                 sta lowtr+1
                    fl_1:
A522  A0 01                 ldy #1
A524  B1 B3                 lda (lowtr),Y
A526  F0 23                 beq fl_no               ; 終わり
A528  A0 03                 ldy #3
A52A  B1 B3                 lda (lowtr),Y
A52C  C5 B6                 cmp linnum+1
A52E  90 0D                 bcc fl_next
A530  D0 19                 bne fl_no
A532  88                    dey
A533  B1 B3                 lda (lowtr),Y
A535  C5 B5                 cmp linnum
A537  90 04                 bcc fl_next
A539  D0 10                 bne fl_no
A53B  38                    sec
A53C  60                    rts
                    fl_next:
A53D  A0 00                 ldy #0
A53F  B1 B3                 lda (lowtr),Y
A541  AA                    tax
A542  C8                    iny
A543  B1 B3                 lda (lowtr),Y
A545  85 B4                 sta lowtr+1
A547  86 B3                 stx lowtr
A549  80 D7                 bra fl_1
                    fl_no:
A54B  18                    clc
A54C  60                    rts
                    
                    ; 入力した行(linnum と、txtptr からの本文)をプログラムに入れる。本文が空なら消す
                    store_line:
A54D  A0 00                 ldy #0                  ; 本文の長さ
                    sl_len:
A54F  B1 98                 lda (txtptr),Y
A551  F0 03                 beq sl_len2
A553  C8                    iny
A554  80 F9                 bra sl_len
                    sl_len2:
A556  84 C6                 sty bt6                 ; 本文の長さ
A558  20 1A A5              jsr fndlin
A55B  90 3D                 bcc sl_ins
                            ; 同じ番号の行を消す: [次の行, vartab) を lowtr へ
A55D  A0 00                 ldy #0
A55F  B1 B3                 lda (lowtr),Y
A561  85 BC                 sta srcp
A563  C8                    iny
A564  B1 B3                 lda (lowtr),Y
A566  85 BD                 sta srcp+1
A568  A5 B3                 lda lowtr
A56A  85 BA                 sta dest
A56C  A5 B4                 lda lowtr+1
A56E  85 BB                 sta dest+1
A570  38                    sec
A571  A5 A1                 lda vartab
A573  E5 BC                 sbc srcp
A575  85 BE                 sta movlen
A577  A5 A2                 lda vartab+1
A579  E5 BD                 sbc srcp+1
A57B  85 BF                 sta movlen+1
A57D  38                    sec                     ; 消す長さ(move_down は srcp を進めるので、先に求める)
A57E  A5 BC                 lda srcp
A580  E5 B3                 sbc lowtr
A582  85 C0                 sta bt0
A584  A5 BD                 lda srcp+1
A586  E5 B4                 sbc lowtr+1
A588  85 C1                 sta bt1
A58A  20 56 A6              jsr move_down
A58D  38                    sec                     ; vartab -= 消した長さ
A58E  A5 A1                 lda vartab
A590  E5 C0                 sbc bt0
A592  85 A1                 sta vartab
A594  A5 A2                 lda vartab+1
A596  E5 C1                 sbc bt1
A598  85 A2                 sta vartab+1
                    sl_ins:
A59A  A5 C6                 lda bt6
A59C  F0 78                 beq sl_done             ; 本文が空: 消すだけ
                            ; 新しい行の長さ = 4 + 本文 + 1
A59E  18                    clc
A59F  A5 C6                 lda bt6
A5A1  69 05                 adc #5
A5A3  85 C0                 sta bt0
A5A5  A9 00                 lda #0
A5A7  85 C1                 sta bt1
                            ; 入るか: vartab + 長さ + 256 <= MEMSIZ
A5A9  18                    clc
A5AA  A5 A1                 lda vartab
A5AC  65 C0                 adc bt0
A5AE  85 C2                 sta bt2
A5B0  A5 A2                 lda vartab+1
A5B2  69 01                 adc #1
A5B4  C9 80                 cmp #>MEMSIZ
A5B6  90 03                 bcc sl_room
A5B8  4C E8 A8              jmp err_om
                    sl_room:
                            ; [lowtr, vartab) を長さ分だけ上へ
A5BB  A5 B3                 lda lowtr
A5BD  85 BC                 sta srcp
A5BF  A5 B4                 lda lowtr+1
A5C1  85 BD                 sta srcp+1
A5C3  18                    clc
A5C4  A5 B3                 lda lowtr
A5C6  65 C0                 adc bt0
A5C8  85 BA                 sta dest
A5CA  A5 B4                 lda lowtr+1
A5CC  69 00                 adc #0
A5CE  85 BB                 sta dest+1
A5D0  38                    sec
A5D1  A5 A1                 lda vartab
A5D3  E5 B3                 sbc lowtr
A5D5  85 BE                 sta movlen
A5D7  A5 A2                 lda vartab+1
A5D9  E5 B4                 sbc lowtr+1
A5DB  85 BF                 sta movlen+1
A5DD  20 77 A6              jsr move_up
A5E0  18                    clc
A5E1  A5 A1                 lda vartab
A5E3  65 C0                 adc bt0
A5E5  85 A1                 sta vartab
A5E7  90 02                 bcc sl_v1
A5E9  E6 A2                 inc vartab+1
                    sl_v1:
                            ; 見出し(つなぎは後で直す)と本文
A5EB  A0 00                 ldy #0
A5ED  A9 FF                 lda #$FF
A5EF  91 B3                 sta (lowtr),Y
A5F1  C8                    iny
A5F2  91 B3                 sta (lowtr),Y
A5F4  C8                    iny
A5F5  A5 B5                 lda linnum
A5F7  91 B3                 sta (lowtr),Y
A5F9  C8                    iny
A5FA  A5 B6                 lda linnum+1
A5FC  91 B3                 sta (lowtr),Y
A5FE  18                    clc                     ; dest = lowtr + 4
A5FF  A5 B3                 lda lowtr
A601  69 04                 adc #4
A603  85 BA                 sta dest
A605  A5 B4                 lda lowtr+1
A607  69 00                 adc #0
A609  85 BB                 sta dest+1
A60B  A0 00                 ldy #0
                    sl_copy:
A60D  B1 98                 lda (txtptr),Y
A60F  91 BA                 sta (dest),Y
A611  F0 03                 beq sl_done
A613  C8                    iny
A614  80 F7                 bra sl_copy
                    sl_done:
A616  20 1C A6              jsr relink
A619  4C C3 A6              jmp clearc
                    
                    ; 行のつなぎ(次の行の番地)を作り直す
                    relink:
A61C  A9 00                 lda #<PRGSTART
A61E  85 AF                 sta index1
A620  A9 08                 lda #>PRGSTART
A622  85 B0                 sta index1+1
                    rl_1:
A624  A0 01                 ldy #1
A626  B1 AF                 lda (index1),Y
A628  F0 2B                 beq rl_done             ; 終わりの印(つなぎが0)
A62A  A0 04                 ldy #4                  ; 本文の終わりの 0 を探す
                    rl_2:
A62C  B1 AF                 lda (index1),Y
A62E  F0 03                 beq rl_3
A630  C8                    iny
A631  80 F9                 bra rl_2
                    rl_3:
A633  C8                    iny                     ; 次の行 = index1 + Y
A634  98                    tya
A635  18                    clc
A636  65 AF                 adc index1
A638  85 C0                 sta bt0
A63A  A5 B0                 lda index1+1
A63C  69 00                 adc #0
A63E  85 C1                 sta bt1
A640  A0 00                 ldy #0
A642  A5 C0                 lda bt0
A644  91 AF                 sta (index1),Y
A646  C8                    iny
A647  A5 C1                 lda bt1
A649  91 AF                 sta (index1),Y
A64B  A5 C0                 lda bt0
A64D  85 AF                 sta index1
A64F  A5 C1                 lda bt1
A651  85 B0                 sta index1+1
A653  80 CF                 bra rl_1
                    rl_done:
A655  60                    rts
                    
                    ; ===================================================================
                    ; メモリの転送
                    ; ===================================================================
                    
                    ; srcp から dest へ movlen バイト(dest < srcp のとき。前から写す)。
                    ; 256バイトを超えると srcp と dest の上位バイトが進むので、呼ぶ側は後で使わないこと
                    move_down:
A656  A0 00                 ldy #0
A658  A6 BF                 ldx movlen+1
A65A  F0 0E                 beq md_2
                    md_1:
A65C  B1 BC                 lda (srcp),Y
A65E  91 BA                 sta (dest),Y
A660  C8                    iny
A661  D0 F9                 bne md_1
A663  E6 BD                 inc srcp+1
A665  E6 BB                 inc dest+1
A667  CA                    dex
A668  D0 F2                 bne md_1
                    md_2:
A66A  A6 BE                 ldx movlen
A66C  F0 08                 beq md_4
                    md_3:
A66E  B1 BC                 lda (srcp),Y
A670  91 BA                 sta (dest),Y
A672  C8                    iny
A673  CA                    dex
A674  D0 F8                 bne md_3
                    md_4:
A676  60                    rts
                    
                    ; srcp から dest へ movlen バイト(dest > srcp のとき。後ろから写す)
                    move_up:
A677  A5 BE                 lda movlen
A679  05 BF                 ora movlen+1
A67B  F0 2F                 beq mu_done
A67D  18                    clc                     ; 最後のページの先頭に合わせる
A67E  A5 BD                 lda srcp+1
A680  65 BF                 adc movlen+1
A682  85 BD                 sta srcp+1
A684  18                    clc
A685  A5 BB                 lda dest+1
A687  65 BF                 adc movlen+1
A689  85 BB                 sta dest+1
A68B  A4 BE                 ldy movlen
A68D  F0 09                 beq mu_page
                    mu_1:
A68F  88                    dey
A690  B1 BC                 lda (srcp),Y
A692  91 BA                 sta (dest),Y
A694  C0 00                 cpy #0
A696  D0 F7                 bne mu_1
                    mu_page:
A698  A6 BF                 ldx movlen+1
A69A  F0 10                 beq mu_done
                    mu_2:
A69C  C6 BD                 dec srcp+1
A69E  C6 BB                 dec dest+1
                    mu_3:
A6A0  88                    dey
A6A1  B1 BC                 lda (srcp),Y
A6A3  91 BA                 sta (dest),Y
A6A5  C0 00                 cpy #0
A6A7  D0 F7                 bne mu_3
A6A9  CA                    dex
A6AA  D0 F0                 bne mu_2
                    mu_done:
A6AC  60                    rts
                    
                    ; ===================================================================
                    ; NEW, CLEAR
                    ; ===================================================================
                    
                    ; プログラムを空にする
                    b_new_mem:
A6AD  A9 00                 lda #0
A6AF  8D FF 07              sta PRGSTART-1
A6B2  8D 00 08              sta PRGSTART
A6B5  8D 01 08              sta PRGSTART+1
A6B8  A9 02                 lda #<(PRGSTART+2)
A6BA  85 A1                 sta vartab
A6BC  A9 08                 lda #>(PRGSTART+2)
A6BE  85 A2                 sta vartab+1
A6C0  9C D6 03              stz contok
                            ; そのまま clearc へ
                    
                    ; 変数を消す
                    clearc:
A6C3  A5 A1                 lda vartab
A6C5  85 A3                 sta arytab
A6C7  85 A5                 sta strend
A6C9  A5 A2                 lda vartab+1
A6CB  85 A4                 sta arytab+1
A6CD  85 A6                 sta strend+1
A6CF  A9 FF                 lda #<STRTOP
A6D1  85 A7                 sta fretop
A6D3  A9 7F                 lda #>STRTOP
A6D5  85 A8                 sta fretop+1
A6D7  64 B9                 stz temppt
A6D9  4C DD BC              jmp restore_data
                    
                    ; プログラムのつなぎをたどって終わりを探し、vartab を決める。壊れていれば空にする
                    fix_program:
A6DC  A9 00                 lda #0
A6DE  8D FF 07              sta PRGSTART-1
A6E1  A9 00                 lda #<PRGSTART
A6E3  85 AF                 sta index1
A6E5  A9 08                 lda #>PRGSTART
A6E7  85 B0                 sta index1+1
                    fp_1:
A6E9  A0 01                 ldy #1
A6EB  B1 AF                 lda (index1),Y
A6ED  F0 1A                 beq fp_end
A6EF  C9 80                 cmp #>MEMSIZ            ; つなぎが RAM の外なら壊れている
A6F1  B0 24                 bcs fp_bad
A6F3  AA                    tax
A6F4  88                    dey
A6F5  B1 AF                 lda (index1),Y
A6F7  E4 B0                 cpx index1+1            ; つなぎは前へは進まない
A6F9  90 1C                 bcc fp_bad
A6FB  D0 06                 bne fp_2
A6FD  C5 AF                 cmp index1
A6FF  90 16                 bcc fp_bad
A701  F0 14                 beq fp_bad
                    fp_2:
A703  85 AF                 sta index1
A705  86 B0                 stx index1+1
A707  80 E0                 bra fp_1
                    fp_end:
A709  18                    clc
A70A  A5 AF                 lda index1
A70C  69 02                 adc #2
A70E  85 A1                 sta vartab
A710  A5 B0                 lda index1+1
A712  69 00                 adc #0
A714  85 A2                 sta vartab+1
A716  60                    rts
                    fp_bad:
A717  4C AD A6              jmp b_new_mem
                    
                    ; ===================================================================
                    ; 実行
                    ; ===================================================================
                    
                    ; 文を順に実行する。txtptr はいまの文の終わり(: か 0)を指す
                    newstt:
A71A  BA                    tsx
A71B  8E BF 03              stx framesp
A71E  64 B9                 stz temppt
A720  A5 9B                 lda curlin+1            ; プログラムを実行しているあいだは液晶の RUN を点ける
A722  C9 FF                 cmp #$FF
A724  F0 05                 beq ns_0
A726  A9 20                 lda #ANN_RUN
A728  0C 02 80              tsb LCD_ANN
                    ns_0:
A72B  AD BD 03              lda brkflag
A72E  F0 03                 beq ns_1
A730  4C F4 A7              jmp do_break
                    ns_1:
A733  A0 00                 ldy #0
A735  B1 98                 lda (txtptr),Y
A737  F0 10                 beq ns_eol
A739  C9 3A                 cmp #':'
A73B  F0 3A                 beq ns_stmt
A73D  C9 A9                 cmp #TK_ELSE            ; THEN の後の文の終わりの ELSE: 行の残りを飛ばす
A73F  F0 03                 beq ns_skip
A741  4C E3 A8              jmp err_sn
                    ns_skip:
A744  20 B3 A7              jsr skip_line
A747  80 D1                 bra newstt
                    ns_eol:
A749  A5 9B                 lda curlin+1            ; 直接実行の行が終わった
A74B  C9 FF                 cmp #$FF
A74D  D0 09                 bne ns_next
A74F  A5 9A                 lda curlin
A751  C9 FF                 cmp #$FF
A753  D0 03                 bne ns_next
A755  4C 89 A2              jmp ready_keep
                    ns_next:
A758  A0 02                 ldy #2                  ; 次の行の見出し(0 の次がつなぎ)
A75A  B1 98                 lda (txtptr),Y
A75C  D0 03                 bne ns_line
A75E  4C F1 A7              jmp end_prog            ; プログラムの終わり
                    ns_line:
A761  A0 03                 ldy #3
A763  B1 98                 lda (txtptr),Y
A765  85 9A                 sta curlin
A767  C8                    iny
A768  B1 98                 lda (txtptr),Y
A76A  85 9B                 sta curlin+1
A76C  18                    clc
A76D  A5 98                 lda txtptr
A76F  69 04                 adc #4
A771  85 98                 sta txtptr
A773  90 02                 bcc ns_stmt
A775  E6 99                 inc txtptr+1
                    ns_stmt:
A777  20 98 A3              jsr chrget
A77A  20 80 A7              jsr exec_stmt
A77D  4C 1A A7              jmp newstt
                    
                    ; 1つの文を実行する。A = 文の最初の文字(chrget の後)
                    exec_stmt:
A780  F0 30                 beq es_empty
A782  C9 80                 cmp #TK_END
A784  90 0F                 bcc es_let
A786  C9 AA                 cmp #TK_ELSE+1
A788  B0 0E                 bcs es_sn
A78A  38                    sec
A78B  E9 80                 sbc #TK_END
A78D  0A                    asl
A78E  AA                    tax
A78F  20 98 A3              jsr chrget              ; 命令の次の文字へ
A792  7C 16 B6              jmp (stmt_table,X)
                    es_let:
A795  4C BC B9              jmp st_let
                    es_sn:
A798  C9 CD                 cmp #TK_RENUM
A79A  D0 06                 bne es_sn2
A79C  20 98 A3              jsr chrget
A79F  4C FB BF              jmp st_renum
                    es_sn2:
A7A2  C9 CE                 cmp #TK_CALC
A7A4  D0 09                 bne es_sn3
A7A6  20 98 A3              jsr chrget
A7A9  A9 01                 lda #1                  ; CALC: 計算モードにする(プロンプトが C> になる)
A7AB  8D F8 02              sta calcmode
A7AE  60                    rts
                    es_sn3:
A7AF  4C E3 A8              jmp err_sn
                    es_empty:
A7B2  60                    rts
                    
                    ; 行の残りを飛ばす(txtptr を行の終わりの 0 へ)
                    skip_line:
A7B3  A0 00                 ldy #0
                    skl_1:
A7B5  B1 98                 lda (txtptr),Y
A7B7  F0 03                 beq skl_2
A7B9  C8                    iny
A7BA  D0 F9                 bne skl_1
                    skl_2:
A7BC  98                    tya
A7BD  18                    clc
A7BE  65 98                 adc txtptr
A7C0  85 98                 sta txtptr
A7C2  90 02                 bcc skl_3
A7C4  E6 99                 inc txtptr+1
                    skl_3:
A7C6  60                    rts
                    
                    ; 文の残りを飛ばす(: か 0 まで。" の中の : は飛ばす)
                    skip_stmt:
A7C7  A0 00                 ldy #0
A7C9  64 C0                 stz bt0
                    sks_1:
A7CB  B1 98                 lda (txtptr),Y
A7CD  F0 17                 beq sks_2
A7CF  C9 22                 cmp #'"'
A7D1  D0 08                 bne sks_3
A7D3  A5 C0                 lda bt0
A7D5  49 01                 eor #1
A7D7  85 C0                 sta bt0
A7D9  80 08                 bra sks_4
                    sks_3:
A7DB  C9 3A                 cmp #':'
A7DD  D0 04                 bne sks_4
A7DF  A6 C0                 ldx bt0
A7E1  F0 03                 beq sks_2
                    sks_4:
A7E3  C8                    iny
A7E4  D0 E5                 bne sks_1
                    sks_2:
A7E6  98                    tya
A7E7  18                    clc
A7E8  65 98                 adc txtptr
A7EA  85 98                 sta txtptr
A7EC  90 02                 bcc sks_5
A7EE  E6 99                 inc txtptr+1
                    sks_5:
A7F0  60                    rts
                    
                    ; プログラムの最後まで来た
                    end_prog:
A7F1  4C 83 A2              jmp ready
                    
                    ; BREAK キーで止まった
                    do_break:
A7F4  9C BD 03              stz brkflag
A7F7  20 0C A8              jsr save_cont
A7FA  20 8E A3              jsr crlf_if
A7FD  20 F7 A8              jsr strout_inline
A800  42 52 45 41 +         .byte "BREAK", 0
A806  20 2E A8              jsr in_line
A809  4C 89 A2              jmp ready_keep
                    
                    ; CONT で続けられるように、いまの位置を覚える(直接実行のときは続けられない)
                    save_cont:
A80C  A5 9B                 lda curlin+1
A80E  25 9A                 and curlin
A810  C9 FF                 cmp #$FF
A812  F0 16                 beq sc_no
A814  A5 98                 lda txtptr
A816  85 AB                 sta oldtxt
A818  A5 99                 lda txtptr+1
A81A  85 AC                 sta oldtxt+1
A81C  A5 9A                 lda curlin
A81E  85 A9                 sta oldlin
A820  A5 9B                 lda curlin+1
A822  85 AA                 sta oldlin+1
A824  A9 01                 lda #1
A826  8D D6 03              sta contok
A829  60                    rts
                    sc_no:
A82A  9C D6 03              stz contok
A82D  60                    rts
                    
                    ; " IN 行番号"(プログラムの実行中なら)
                    in_line:
A82E  A5 9B                 lda curlin+1
A830  25 9A                 and curlin
A832  C9 FF                 cmp #$FF
A834  F0 0F                 beq il_1
A836  20 F7 A8              jsr strout_inline
A839  20 49 4E 20 +         .byte " IN ", 0
A83E  A5 9A                 lda curlin
A840  A4 9B                 ldy curlin+1
A842  4C 2A A9              jmp linprt
                    il_1:
A845  60                    rts
                    
                    ; ===================================================================
                    ; BREAK キー(NMI)
                    ; ===================================================================
                    b_nmi:
A846  48                    pha
A847  AD BE 03              lda bstate
A84A  C9 01                 cmp #1
A84C  F0 35                 beq bn_flag             ; 実行中: 文の区切りで止める
A84E  C9 03                 cmp #3
A850  F0 38                 beq bn_mon              ; CALL 中: モニターに任せる
                            ; 入力を待っているところ: すぐにやめる
A852  68                    pla
A853  D8                    cld
A854  A2 FF                 ldx #$FF
A856  9A                    txs
A857  9C 31 80              stz TAPE_CTRL
A85A  20 2D FF              jsr BIOS_CUROFF
A85D  AD BE 03              lda bstate
A860  C9 02                 cmp #2
A862  F0 0D                 beq bn_input
A864  C9 04                 cmp #4
A866  D0 03                 bne bn_ready
A868  9C F8 02              stz calcmode            ; C> で BREAK: 計算モードをやめる(EDIT の取り消しなどではやめない)
                    bn_ready:
A86B  20 8E A3              jsr crlf_if
A86E  4C 83 A2              jmp ready
                    bn_input:
A871  20 8E A3              jsr crlf_if             ; INPUT の途中: BREAK IN 行番号
A874  20 F7 A8              jsr strout_inline
A877  42 52 45 41 +         .byte "BREAK", 0
A87D  20 2E A8              jsr in_line
A880  4C 83 A2              jmp ready
                    bn_flag:
A883  A9 01                 lda #1
A885  8D BD 03              sta brkflag
A888  68                    pla
A889  40                    rti
                    bn_mon:
A88A  68                    pla
A88B  6C C0 03              jmp (monnmi)
                    
                    ; ===================================================================
                    ; エラー
                    ; ===================================================================
                    
                    ; X = エラーの番号。メッセージを出してプロンプトに戻る
                    b_error:
A88E  D8                    cld
A88F  86 DE                 stx errnum
A891  9C 31 80              stz TAPE_CTRL
A894  20 2D FF              jsr BIOS_CUROFF
A897  20 8E A3              jsr crlf_if
A89A  A9 3F                 lda #'?'
A89C  20 00 FF              jsr BIOS_CHROUT
A89F  A5 DE                 lda errnum
A8A1  0A                    asl
A8A2  AA                    tax
A8A3  BD BF A8              lda err_codes,X
A8A6  20 00 FF              jsr BIOS_CHROUT
A8A9  BD C0 A8              lda err_codes+1,X
A8AC  20 00 FF              jsr BIOS_CHROUT
A8AF  20 F7 A8              jsr strout_inline
A8B2  20 45 52 52 +         .byte " ERROR", 0
A8B9  20 2E A8              jsr in_line
A8BC  4C 83 A2              jmp ready
                    
                    err_codes:
A8BF  53 4E 4F 56 +         .byte "SNOV/0FCULOMTMBSDDLSNFRGODCNIDNTTPTF"
                    
                    err_sn:
A8E3  A2 00                 ldx #EN_SN
A8E5  4C 8E A8              jmp b_error
                    err_om:
A8E8  A2 05                 ldx #EN_OM
A8EA  4C 8E A8              jmp b_error
                    err_tm:
A8ED  A2 06                 ldx #EN_TM
A8EF  4C 8E A8              jmp b_error
                    err_ul:
A8F2  A2 04                 ldx #EN_UL
A8F4  4C 8E A8              jmp b_error
                    
                    ; ===================================================================
                    ; 表示
                    ; ===================================================================
                    
                    ; JSR の直後の文字列(0 終わり)を表示して、その後ろに戻る
                    strout_inline:
A8F7  68                    pla
A8F8  85 D2                 sta strp
A8FA  68                    pla
A8FB  85 D3                 sta strp+1
                    soi_1:
A8FD  E6 D2                 inc strp
A8FF  D0 02                 bne soi_2
A901  E6 D3                 inc strp+1
                    soi_2:
A903  B2 D2                 lda (strp)
A905  F0 05                 beq soi_3
A907  20 00 FF              jsr BIOS_CHROUT
A90A  80 F1                 bra soi_1
                    soi_3:
A90C  A5 D3                 lda strp+1
A90E  48                    pha
A90F  A5 D2                 lda strp
A911  48                    pha
A912  60                    rts
                    
                    ; fbuffr を表示する(先頭の符号の空白は出さない)
                    out_fbuf_nosign:
A913  A2 01                 ldx #1
A915  AD 98 03              lda fbuffr
A918  C9 20                 cmp #' '
A91A  F0 02                 beq ofb_1
A91C  A2 00                 ldx #0
                    ofb_1:
A91E  BD 98 03              lda fbuffr,X
A921  F0 06                 beq ofb_2
A923  20 00 FF              jsr BIOS_CHROUT
A926  E8                    inx
A927  80 F5                 bra ofb_1
                    ofb_2:
A929  60                    rts
                    
                    ; A(下位)Y(上位)を符号なし10進数で表示する
                    linprt:
A92A  20 D9 D6              jsr fac_u16
A92D  20 27 D9              jsr fout
A930  4C 13 A9              jmp out_fbuf_nosign
                    
                    ; 空きバイト数を A(下位)Y(上位)に
                    fre_bytes:
A933  38                    sec
A934  A5 A7                 lda fretop
A936  E5 A5                 sbc strend
A938  AA                    tax
A939  A5 A8                 lda fretop+1
A93B  E5 A6                 sbc strend+1
A93D  A8                    tay
A93E  8A                    txa
A93F  60                    rts
                    
                    ; PX-65 BASIC: 式、変数、配列、関数の呼び出し
                    ;
                    ; 式の値は FAC に置き、valtyp で型を表す(0 数、$FF 文字列)。
                    ; 文字列の値は「記述子(長さ1バイト、番地2バイト)の番地」で、fac_m1(下位)fac_m2(上位)に置く。
                    ; 記述子はいつも一時記述子の表(tempst)か変数の中にある。式の途中では一時記述子を使う
                    ; (ガーベジコレクションで文字列が動いても、記述子が書き換わるので安全)。
                    
                    ; ===================================================================
                    ; 式
                    ; ===================================================================
                    
                    ; 式を読んで、数であることを確かめる
                    frmnum:
A940  20 53 A9              jsr frmevl
                    chknum:
A943  A5 9C                 lda valtyp
A945  D0 09                 bne ct_err
A947  60                    rts
                    ; 式を読んで、文字列であることを確かめる
                    frmstr:
A948  20 53 A9              jsr frmevl
                    chkstr:
A94B  A5 9C                 lda valtyp
A94D  F0 01                 beq ct_err
A94F  60                    rts
                    ct_err:
A950  4C ED A8              jmp err_tm
                    
                    ; 式を読む。txtptr のいまの文字から始める
                    frmevl:
A953  BA                    tsx                     ; 式が深すぎないか
A954  E0 30                 cpx #$30
A956  B0 03                 bcs fe_1
A958  4C E8 A8              jmp err_om
                    fe_1:
                            ; OR
A95B  20 89 A9              jsr ev_and
                    fe_or:
A95E  20 9E A3              jsr chrgot
A961  C9 B0                 cmp #TK_OR
A963  D0 23                 bne fe_done
A965  20 43 A9              jsr chknum
A968  20 4A AC              jsr push_fac
A96B  20 98 A3              jsr chrget
A96E  20 89 A9              jsr ev_and
A971  20 43 A9              jsr chknum
A974  20 73 AC              jsr pop_arg
A977  20 D8 A9              jsr two_ints
A97A  A5 C0                 lda bt0
A97C  05 B5                 ora linnum
A97E  AA                    tax
A97F  A5 C1                 lda bt1
A981  05 B6                 ora linnum+1
A983  20 D3 A9              jsr int_result
A986  80 D6                 bra fe_or
                    fe_done:
A988  60                    rts
                    
                    ; AND
                    ev_and:
A989  20 B7 A9              jsr ev_not
                    ea_loop:
A98C  20 9E A3              jsr chrgot
A98F  C9 AF                 cmp #TK_AND
A991  D0 23                 bne ea_done
A993  20 43 A9              jsr chknum
A996  20 4A AC              jsr push_fac
A999  20 98 A3              jsr chrget
A99C  20 B7 A9              jsr ev_not
A99F  20 43 A9              jsr chknum
A9A2  20 73 AC              jsr pop_arg
A9A5  20 D8 A9              jsr two_ints
A9A8  A5 C0                 lda bt0
A9AA  25 B5                 and linnum
A9AC  AA                    tax
A9AD  A5 C1                 lda bt1
A9AF  25 B6                 and linnum+1
A9B1  20 D3 A9              jsr int_result
A9B4  80 D6                 bra ea_loop
                    ea_done:
A9B6  60                    rts
                    
                    ; NOT
                    ev_not:
A9B7  20 9E A3              jsr chrgot
A9BA  C9 B1                 cmp #TK_NOT
A9BC  D0 38                 bne ev_rel
A9BE  20 98 A3              jsr chrget
A9C1  20 B7 A9              jsr ev_not
A9C4  20 43 A9              jsr chknum
A9C7  20 78 D7              jsr getint16
A9CA  A5 B5                 lda linnum
A9CC  49 FF                 eor #$FF
A9CE  AA                    tax
A9CF  A5 B6                 lda linnum+1
A9D1  49 FF                 eor #$FF
                            ; int_result へ
                    
                    ; X(下位)A(上位)の16ビット(符号付き)を FAC に
                    int_result:
A9D3  A8                    tay
A9D4  8A                    txa
A9D5  4C F0 D6              jmp fac_s16
                    
                    ; ARG と FAC を16ビット整数に。ARG → bt0/bt1、FAC → linnum
                    two_ints:
A9D8  20 78 D7              jsr getint16
A9DB  A5 B5                 lda linnum
A9DD  48                    pha
A9DE  A5 B6                 lda linnum+1
A9E0  48                    pha
A9E1  20 8B D3              jsr arg_to_fac
A9E4  20 78 D7              jsr getint16
A9E7  A5 B5                 lda linnum
A9E9  85 C0                 sta bt0
A9EB  A5 B6                 lda linnum+1
A9ED  85 C1                 sta bt1
A9EF  68                    pla
A9F0  85 B6                 sta linnum+1
A9F2  68                    pla
A9F3  85 B5                 sta linnum
A9F5  60                    rts
                    
                    ; 比較(= <> < > <= >=)
                    ev_rel:
A9F6  20 65 AA              jsr ev_add
                    er_loop:
A9F9  20 9E A3              jsr chrgot
A9FC  64 C2                 stz bt2                 ; 1 '>'、2 '='、4 '<'
                    er_op:
A9FE  C9 3E                 cmp #'>'
AA00  D0 04                 bne er_1
AA02  A9 01                 lda #1
AA04  80 0E                 bra er_set
                    er_1:
AA06  C9 3D                 cmp #'='
AA08  D0 04                 bne er_2
AA0A  A9 02                 lda #2
AA0C  80 06                 bra er_set
                    er_2:
AA0E  C9 3C                 cmp #'<'
AA10  D0 09                 bne er_3
AA12  A9 04                 lda #4
                    er_set:
AA14  04 C2                 tsb bt2
AA16  20 98 A3              jsr chrget
AA19  80 E3                 bra er_op
                    er_3:
AA1B  A5 C2                 lda bt2
AA1D  D0 01                 bne er_do
AA1F  60                    rts
                    er_do:
AA20  48                    pha                     ; 比べ方
AA21  20 4A AC              jsr push_fac
AA24  20 65 AA              jsr ev_add
AA27  20 73 AC              jsr pop_arg
AA2A  A5 9C                 lda valtyp
AA2C  CD E2 03              cmp ptype
AA2F  F0 03                 beq *+5
AA31  4C 50 A9              jmp ct_err
AA34  A5 9C                 lda valtyp
AA36  D0 05                 bne er_str
AA38  20 93 D6              jsr fcmp                ; A = 1(ARG > FAC)、0、$FF
AA3B  80 03                 bra er_res
                    er_str:
AA3D  20 21 B3              jsr str_cmp
                    er_res:
AA40  AA                    tax                     ; 結果を 1 '>'、2 '='、4 '<' に
AA41  A9 02                 lda #2
AA43  E0 00                 cpx #0
AA45  F0 08                 beq er_r1
AA47  A9 01                 lda #1
AA49  E0 01                 cpx #1
AA4B  F0 02                 beq er_r1
AA4D  A9 04                 lda #4
                    er_r1:
AA4F  85 C3                 sta bt3
AA51  68                    pla
AA52  25 C3                 and bt3
AA54  F0 05                 beq er_false
AA56  A9 FF                 lda #$FF                ; 真 = -1
AA58  AA                    tax
AA59  80 03                 bra er_r2
                    er_false:
AA5B  A9 00                 lda #0
AA5D  AA                    tax
                    er_r2:
AA5E  64 9C                 stz valtyp
AA60  20 D3 A9              jsr int_result
AA63  80 94                 bra er_loop
                    
                    ; + -
                    ev_add:
AA65  20 A7 AA              jsr ev_mul
                    ead_loop:
AA68  20 9E A3              jsr chrgot
AA6B  C9 2B                 cmp #'+'
AA6D  F0 05                 beq ead_op
AA6F  C9 2D                 cmp #'-'
AA71  F0 01                 beq ead_op
AA73  60                    rts
                    ead_op:
AA74  48                    pha
AA75  20 4A AC              jsr push_fac
AA78  20 98 A3              jsr chrget
AA7B  20 A7 AA              jsr ev_mul
AA7E  20 73 AC              jsr pop_arg
AA81  68                    pla
AA82  A6 9C                 ldx valtyp
AA84  EC E2 03              cpx ptype
AA87  D0 1B                 bne ead_tm
AA89  C9 2B                 cmp #'+'
AA8B  D0 09                 bne ead_sub
AA8D  E0 00                 cpx #0
AA8F  D0 0E                 bne ead_cat
AA91  20 3C D4              jsr fadd
AA94  80 D2                 bra ead_loop
                    ead_sub:
AA96  E0 00                 cpx #0
AA98  D0 0A                 bne ead_tm
AA9A  20 39 D4              jsr fsub
AA9D  80 C9                 bra ead_loop
                    ead_cat:
AA9F  20 B3 B2              jsr str_concat
AAA2  80 C4                 bra ead_loop
                    ead_tm:
AAA4  4C ED A8              jmp err_tm
                    
                    ; * /
                    ev_mul:
AAA7  20 D8 AA              jsr ev_unary
                    em_loop:
AAAA  20 9E A3              jsr chrgot
AAAD  C9 2A                 cmp #'*'
AAAF  F0 05                 beq em_op
AAB1  C9 2F                 cmp #'/'
AAB3  F0 01                 beq em_op
AAB5  60                    rts
                    em_op:
AAB6  48                    pha
AAB7  20 43 A9              jsr chknum
AABA  20 4A AC              jsr push_fac
AABD  20 98 A3              jsr chrget
AAC0  20 D8 AA              jsr ev_unary
AAC3  20 43 A9              jsr chknum
AAC6  20 73 AC              jsr pop_arg
AAC9  68                    pla
AACA  C9 2A                 cmp #'*'
AACC  D0 05                 bne em_div
AACE  20 0D D5              jsr fmul
AAD1  80 D7                 bra em_loop
                    em_div:
AAD3  20 C6 D5              jsr fdiv
AAD6  80 D2                 bra em_loop
                    
                    ; 単項の - +
                    ev_unary:
AAD8  20 9E A3              jsr chrgot
AADB  C9 2D                 cmp #'-'
AADD  F0 09                 beq eu_neg
AADF  C9 2B                 cmp #'+'
AAE1  D0 11                 bne ev_pow
AAE3  20 98 A3              jsr chrget
AAE6  80 F0                 bra ev_unary
                    eu_neg:
AAE8  20 98 A3              jsr chrget
AAEB  20 D8 AA              jsr ev_unary
AAEE  20 43 A9              jsr chknum
AAF1  4C AC D3              jmp fac_neg
                    
                    ; ^
                    ev_pow:
AAF4  20 2F AB              jsr ev_prim
                    ep_loop:
AAF7  20 9E A3              jsr chrgot
AAFA  C9 5E                 cmp #'^'
AAFC  F0 01                 beq ep_op
AAFE  60                    rts
                    ep_op:
AAFF  20 43 A9              jsr chknum
AB02  20 4A AC              jsr push_fac
AB05  20 98 A3              jsr chrget
AB08  C9 2D                 cmp #'-'                ; 2^-1 のような右側の符号
AB0A  D0 0E                 bne ep_1
AB0C  20 98 A3              jsr chrget
AB0F  20 2F AB              jsr ev_prim
AB12  20 43 A9              jsr chknum
AB15  20 AC D3              jsr fac_neg
AB18  80 0D                 bra ep_2
                    ep_1:
AB1A  C9 2B                 cmp #'+'
AB1C  D0 03                 bne ep_3
AB1E  20 98 A3              jsr chrget
                    ep_3:
AB21  20 2F AB              jsr ev_prim
AB24  20 43 A9              jsr chknum
                    ep_2:
AB27  20 73 AC              jsr pop_arg
AB2A  20 B6 D0              jsr fpow
AB2D  80 C8                 bra ep_loop
                    
                    ; 一番内側: 数、文字列、変数、関数、( )
                    ev_prim:
AB2F  20 9E A3              jsr chrgot
AB32  90 52                 bcc epr_num             ; 数字
AB34  C9 2E                 cmp #'.'
AB36  F0 4E                 beq epr_num
AB38  C9 26                 cmp #'&'
AB3A  F0 5B                 beq epr_hex
AB3C  C9 22                 cmp #'"'
AB3E  D0 03                 bne *+5
AB40  4C EC AB              jmp epr_str
AB43  C9 28                 cmp #'('
AB45  F0 44                 beq epr_paren
AB47  C9 B2                 cmp #TK_SGN
AB49  90 0F                 bcc epr_var
AB4B  C9 CD                 cmp #TK_INSTR+1
AB4D  B0 45                 bcs epr_sn
AB4F  38                    sec                     ; 関数
AB50  E9 B2                 sbc #TK_SGN
AB52  0A                    asl
AB53  AA                    tax
AB54  20 98 A3              jsr chrget
AB57  7C 2B B0              jmp (func_table,X)
                    epr_var:
AB5A  20 3E AC              jsr isletter
AB5D  90 35                 bcc epr_sn
AB5F  20 9C AC              jsr ptrget
AB62  A5 9C                 lda valtyp
AB64  D0 07                 bne epr_svar
AB66  A5 9D                 lda varptr
AB68  A4 9E                 ldy varptr+1
AB6A  4C F3 D2              jmp fac_ld
                    epr_svar:
AB6D  A5 9D                 lda varptr              ; 変数の記述子を一時記述子に写す
AB6F  85 D2                 sta strp
AB71  A5 9E                 lda varptr+1
AB73  85 D3                 sta strp+1
AB75  A0 00                 ldy #0
AB77  B1 D2                 lda (strp),Y
AB79  48                    pha
AB7A  C8                    iny
AB7B  B1 D2                 lda (strp),Y
AB7D  AA                    tax
AB7E  C8                    iny
AB7F  B1 D2                 lda (strp),Y
AB81  A8                    tay
AB82  68                    pla
AB83  4C AF B0              jmp put_temp
                    epr_num:
AB86  64 9C                 stz valtyp
AB88  4C F0 D7              jmp fin
                    epr_paren:
AB8B  20 98 A3              jsr chrget
AB8E  20 53 A9              jsr frmevl
AB91  4C CE A3              jmp chkclose
                    epr_sn:
AB94  4C E3 A8              jmp err_sn
                    epr_hex:
AB97  20 A1 AB              jsr hex_lit
AB9A  B0 01                 bcs eh_err
AB9C  60                    rts
                    eh_err:
AB9D  AA                    tax                     ; SN か OV
AB9E  4C 8E A8              jmp b_error
                    
                    ; &H のあとの16進数(0〜FFFF)を FAC に。chrgot が & を指していること(式、READ、INPUT で使う)
                    ; 終わると chrgot は数の次の文字。C=1 なら A = EN_SN(書き方の間違い)か EN_OV(FFFF を超えた)
                    hex_lit:
