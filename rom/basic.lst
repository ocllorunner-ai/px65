BA32  20 7E BA              jsr out_space
BA35  A5 EE                 lda cur_x
BA37  C9 08                 cmp #8
BA39  90 F7                 bcc pr_c1
BA3B  80 03                 bra pr_c3
                    pr_c2:
BA3D  20 92 A3              jsr crlf
                    pr_c3:
BA40  20 98 A3              jsr chrget
BA43  F0 2C                 beq pr_done
BA45  80 C1                 bra pr_1
                    pr_tab:
BA47  20 72 BA              jsr pr_arg
BA4A  85 C0                 sta bt0
                    pr_t1:
BA4C  A5 EE                 lda cur_x
BA4E  C5 C0                 cmp bt0
BA50  B0 15                 bcs pr_after
BA52  C9 10                 cmp #COLS
BA54  B0 11                 bcs pr_after
BA56  20 7E BA              jsr out_space
BA59  80 F1                 bra pr_t1
                    pr_spc:
BA5B  20 72 BA              jsr pr_arg
BA5E  AA                    tax
BA5F  F0 06                 beq pr_after
                    pr_s1:
BA61  20 7E BA              jsr out_space
BA64  CA                    dex
BA65  D0 FA                 bne pr_s1
                    pr_after:
BA67  20 9E A3              jsr chrgot
BA6A  F0 02                 beq pr_crlf
BA6C  80 9A                 bra pr_1
                    pr_crlf:
BA6E  4C 92 A3              jmp crlf
                    pr_done:
BA71  60                    rts
                    
                    ; TAB( SPC( の引数(トークンに ( が含まれている)
                    pr_arg:
BA72  20 98 A3              jsr chrget
BA75  20 40 A9              jsr frmnum
BA78  20 CE A3              jsr chkclose
BA7B  4C C1 D7              jmp getbyte
                    
                    out_space:
BA7E  A9 20                 lda #' '
BA80  4C 00 FF              jmp BIOS_CHROUT
                    
                    ; FAC の値を表示する(数なら後ろに空白)
                    print_value:
BA83  A5 9C                 lda valtyp
BA85  D0 13                 bne pv_str
BA87  20 27 D9              jsr fout
BA8A  A2 00                 ldx #0
                    pv_1:
BA8C  BD 98 03              lda fbuffr,X
BA8F  F0 06                 beq pv_2
BA91  20 00 FF              jsr BIOS_CHROUT
BA94  E8                    inx
BA95  80 F5                 bra pv_1
                    pv_2:
BA97  4C 7E BA              jmp out_space
                    pv_str:
BA9A  20 07 B1              jsr fac_str
BA9D  48                    pha
BA9E  20 DF B0              jsr free_fac
BAA1  68                    pla
BAA2  AA                    tax
BAA3  F0 0B                 beq pv_4
BAA5  A0 00                 ldy #0
                    pv_3:
BAA7  B1 D2                 lda (strp),Y
BAA9  20 00 FF              jsr BIOS_CHROUT
BAAC  C8                    iny
BAAD  CA                    dex
BAAE  D0 F7                 bne pv_3
                    pv_4:
BAB0  60                    rts
                    
                    ; ===================================================================
                    ; INPUT, READ, DATA
                    ; ===================================================================
                    
                    dsave      = $03FB          ; 2 INPUT の間、READ の位置を退避
                    isave      = $03FD          ; 2 INPUT をやり直すときの変数の並びの位置
                    in_first   = $03FF          ; INPUT: まだ1つも読んでいない
                    inptr      = datptr         ; INPUT の読む位置(INPUT の間だけ datptr を使う)
                    
                    st_input:
BAB1  A5 9B                 lda curlin+1            ; 直接実行ではできない
BAB3  25 9A                 and curlin
BAB5  C9 FF                 cmp #$FF
BAB7  D0 05                 bne si_1
BAB9  A2 0E                 ldx #EN_ID
BABB  4C 8E A8              jmp b_error
                    si_1:
BABE  A5 AD                 lda datptr
BAC0  8D FB 03              sta dsave
BAC3  A5 AE                 lda datptr+1
BAC5  8D FC 03              sta dsave+1
BAC8  20 9E A3              jsr chrgot
BACB  C9 22                 cmp #'"'
BACD  D0 17                 bne si_q
BACF  20 53 A9              jsr frmevl              ; "見出し"; なら ? を付ける、"見出し", なら付けない
BAD2  20 83 BA              jsr print_value
BAD5  20 9E A3              jsr chrgot
BAD8  C9 2C                 cmp #','
BADA  D0 05                 bne si_p1
BADC  20 98 A3              jsr chrget
BADF  80 0D                 bra si_ask
                    si_p1:
BAE1  A9 3B                 lda #';'
BAE3  20 BA A3              jsr synchr
                    si_q:
BAE6  A9 3F                 lda #'?'
BAE8  20 00 FF              jsr BIOS_CHROUT
BAEB  20 7E BA              jsr out_space
                    si_ask:
BAEE  A5 98                 lda txtptr              ; 変数の並びの始め(やり直しのため)
BAF0  8D FD 03              sta isave
BAF3  A5 99                 lda txtptr+1
BAF5  8D FE 03              sta isave+1
                    si_again:
BAF8  20 8A BB              jsr in_line_read
                    si_var:
BAFB  20 9C AC              jsr ptrget
BAFE  A5 9D                 lda varptr
BB00  85 B7                 sta forpnt
BB02  A5 9E                 lda varptr+1
BB04  85 B8                 sta forpnt+1
BB06  20 AB BB              jsr swap_ptr            ; txtptr = 入力行
BB09  AD FF 03              lda in_first            ; 最初の値なら、行が空でないか
BB0C  F0 0A                 beq si_v0
BB0E  9C FF 03              stz in_first
BB11  AD 00 03              lda LINEBUF
BB14  D0 23                 bne si_item
BB16  80 05                 bra si_more
                    si_v0:
BB18  20 9E A3              jsr chrgot              ; 次がなければ ?? で続きを聞く
BB1B  D0 1C                 bne si_item
                    si_more:
BB1D  20 AB BB              jsr swap_ptr
BB20  A9 3F                 lda #'?'
BB22  20 00 FF              jsr BIOS_CHROUT
BB25  20 00 FF              jsr BIOS_CHROUT
BB28  20 7E BA              jsr out_space
BB2B  20 8A BB              jsr in_line_read
BB2E  20 AB BB              jsr swap_ptr
BB31  9C FF 03              stz in_first
BB34  AD 00 03              lda LINEBUF
BB37  F0 E4                 beq si_more
                    si_item:
BB39  20 BC BB              jsr read_item
BB3C  B0 26                 bcs si_redo
BB3E  20 9E A3              jsr chrgot              ; 値の後は , か行の終わり
BB41  F0 04                 beq si_v1
BB43  C9 2C                 cmp #','
BB45  D0 1D                 bne si_redo
                    si_v1:
BB47  20 AB BB              jsr swap_ptr
BB4A  20 65 B3              jsr let_value
BB4D  20 9E A3              jsr chrgot
BB50  C9 2C                 cmp #','
BB52  D0 05                 bne si_end
BB54  20 98 A3              jsr chrget
BB57  80 A2                 bra si_var
                    si_end:
BB59  AD FB 03              lda dsave
BB5C  85 AD                 sta datptr
BB5E  AD FC 03              lda dsave+1
BB61  85 AE                 sta datptr+1
BB63  60                    rts
                    si_redo:
BB64  A5 9C                 lda valtyp              ; 文字列の変数なら、read_item が作った一時文字列を捨てる
BB66  F0 03                 beq si_rd1              ; (捨てないと、?REDO のたびに一時文字列がたまって ?OM になる。0.11.13 で修正)
BB68  20 DF B0              jsr free_fac
                    si_rd1:
BB6B  20 AB BB              jsr swap_ptr            ; 数でないものが入った: やり直し
BB6E  20 8E A3              jsr crlf_if
BB71  20 F7 A8              jsr strout_inline
BB74  3F 52 45 44 +         .byte "?REDO", K_RET, "? ", 0
BB7D  AD FD 03              lda isave
BB80  85 98                 sta txtptr
BB82  AD FE 03              lda isave+1
BB85  85 99                 sta txtptr+1
BB87  4C F8 BA              jmp si_again
                    
                    ; 1行入力して、読む位置(inptr)をその直前にする
                    in_line_read:
BB8A  A9 02                 lda #2
BB8C  8D BE 03              sta bstate
BB8F  20 09 FF              jsr BIOS_GETLINE
BB92  A9 01                 lda #1
BB94  8D BE 03              sta bstate
BB97  AE 50 02              ldx LINELEN
BB9A  9E 00 03              stz LINEBUF,X
BB9D  A9 FF                 lda #<(LINEBUF-1)
BB9F  85 AD                 sta inptr
BBA1  A9 02                 lda #>(LINEBUF-1)
BBA3  85 AE                 sta inptr+1
BBA5  A9 01                 lda #1
BBA7  8D FF 03              sta in_first
BBAA  60                    rts
                    
                    ; txtptr と datptr(inptr)を入れ替える
                    swap_ptr:
BBAB  A6 98                 ldx txtptr
BBAD  A5 AD                 lda datptr
BBAF  85 98                 sta txtptr
BBB1  86 AD                 stx datptr
BBB3  A6 99                 ldx txtptr+1
BBB5  A5 AE                 lda datptr+1
BBB7  85 99                 sta txtptr+1
BBB9  86 AE                 stx datptr+1
BBBB  60                    rts
                    
                    ; txtptr の次から、valtyp の型の値を1つ読む(FAC か一時文字列)。
                    ; 文字列: "..." か、, : 0 の前まで。数が読めなければ C=1
                    read_item:
BBBC  20 98 A3              jsr chrget
BBBF  A5 9C                 lda valtyp
BBC1  D0 1F                 bne ri_str
BBC3  20 9E A3              jsr chrgot              ; &H なら16進数
BBC6  C9 26                 cmp #'&'
BBC8  D0 06                 bne ri_dec
BBCA  20 A1 AB              jsr hex_lit
BBCD  90 04                 bcc ri_num
BBCF  60                    rts                     ; 書き方の間違い(C=1)
                    ri_dec:
BBD0  20 F0 D7              jsr fin
                    ri_num:
BBD3  20 9E A3              jsr chrgot
BBD6  F0 06                 beq ri_ok
BBD8  C9 2C                 cmp #','
BBDA  F0 02                 beq ri_ok
BBDC  38                    sec
BBDD  60                    rts
                    ri_ok:
BBDE  64 9C                 stz valtyp
BBE0  18                    clc
BBE1  60                    rts
                    ri_str:
BBE2  20 9E A3              jsr chrgot
BBE5  A2 00                 ldx #0                  ; 終わりの文字
BBE7  C9 22                 cmp #'"'
BBE9  D0 08                 bne ri_s1
BBEB  A2 22                 ldx #'"'
BBED  E6 98                 inc txtptr              ; " を飛ばす
BBEF  D0 02                 bne ri_s1
BBF1  E6 99                 inc txtptr+1
                    ri_s1:
BBF3  86 C0                 stx bt0
BBF5  A0 00                 ldy #0
                    ri_s2:
BBF7  B1 98                 lda (txtptr),Y
BBF9  F0 13                 beq ri_s4
BBFB  E0 00                 cpx #0
BBFD  D0 08                 bne ri_s3
BBFF  C9 2C                 cmp #','
BC01  F0 0B                 beq ri_s4
BC03  C9 3A                 cmp #':'
BC05  F0 07                 beq ri_s4
                    ri_s3:
BC07  C5 C0                 cmp bt0
BC09  F0 03                 beq ri_s4
BC0B  C8                    iny
BC0C  D0 E9                 bne ri_s2
                    ri_s4:
BC0E  5A                    phy
BC0F  98                    tya                     ; 一時文字列(本文の中を指す)
BC10  A6 98                 ldx txtptr
BC12  A4 99                 ldy txtptr+1
BC14  20 AF B0              jsr put_temp
BC17  7A                    ply
BC18  98                    tya                     ; txtptr を終わりへ
BC19  18                    clc
BC1A  65 98                 adc txtptr
BC1C  85 98                 sta txtptr
BC1E  90 02                 bcc ri_s5
BC20  E6 99                 inc txtptr+1
                    ri_s5:
BC22  A5 C0                 lda bt0                 ; 閉じる " を飛ばす
BC24  F0 0A                 beq ri_s6
BC26  B2 98                 lda (txtptr)
BC28  F0 06                 beq ri_s6
BC2A  E6 98                 inc txtptr
BC2C  D0 02                 bne ri_s6
BC2E  E6 99                 inc txtptr+1
                    ri_s6:
BC30  20 9E A3              jsr chrgot
BC33  18                    clc
BC34  60                    rts
                    
                    ; READ 変数 [, 変数 ...]
                    st_read:
                    rd_var:
BC35  20 9C AC              jsr ptrget
BC38  A5 9D                 lda varptr
BC3A  85 B7                 sta forpnt
BC3C  A5 9E                 lda varptr+1
BC3E  85 B8                 sta forpnt+1
BC40  20 74 BC              jsr data_next           ; 次のデータの直前へ
BC43  20 AB BB              jsr swap_ptr            ; txtptr = データ
BC46  20 BC BB              jsr read_item
BC49  B0 1C                 bcs rd_sn
BC4B  20 9E A3              jsr chrgot
BC4E  F0 04                 beq rd_1
BC50  C9 2C                 cmp #','
BC52  D0 13                 bne rd_sn
                    rd_1:
BC54  20 AB BB              jsr swap_ptr
BC57  20 65 B3              jsr let_value
BC5A  20 9E A3              jsr chrgot
BC5D  C9 2C                 cmp #','
BC5F  D0 05                 bne rd_end
BC61  20 98 A3              jsr chrget
BC64  80 CF                 bra rd_var
                    rd_end:
BC66  60                    rts
                    rd_sn:
BC67  AD DD 03              lda datlin              ; DATA の行のエラーにする
BC6A  85 9A                 sta curlin
BC6C  AD DE 03              lda datlin+1
BC6F  85 9B                 sta curlin+1
BC71  4C E3 A8              jmp err_sn
                    
                    ; datptr を次のデータの直前(, か DATA の直後)にする。なければ OD エラー
                    data_next:
BC74  B2 AD                 lda (datptr)
BC76  C9 2C                 cmp #','
BC78  D0 01                 bne dn_find
BC7A  60                    rts
                    dn_find:
BC7B  A0 00                 ldy #0
                    dn_1:
BC7D  B1 AD                 lda (datptr),Y
BC7F  F0 07                 beq dn_eol
BC81  C9 83                 cmp #TK_DATA
BC83  F0 2D                 beq dn_found
BC85  C8                    iny
BC86  D0 F5                 bne dn_1
                    dn_eol:
                            ; 行の終わり: 次の行へ
BC88  98                    tya
BC89  18                    clc
BC8A  65 AD                 adc datptr
BC8C  85 AD                 sta datptr
BC8E  90 02                 bcc dn_2
BC90  E6 AE                 inc datptr+1
                    dn_2:
BC92  A0 02                 ldy #2
BC94  B1 AD                 lda (datptr),Y          ; つなぎの上位が0ならプログラムの終わり
BC96  F0 25                 beq dn_od
BC98  A0 03                 ldy #3
BC9A  B1 AD                 lda (datptr),Y
BC9C  8D DD 03              sta datlin
BC9F  C8                    iny
BCA0  B1 AD                 lda (datptr),Y
BCA2  8D DE 03              sta datlin+1
BCA5  18                    clc
BCA6  A5 AD                 lda datptr
BCA8  69 05                 adc #5
BCAA  85 AD                 sta datptr
BCAC  90 CD                 bcc dn_find
BCAE  E6 AE                 inc datptr+1
BCB0  80 C9                 bra dn_find
                    dn_found:
BCB2  98                    tya                     ; datptr = DATA トークン(次の chrget で中身へ)
BCB3  18                    clc
BCB4  65 AD                 adc datptr
BCB6  85 AD                 sta datptr
BCB8  90 02                 bcc dn_3
BCBA  E6 AE                 inc datptr+1
                    dn_3:
BCBC  60                    rts
                    dn_od:
BCBD  A2 0C                 ldx #EN_OD
BCBF  4C 8E A8              jmp b_error
                    
                    ; RESTORE [行番号]
                    st_restore:
BCC2  B0 19                 bcs restore_data
BCC4  20 D6 A4              jsr linget
BCC7  20 1A A5              jsr fndlin
BCCA  B0 03                 bcs sre_1
BCCC  4C F2 A8              jmp err_ul
                    sre_1:
BCCF  38                    sec
BCD0  A5 B3                 lda lowtr
BCD2  E9 01                 sbc #1
BCD4  85 AD                 sta datptr
BCD6  A5 B4                 lda lowtr+1
BCD8  E9 00                 sbc #0
BCDA  85 AE                 sta datptr+1
BCDC  60                    rts
                    restore_data:
BCDD  A9 FF                 lda #<(PRGSTART-1)
BCDF  85 AD                 sta datptr
BCE1  A9 07                 lda #>(PRGSTART-1)
BCE3  85 AE                 sta datptr+1
BCE5  60                    rts
                    
                    ; ===================================================================
                    ; そのほか
                    ; ===================================================================
                    
                    ; POKE 番地, 値
                    st_poke:
BCE6  20 40 A9              jsr frmnum
BCE9  20 78 D7              jsr getint16
BCEC  A5 B5                 lda linnum
BCEE  48                    pha
BCEF  A5 B6                 lda linnum+1
BCF1  48                    pha
BCF2  20 C6 A3              jsr chkcom
BCF5  20 40 A9              jsr frmnum
BCF8  20 C1 D7              jsr getbyte
BCFB  7A                    ply
BCFC  84 B6                 sty linnum+1
BCFE  7A                    ply
BCFF  84 B5                 sty linnum
BD01  92 B5                 sta (linnum)
BD03  60                    rts
                    
                    ; CALL 番地(機械語を呼ぶ。RTS で戻る)
                    st_call:
BD04  20 40 A9              jsr frmnum
BD07  20 78 D7              jsr getint16
BD0A  A9 03                 lda #3
BD0C  8D BE 03              sta bstate
BD0F  A9 BD                 lda #>(sca_ret-1)
BD11  48                    pha
BD12  A9 17                 lda #<(sca_ret-1)
BD14  48                    pha
BD15  6C B5 00              jmp (linnum)
                    sca_ret:
BD18  D8                    cld
BD19  A9 01                 lda #1
BD1B  8D BE 03              sta bstate
BD1E  60                    rts
                    
                    ; WAIT n(1/64秒単位)
                    st_wait:
BD1F  20 40 A9              jsr frmnum
BD22  20 78 D7              jsr getint16
BD25  18                    clc                     ; 終わる時刻 = ticks + n
BD26  A5 F2                 lda ticks
BD28  65 B5                 adc linnum
BD2A  85 C0                 sta bt0
BD2C  A5 F3                 lda ticks+1
BD2E  65 B6                 adc linnum+1
BD30  85 C1                 sta bt1
                    sw_1:
BD32  AD BD 03              lda brkflag
BD35  D0 0E                 bne sw_2
BD37  38                    sec
BD38  A5 F2                 lda ticks
BD3A  E5 C0                 sbc bt0
BD3C  A5 F3                 lda ticks+1
BD3E  E5 C1                 sbc bt1
BD40  10 03                 bpl sw_2                ; ticks - 終わり >= 0
BD42  CB                    wai
BD43  80 ED                 bra sw_1
                    sw_2:
BD45  60                    rts
                    
                    st_cls:
BD46  4C 15 FF              jmp BIOS_CLS
                    
                    ; LOCATE 桁, 行
                    st_locate:
BD49  20 40 A9              jsr frmnum
BD4C  20 C1 D7              jsr getbyte
BD4F  C9 10                 cmp #COLS
BD51  B0 13                 bcs sl_fc
BD53  48                    pha
BD54  20 C6 A3              jsr chkcom
BD57  20 40 A9              jsr frmnum
BD5A  20 C1 D7              jsr getbyte
BD5D  C9 04                 cmp #ROWS
BD5F  B0 05                 bcs sl_fc
BD61  A8                    tay
BD62  FA                    plx
BD63  4C 18 FF              jmp BIOS_LOCATE
                    sl_fc:
BD66  4C CA DA              jmp err_fc
                    
                    st_deg:
BD69  A9 01                 lda #1
BD6B  80 02                 bra sdr_1
                    st_rad:
BD6D  A9 00                 lda #0
                    sdr_1:
BD6F  8D BA 03              sta angmode
BD72  4C 71 A2              jmp show_angle
                    
                    st_mon:
BD75  A9 20                 lda #ANN_RUN            ; プログラムの中の MON でも RUN を消す
BD77  1C 02 80              trb LCD_ANN
BD7A  4C 21 FF              jmp BIOS_MONENTER
                    
                    ; ===================================================================
                    ; LIST, EDIT, DELETE
                    ; ===================================================================
                    
                    ; LIST [初め][-[終わり]]
                    st_list:
BD7D  20 DD BD              jsr range_args
BD80  64 DF                 stz listrow
BD82  A9 02                 lda #2                  ; ページ送りのキー待ちでは BREAK ですぐ止める
BD84  8D BE 03              sta bstate
BD87  20 37 BE              jsr fndlin_lo
                    sli_1:
BD8A  A0 01                 ldy #1
BD8C  B1 B3                 lda (lowtr),Y
BD8E  F0 47                 beq sli_done            ; プログラムの終わり
BD90  A0 03                 ldy #3                  ; 終わりを超えたか
BD92  B1 B3                 lda (lowtr),Y
BD94  C5 C3                 cmp bt3
BD96  90 0B                 bcc sli_2
BD98  D0 3D                 bne sli_done
BD9A  88                    dey
BD9B  B1 B3                 lda (lowtr),Y
BD9D  C5 C2                 cmp bt2
BD9F  F0 02                 beq sli_2
BDA1  B0 34                 bcs sli_done
                    sli_2:
BDA3  A5 DF                 lda listrow             ; 画面がいっぱいならキーを待つ
BDA5  C9 03                 cmp #3
BDA7  90 11                 bcc sli_3
BDA9  20 03 FF              jsr BIOS_GETKEY
BDAC  C9 0D                 cmp #K_RET
BDAE  F0 08                 beq sli_k
BDB0  C9 14                 cmp #K_DOWN
BDB2  F0 04                 beq sli_k
BDB4  C9 20                 cmp #' '
BDB6  D0 1F                 bne sli_done
                    sli_k:
BDB8  64 DF                 stz listrow
                    sli_3:
BDBA  20 8E A3              jsr crlf_if
BDBD  64 C0                 stz bt0                 ; 表示した文字数
BDBF  A9 00                 lda #0
BDC1  20 47 BE              jsr detok_line
BDC4  A5 C0                 lda bt0                 ; 使った行数 = (文字数 + 15) / 16
BDC6  18                    clc
BDC7  69 0F                 adc #15
BDC9  4A                    lsr
BDCA  4A                    lsr
BDCB  4A                    lsr
BDCC  4A                    lsr
BDCD  18                    clc
BDCE  65 DF                 adc listrow
BDD0  85 DF                 sta listrow
BDD2  20 3A BE              jsr next_line
BDD5  80 B3                 bra sli_1
                    sli_done:
BDD7  A9 01                 lda #1
BDD9  8D BE 03              sta bstate
BDDC  60                    rts
                    
                    ; LIST、DELETE の範囲: bt0/bt1 = 初め(linnum にも)、bt2/bt3 = 終わり
                    range_args:
BDDD  64 B5                 stz linnum
BDDF  64 B6                 stz linnum+1
BDE1  A9 FF                 lda #$FF
BDE3  85 C2                 sta bt2
BDE5  85 C3                 sta bt3
BDE7  20 9E A3              jsr chrgot
BDEA  F0 3F                 beq ra_done
BDEC  B0 1A                 bcs ra_dash
BDEE  20 D6 A4              jsr linget
BDF1  A5 B5                 lda linnum
BDF3  85 C2                 sta bt2
BDF5  A5 B6                 lda linnum+1
BDF7  85 C3                 sta bt3
BDF9  20 9E A3              jsr chrgot
BDFC  C9 2D                 cmp #'-'
BDFE  D0 2B                 bne ra_done
BE00  A9 FF                 lda #$FF                ; 初め- なら終わりまで
BE02  85 C2                 sta bt2
BE04  85 C3                 sta bt3
BE06  80 04                 bra ra_d2
                    ra_dash:
BE08  C9 2D                 cmp #'-'
BE0A  D0 28                 bne ra_sn
                    ra_d2:
BE0C  20 98 A3              jsr chrget
BE0F  B0 1A                 bcs ra_done
BE11  A5 B5                 lda linnum
BE13  48                    pha
BE14  A5 B6                 lda linnum+1
BE16  48                    pha
BE17  20 9E A3              jsr chrgot
BE1A  20 D6 A4              jsr linget
BE1D  A5 B5                 lda linnum
BE1F  85 C2                 sta bt2
BE21  A5 B6                 lda linnum+1
BE23  85 C3                 sta bt3
BE25  68                    pla
BE26  85 B6                 sta linnum+1
BE28  68                    pla
BE29  85 B5                 sta linnum
                    ra_done:
BE2B  A5 B5                 lda linnum
BE2D  85 C0                 sta bt0
BE2F  A5 B6                 lda linnum+1
BE31  85 C1                 sta bt1
BE33  60                    rts
                    ra_sn:
BE34  4C E3 A8              jmp err_sn
                    
                    ; lowtr = 行番号 linnum 以上の最初の行
                    fndlin_lo:
BE37  4C 1A A5              jmp fndlin
                    
                    ; lowtr を次の行へ
                    next_line:
BE3A  A0 00                 ldy #0
BE3C  B1 B3                 lda (lowtr),Y
BE3E  AA                    tax
BE3F  C8                    iny
BE40  B1 B3                 lda (lowtr),Y
BE42  85 B4                 sta lowtr+1
BE44  86 B3                 stx lowtr
BE46  60                    rts
                    
                    ; lowtr の行を文字にする。A=0 なら表示(bt0 に文字数)、A=1 なら LINEBUF へ(LINELEN)
                    detok_line:
BE47  85 C7                 sta bt7
BE49  A9 80                 lda #$80                ; まずキーワードの前後に空白を足す形で
BE4B  85 C6                 sta bt6
                    dl_again:
BE4D  BA                    tsx                     ; 入力行に入りきらなかったときに戻る位置
BE4E  86 C5                 stx bt5
BE50  9C 50 02              stz LINELEN
BE53  A0 02                 ldy #2
BE55  B1 B3                 lda (lowtr),Y
BE57  AA                    tax
BE58  C8                    iny
BE59  B1 B3                 lda (lowtr),Y
BE5B  A8                    tay
BE5C  8A                    txa
BE5D  20 D9 D6              jsr fac_u16             ; 行番号
BE60  20 27 D9              jsr fout
BE63  A2 01                 ldx #1
                    dl_1:
BE65  BD 98 03              lda fbuffr,X
BE68  F0 06                 beq dl_2
BE6A  20 0F BF              jsr dt_out
BE6D  E8                    inx
BE6E  80 F5                 bra dl_1
                    dl_2:
BE70  A9 20                 lda #' '
BE72  20 0F BF              jsr dt_out
BE75  18                    clc                     ; 本文
BE76  A5 B3                 lda lowtr
BE78  69 04                 adc #4
BE7A  85 B1                 sta index2
BE7C  A5 B4                 lda lowtr+1
BE7E  69 00                 adc #0
BE80  85 B2                 sta index2+1
                    dl_3:
BE82  B2 B1                 lda (index2)
BE84  D0 01                 bne dl_3b
BE86  60                    rts                     ; 行の終わり
                    dl_3b:
BE87  30 0B                 bmi dl_tok
BE89  20 0F BF              jsr dt_out
                    dl_next:
BE8C  E6 B1                 inc index2
BE8E  D0 F2                 bne dl_3
BE90  E6 B2                 inc index2+1
BE92  80 EE                 bra dl_3
                    dl_tok:
                            ; トークンをキーワードに。前が英字、数字、" か ) なら空白を足す
BE94  48                    pha
BE95  24 C6                 bit bt6
BE97  10 0C                 bpl dl_tk1
BE99  A5 C4                 lda bt4
BE9B  20 3C BF              jsr dt_word
BE9E  90 05                 bcc dl_tk1
BEA0  A9 20                 lda #' '
BEA2  20 0F BF              jsr dt_out
                    dl_tk1:
BEA5  68                    pla
BEA6  38                    sec
BEA7  E9 80                 sbc #$80
BEA9  AA                    tax
BEAA  A9 1A                 lda #<kwtab
BEAC  85 AF                 sta index1
BEAE  A9 A0                 lda #>kwtab
BEB0  85 B0                 sta index1+1
                    dl_t1:
BEB2  E0 00                 cpx #0
BEB4  F0 15                 beq dl_t3
BEB6  A0 00                 ldy #0
                    dl_t2:
BEB8  B1 AF                 lda (index1),Y
BEBA  C8                    iny
BEBB  0A                    asl
BEBC  90 FA                 bcc dl_t2
BEBE  98                    tya
BEBF  18                    clc
BEC0  65 AF                 adc index1
BEC2  85 AF                 sta index1
BEC4  90 02                 bcc dl_t2b
BEC6  E6 B0                 inc index1+1
                    dl_t2b:
BEC8  CA                    dex
BEC9  80 E7                 bra dl_t1
                    dl_t3:
BECB  A0 00                 ldy #0
                    dl_t4:
BECD  B1 AF                 lda (index1),Y
BECF  48                    pha
BED0  29 7F                 and #$7F
BED2  20 0F BF              jsr dt_out
BED5  C8                    iny
BED6  68                    pla
BED7  10 F4                 bpl dl_t4
                            ; 後ろが英字、数字、"、.、& か次のキーワードなら空白を足す(SIN( などの後は足さない)
BED9  24 C6                 bit bt6
BEDB  10 2E                 bpl dl_t5
BEDD  A5 C4                 lda bt4
BEDF  C9 28                 cmp #'('
BEE1  F0 28                 beq dl_t5
BEE3  A0 01                 ldy #1
BEE5  B1 B1                 lda (index2),Y
BEE7  30 1D                 bmi dl_t6               ; 次もキーワード
BEE9  C9 28                 cmp #'('                ; ( の前: 命令や AND などの後は空白、関数(SIN( など)の後は詰める
BEEB  D0 08                 bne dl_t7
BEED  B2 B1                 lda (index2)
BEEF  C9 B2                 cmp #TK_SGN
BEF1  90 13                 bcc dl_t6
BEF3  80 16                 bra dl_t5
                    dl_t7:
BEF5  C9 2E                 cmp #'.'
BEF7  F0 0D                 beq dl_t6
BEF9  C9 26                 cmp #'&'
BEFB  F0 09                 beq dl_t6
BEFD  C9 29                 cmp #')'                ; ) は dt_word では英字の仲間だが、キーワードの後ろには空白を足さない(PI) など)
BEFF  F0 0A                 beq dl_t5
BF01  20 3C BF              jsr dt_word
BF04  90 05                 bcc dl_t5
                    dl_t6:
BF06  A9 20                 lda #' '
BF08  20 0F BF              jsr dt_out
                    dl_t5:
BF0B  4C 8C BE              jmp dl_next
                    dl_done:
BF0E  60                    rts
                    
                    ; detok_line の1文字(X, Y は保存)
                    dt_out:
BF0F  85 C4                 sta bt4                 ; 最後に出した文字
BF11  24 C7                 bit bt7
BF13  30 05                 bmi dto_buf             ; bt7 = $FF なら LINEBUF へ
BF15  E6 C0                 inc bt0
BF17  4C 00 FF              jmp BIOS_CHROUT
                    dto_buf:
BF1A  DA                    phx
BF1B  AE 50 02              ldx LINELEN
BF1E  E0 3A                 cpx #LINEMAX
BF20  B0 08                 bcs dto_full
BF22  9D 00 03              sta LINEBUF,X
BF25  EE 50 02              inc LINELEN
BF28  FA                    plx
BF29  60                    rts
                    dto_full:
BF2A  FA                    plx
BF2B  24 C6                 bit bt6                 ; 空白を足した形で入りきらなければ、足さない形でやり直す
BF2D  10 08                 bpl dto_ls
BF2F  64 C6                 stz bt6
BF31  A6 C5                 ldx bt5
BF33  9A                    txs
BF34  4C 4D BE              jmp dl_again
                    dto_ls:
BF37  A2 09                 ldx #EN_LS
BF39  4C 8E A8              jmp b_error
                    
                    ; A が英字、数字、" か ) なら C=1(キーワードとの間に空白を入れる文字)
                    dt_word:
BF3C  C9 22                 cmp #'"'
BF3E  F0 0F                 beq dw_yes
BF40  C9 29                 cmp #')'
BF42  F0 0B                 beq dw_yes
BF44  C9 30                 cmp #'0'
BF46  90 09                 bcc dw_no
BF48  C9 3A                 cmp #'9'+1
BF4A  90 03                 bcc dw_yes
BF4C  4C 3E AC              jmp isletter
                    dw_yes:
BF4F  38                    sec
BF50  60                    rts
                    dw_no:
BF51  18                    clc
BF52  60                    rts
                    
                    ; EDIT 行番号: その行を入力行に出して直せるようにする
                    st_edit:
BF53  90 03                 bcc se_1
BF55  4C E3 A8              jmp err_sn
                    se_1:
BF58  20 D6 A4              jsr linget
BF5B  20 1A A5              jsr fndlin
BF5E  B0 03                 bcs se_2
BF60  4C F2 A8              jmp err_ul
                    se_2:
BF63  A9 FF                 lda #$FF
BF65  20 47 BE              jsr detok_line
BF68  A2 FF                 ldx #$FF
BF6A  9A                    txs
BF6B  9C D6 03              stz contok
BF6E  9C BE 03              stz bstate
BF71  20 8E A3              jsr crlf_if
BF74  A9 3E                 lda #'>'
BF76  20 00 FF              jsr BIOS_CHROUT
BF79  20 1E FF              jsr BIOS_GETLINE_ED
BF7C  4C EC A2              jmp main_edit           ; 計算モードでも、直した行はプログラムに入れる
                    
                    ; DELETE 初め[-終わり]
                    st_delete:
BF7F  20 DD BD              jsr range_args
BF82  A5 C0                 lda bt0
BF84  05 C1                 ora bt1
BF86  D0 03                 bne sdl_1
BF88  4C CA DA              jmp err_fc              ; 範囲がない
                    sdl_1:
                            ; 消す範囲: [初めの行, 終わりの次の行)
BF8B  20 1A A5              jsr fndlin
BF8E  A5 B3                 lda lowtr
BF90  85 BA                 sta dest
BF92  A5 B4                 lda lowtr+1
BF94  85 BB                 sta dest+1
                    sdl_2:
BF96  A0 01                 ldy #1
BF98  B1 B3                 lda (lowtr),Y
BF9A  F0 18                 beq sdl_3
BF9C  A0 03                 ldy #3
BF9E  B1 B3                 lda (lowtr),Y
BFA0  C5 C3                 cmp bt3
BFA2  90 0B                 bcc sdl_n
BFA4  D0 0E                 bne sdl_3
BFA6  88                    dey
BFA7  B1 B3                 lda (lowtr),Y
BFA9  C5 C2                 cmp bt2
BFAB  F0 02                 beq sdl_n
BFAD  B0 05                 bcs sdl_3
                    sdl_n:
BFAF  20 3A BE              jsr next_line
BFB2  80 E2                 bra sdl_2
                    sdl_3:
BFB4  A5 B3                 lda lowtr               ; [lowtr, vartab) を dest へ
BFB6  85 BC                 sta srcp
BFB8  A5 B4                 lda lowtr+1
BFBA  85 BD                 sta srcp+1
BFBC  38                    sec
BFBD  A5 A1                 lda vartab
BFBF  E5 BC                 sbc srcp
BFC1  85 BE                 sta movlen
BFC3  A5 A2                 lda vartab+1
BFC5  E5 BD                 sbc srcp+1
BFC7  85 BF                 sta movlen+1
BFC9  38                    sec                     ; vartab -= 消した長さ
BFCA  A5 BC                 lda srcp
BFCC  E5 BA                 sbc dest
BFCE  85 C0                 sta bt0
BFD0  A5 BD                 lda srcp+1
BFD2  E5 BB                 sbc dest+1
BFD4  85 C1                 sta bt1
BFD6  A5 BA                 lda dest
BFD8  48                    pha
BFD9  A5 BB                 lda dest+1
BFDB  48                    pha
BFDC  20 56 A6              jsr move_down
BFDF  68                    pla
BFE0  85 BB                 sta dest+1
BFE2  68                    pla
BFE3  85 BA                 sta dest
BFE5  38                    sec
BFE6  A5 A1                 lda vartab
BFE8  E5 C0                 sbc bt0
BFEA  85 A1                 sta vartab
BFEC  A5 A2                 lda vartab+1
BFEE  E5 C1                 sbc bt1
BFF0  85 A2                 sta vartab+1
BFF2  20 1C A6              jsr relink
BFF5  20 C3 A6              jsr clearc
BFF8  4C 83 A2              jmp ready
                    
                    ; ===================================================================
                    ; RENUM [新しい開始[,増分[,元の開始]]]  行番号を振り直す
                    ;   元の開始より後ろの行を、新しい開始から増分おきにする(省くと 10,10,0)。
                    ;   GOTO GOSUB THEN ELSE RUN RESTORE と ON の並びの行番号も直す。
                    ;   ない行への参照はそのまま残し、下調べのときに「UNDEF 番号 IN 行」で知らせる
                    ;   (知らせが3行を超えてキーを待っているときは、BREAK で何も変えずにやめられる)。
                    ;   順番が変わる、63999 を超えるときは何も変えずに FC。
                    ;
                    ; やり方: 振り直す行の元の番号の表をメモリの上端に作る(参照は二分探索で探す)。
                    ; 下調べで伸びる分を数えて入るか確かめてから、プログラムを表のすぐ下へ移し、
                    ; $0800 へ写し戻しながら行番号を書き換える。
                    ; ===================================================================
                    st_renum:
BFFB  A9 0A                 lda #10
BFFD  8D DB 02              sta rn_new
C000  8D DD 02              sta rn_inc
C003  9C DC 02              stz rn_new+1
C006  9C DE 02              stz rn_inc+1
C009  9C DF 02              stz rn_old
C00C  9C E0 02              stz rn_old+1
C00F  20 F8 C0              jsr rn_arg
C012  90 0A                 bcc rn_a1
C014  A5 B5                 lda linnum
C016  8D DB 02              sta rn_new
C019  A5 B6                 lda linnum+1
C01B  8D DC 02              sta rn_new+1
                    rn_a1:
C01E  20 04 C1              jsr rn_comma
C021  F0 2B                 beq rn_go
C023  20 F8 C0              jsr rn_arg
C026  90 0A                 bcc rn_a2
C028  A5 B5                 lda linnum
C02A  8D DD 02              sta rn_inc
C02D  A5 B6                 lda linnum+1
C02F  8D DE 02              sta rn_inc+1
                    rn_a2:
C032  20 04 C1              jsr rn_comma
C035  F0 17                 beq rn_go
C037  20 F8 C0              jsr rn_arg
C03A  90 0A                 bcc rn_a3
C03C  A5 B5                 lda linnum
C03E  8D DF 02              sta rn_old
C041  A5 B6                 lda linnum+1
C043  8D E0 02              sta rn_old+1
                    rn_a3:
C046  20 9E A3              jsr chrgot
C049  F0 03                 beq rn_go
C04B  4C E3 A8              jmp err_sn
                    rn_go:
C04E  AD DD 02              lda rn_inc
C051  0D DE 02              ora rn_inc+1
C054  D0 03                 bne rn_g1
C056  4C CA DA              jmp err_fc
                    rn_g1:
C059  20 9A C1              jsr rn_check            ; 順番と上限を確かめ、振り直す行を数える
C05C  AD EB 02              lda rn_cnt
C05F  0A                    asl                     ; 表の始め = MEMSIZ - 行数 × 2
C060  85 C0                 sta bt0
C062  AD EC 02              lda rn_cnt+1
C065  2A                    rol
C066  85 C1                 sta bt1
C068  38                    sec
C069  A9 00                 lda #<MEMSIZ
C06B  E5 C0                 sbc bt0
C06D  8D ED 02              sta rn_tab
C070  A9 80                 lda #>MEMSIZ
C072  E5 C1                 sbc bt1
C074  8D EE 02              sta rn_tab+1
C077  9C E1 02              stz rn_grow
C07A  9C E2 02              stz rn_grow+1
C07D  20 16 C1              jsr rn_room             ; 表が入るか
C080  20 C3 A6              jsr clearc              ; ここから変数の領域を使う
C083  20 F7 C1              jsr rn_mktab
C086  9C E6 02              stz rn_mode             ; 下調べ: 伸びる分を数え、ない行への参照を知らせる
C089  9C F6 02              stz rn_quiet
C08C  64 DF                 stz listrow
C08E  A9 02                 lda #2                  ; 知らせのキー待ちで BREAK を押したらすぐやめる(まだ何も変えていない)
C090  8D BE 03              sta bstate
C093  A9 00                 lda #<PRGSTART
C095  85 BC                 sta srcp
C097  A9 08                 lda #>PRGSTART
C099  85 BD                 sta srcp+1
C09B  20 04 C3              jsr rn_scan
C09E  A9 01                 lda #1                  ; ここからは BREAK で止めない
C0A0  8D BE 03              sta bstate
C0A3  20 16 C1              jsr rn_room             ; 伸びても入るか
C0A6  38                    sec                     ; プログラムを表のすぐ下へ移す
C0A7  A5 A1                 lda vartab
C0A9  E9 00                 sbc #<PRGSTART
C0AB  85 BE                 sta movlen
C0AD  A5 A2                 lda vartab+1
C0AF  E9 08                 sbc #>PRGSTART
C0B1  85 BF                 sta movlen+1
C0B3  38                    sec
C0B4  AD ED 02              lda rn_tab
C0B7  E5 BE                 sbc movlen
C0B9  85 BA                 sta dest
C0BB  85 C2                 sta bt2
C0BD  AD EE 02              lda rn_tab+1
C0C0  E5 BF                 sbc movlen+1
C0C2  85 BB                 sta dest+1
C0C4  85 C3                 sta bt3
C0C6  A9 00                 lda #<PRGSTART
C0C8  85 BC                 sta srcp
C0CA  A9 08                 lda #>PRGSTART
C0CC  85 BD                 sta srcp+1
C0CE  20 77 A6              jsr move_up
C0D1  A5 C2                 lda bt2                 ; そこから $0800 へ写し戻しながら書き換える
C0D3  85 BC                 sta srcp
C0D5  A5 C3                 lda bt3
C0D7  85 BD                 sta srcp+1
C0D9  A9 00                 lda #<PRGSTART
C0DB  85 BA                 sta dest
C0DD  A9 08                 lda #>PRGSTART
C0DF  85 BB                 sta dest+1
C0E1  EE E6 02              inc rn_mode
C0E4  20 04 C3              jsr rn_scan
C0E7  A5 BA                 lda dest                ; プログラムの終わり
C0E9  85 A1                 sta vartab
C0EB  A5 BB                 lda dest+1
C0ED  85 A2                 sta vartab+1
C0EF  20 1C A6              jsr relink
C0F2  20 C3 A6              jsr clearc
C0F5  4C 83 A2              jmp ready
                    
                    ; 数字があれば linnum に読んで C=1。なければ C=0
                    rn_arg:
C0F8  20 9E A3              jsr chrgot
C0FB  B0 05                 bcs rn_arg0
C0FD  20 D6 A4              jsr linget
C100  38                    sec
C101  60                    rts
                    rn_arg0:
C102  18                    clc
C103  60                    rts
                    
                    ; 文の終わりなら Z=1。カンマなら読み飛ばして Z=0。ほかは SN
                    rn_comma:
C104  20 9E A3              jsr chrgot
C107  F0 0C                 beq rn_c1
C109  C9 2C                 cmp #','
C10B  F0 03                 beq rn_c2
C10D  4C E3 A8              jmp err_sn
                    rn_c2:
C110  20 98 A3              jsr chrget
C113  A9 01                 lda #1
                    rn_c1:
C115  60                    rts
                    
                    ; vartab + rn_grow <= rn_tab でなければ OM
                    rn_room:
C116  18                    clc
C117  A5 A1                 lda vartab
C119  6D E1 02              adc rn_grow
C11C  85 C0                 sta bt0
C11E  A5 A2                 lda vartab+1
C120  6D E2 02              adc rn_grow+1
C123  B0 10                 bcs rrm_om
C125  CD EE 02              cmp rn_tab+1
C128  90 11                 bcc rrm_ok
C12A  D0 09                 bne rrm_om
C12C  A5 C0                 lda bt0
C12E  CD ED 02              cmp rn_tab
C131  90 08                 bcc rrm_ok
C133  F0 06                 beq rrm_ok
                    rrm_om:
C135  20 C3 A6              jsr clearc
C138  4C E8 A8              jmp err_om
                    rrm_ok:
C13B  60                    rts
                    
                    ; 次に振り直す行の番号を rn_cur に。C=1 なら 16ビットを超えた
                    rn_step:
C13C  AD E5 02              lda rn_first
C13F  F0 11                 beq rst_1
C141  9C E5 02              stz rn_first
C144  AD DB 02              lda rn_new
C147  8D E3 02              sta rn_cur
C14A  AD DC 02              lda rn_new+1
C14D  8D E4 02              sta rn_cur+1
C150  18                    clc
C151  60                    rts
                    rst_1:
C152  18                    clc
C153  AD E3 02              lda rn_cur
C156  6D DD 02              adc rn_inc
C159  8D E3 02              sta rn_cur
C15C  AD E4 02              lda rn_cur+1
C15F  6D DE 02              adc rn_inc+1
C162  8D E4 02              sta rn_cur+1
C165  60                    rts
                    
                    ; 行番号 linnum が振り直す番号(>= rn_old)なら C=1
                    rn_isren:
C166  A5 B6                 lda linnum+1
C168  CD E0 02              cmp rn_old+1
C16B  D0 05                 bne rir_1
C16D  A5 B5                 lda linnum
C16F  CD DF 02              cmp rn_old
                    rir_1:
C172  60                    rts
                    
                    ; index2 の行の番号を linnum に
                    rn_getnum:
C173  A0 02                 ldy #2
C175  B1 B1                 lda (index2),Y
C177  85 B5                 sta linnum
C179  C8                    iny
C17A  B1 B1                 lda (index2),Y
C17C  85 B6                 sta linnum+1
C17E  60                    rts
                    
                    ; index2 を次の行へ(つなぎをたどる)
                    rn_nextl:
C17F  A0 00                 ldy #0
C181  B1 B1                 lda (index2),Y
C183  AA                    tax
C184  C8                    iny
C185  B1 B1                 lda (index2),Y
C187  85 B2                 sta index2+1
C189  86 B1                 stx index2
C18B  60                    rts
                    
                    ; index2 をプログラムの始めに、rn_first を 1 に
                    rn_begin:
C18C  A9 00                 lda #<PRGSTART
C18E  85 B1                 sta index2
C190  A9 08                 lda #>PRGSTART
C192  85 B2                 sta index2+1
C194  A9 01                 lda #1
C196  8D E5 02              sta rn_first
C199  60                    rts
                    
                    ; 振り直しても順番が変わらないか、63999 を超えないかを確かめる。振り直す行の数を rn_cnt に
                    rn_check:
