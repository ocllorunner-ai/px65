C53F  AD F3 02              lda rn_val+1
C542  85 C1                 sta bt1
C544  A2 00                 ldx #0                  ; 10000, 1000, 100, 10 の順
C546  A0 00                 ldy #0                  ; 書いた桁数
                    rfm_1:
C548  A9 30                 lda #'0'
C54A  85 C3                 sta bt3
                    rfm_2:
C54C  38                    sec
C54D  A5 C0                 lda bt0
C54F  FD 83 C5              sbc rn_pwlo,X
C552  48                    pha
C553  A5 C1                 lda bt1
C555  FD 87 C5              sbc rn_pwhi,X
C558  90 09                 bcc rfm_3
C55A  85 C1                 sta bt1
C55C  68                    pla
C55D  85 C0                 sta bt0
C55F  E6 C3                 inc bt3
C561  80 E9                 bra rfm_2
                    rfm_3:
C563  68                    pla
C564  A5 C3                 lda bt3
C566  C0 00                 cpy #0                  ; まだ何も書いていなければ 0 は出さない
C568  D0 04                 bne rfm_4
C56A  C9 30                 cmp #'0'
C56C  F0 04                 beq rfm_5
                    rfm_4:
C56E  99 98 03              sta fbuffr,Y
C571  C8                    iny
                    rfm_5:
C572  E8                    inx
C573  E0 04                 cpx #4
C575  D0 D1                 bne rfm_1
C577  A5 C0                 lda bt0                 ; 1の位
C579  09 30                 ora #'0'
C57B  99 98 03              sta fbuffr,Y
C57E  C8                    iny
C57F  8C E9 02              sty rn_nlen
C582  60                    rts
                    rn_pwlo:
C583  10 E8 64 0A           .byte <10000, <1000, <100, <10
                    rn_pwhi:
C587  27 03 00 00           .byte >10000, >1000, >100, >10
                    
                    ; PX-65 BASIC: グラフィック、音、テープ
                    
                    ; ===================================================================
                    ; グラフィック
                    ; ===================================================================
                    ;
                    ; 座標は -1024 から 1023 まで書ける(画面の外の点は描かない)。
                    ; モード: 1 点ける、0 消す、2 反転
                    
                    ; (gx0, gy0) の点を grmode で描く
                    plot:
C58B  AD DC 02              lda gx0+1
C58E  D0 25                 bne plt_out
C590  AD DB 02              lda gx0
C593  C9 60                 cmp #96
C595  B0 1E                 bcs plt_out
C597  AD DE 02              lda gy0+1
C59A  D0 19                 bne plt_out
C59C  AD DD 02              lda gy0
C59F  C9 20                 cmp #32
C5A1  B0 12                 bcs plt_out
C5A3  20 C6 C5              jsr pix_addr
C5A6  AD DF 03              lda grmode
C5A9  F0 0B                 beq plt_clr
C5AB  C9 02                 cmp #2
C5AD  F0 10                 beq plt_xor
C5AF  B2 AF                 lda (index1)
C5B1  05 C0                 ora bt0
C5B3  92 AF                 sta (index1)
                    plt_out:
C5B5  60                    rts
                    plt_clr:
C5B6  A5 C0                 lda bt0
C5B8  49 FF                 eor #$FF
C5BA  32 AF                 and (index1)
C5BC  92 AF                 sta (index1)
C5BE  60                    rts
                    plt_xor:
C5BF  B2 AF                 lda (index1)
C5C1  45 C0                 eor bt0
C5C3  92 AF                 sta (index1)
C5C5  60                    rts
                    
                    ; (gx0, gy0)(画面の中)の VRAM の番地を index1 に、ビットを bt0 に
                    pix_addr:
C5C6  AD DD 02              lda gy0
C5C9  4A                    lsr
C5CA  4A                    lsr
C5CB  4A                    lsr
C5CC  AA                    tax
C5CD  18                    clc
C5CE  BD E9 C5              lda pg_lo,X
C5D1  6D DB 02              adc gx0
C5D4  85 AF                 sta index1
C5D6  BD ED C5              lda pg_hi,X
C5D9  69 00                 adc #0
C5DB  85 B0                 sta index1+1
C5DD  AD DD 02              lda gy0
C5E0  29 07                 and #7
C5E2  AA                    tax
C5E3  BD F1 C5              lda pix_bit,X
C5E6  85 C0                 sta bt0
C5E8  60                    rts
C5E9  00 60 C0 20   pg_lo:  .byte <VRAM, <(VRAM+96), <(VRAM+192), <(VRAM+288)
C5ED  04 04 04 05   pg_hi:  .byte >VRAM, >(VRAM+96), >(VRAM+192), >(VRAM+288)
                    pix_bit:
C5F1  01 02 04 08 +         .byte $01, $02, $04, $08, $10, $20, $40, $80
                    
                    ; 座標を1つ読んで、gx0 から X バイト目に置く(-1024 から 1023)
                    get_coord:
C5F9  DA                    phx
C5FA  20 40 A9              jsr frmnum
C5FD  20 78 D7              jsr getint16
C600  FA                    plx
C601  18                    clc                     ; linnum + 1024 が 2048 未満か
C602  A5 B6                 lda linnum+1
C604  69 04                 adc #4
C606  C9 08                 cmp #8
C608  B0 0B                 bcs gc_fc
C60A  A5 B5                 lda linnum
C60C  9D DB 02              sta gx0,X
C60F  A5 B6                 lda linnum+1
C611  9D DC 02              sta gx0+1,X
C614  60                    rts
                    gc_fc:
C615  4C CA DA              jmp err_fc
                    
                    ; [, モード] を読む(なければ A のまま)
                    get_mode:
C618  8D DF 03              sta grmode
C61B  20 9E A3              jsr chrgot
C61E  C9 2C                 cmp #','
C620  D0 10                 bne gm_1
C622  20 98 A3              jsr chrget
C625  20 40 A9              jsr frmnum
C628  20 C1 D7              jsr getbyte
C62B  C9 03                 cmp #3
C62D  B0 E6                 bcs gc_fc
C62F  8D DF 03              sta grmode
                    gm_1:
C632  60                    rts
                    
                    ; x, y を gx0, gy0 に
                    get_xy:
C633  A2 00                 ldx #0
C635  20 F9 C5              jsr get_coord
C638  20 C6 A3              jsr chkcom
C63B  A2 02                 ldx #gy0-gx0
C63D  4C F9 C5              jmp get_coord
                    
                    st_pset:
C640  20 33 C6              jsr get_xy
C643  A9 01                 lda #1
C645  20 18 C6              jsr get_mode
C648  4C 8B C5              jmp plot
                    
                    st_preset:
C64B  20 33 C6              jsr get_xy
C64E  A9 00                 lda #0
C650  20 18 C6              jsr get_mode
C653  4C 8B C5              jmp plot
                    
                    ; POINT(x, y): 点いていれば 1。
                    ; PSET 10,POINT(20,0) のように座標の式の中で使われるので、外側の gx0, gy0 を戻す
                    fn_point:
C656  A2 03                 ldx #3
                    fpn_1:
C658  BD DB 02              lda gx0,X               ; gx0, gy0 は続いている
C65B  48                    pha
C65C  CA                    dex
C65D  10 F9                 bpl fpn_1
C65F  20 6E C6              jsr fpn_body
C662  A2 00                 ldx #0
                    fpn_2:
C664  68                    pla
C665  9D DB 02              sta gx0,X
C668  E8                    inx
C669  E0 04                 cpx #4
C66B  D0 F7                 bne fpn_2
C66D  60                    rts
                    fpn_body:
C66E  20 CA A3              jsr chkopen
C671  20 33 C6              jsr get_xy
C674  20 CE A3              jsr chkclose
C677  64 9C                 stz valtyp
C679  AD DC 02              lda gx0+1
C67C  D0 21                 bne fp_off
C67E  AD DB 02              lda gx0
C681  C9 60                 cmp #96
C683  B0 1A                 bcs fp_off
C685  AD DE 02              lda gy0+1
C688  D0 15                 bne fp_off
C68A  AD DD 02              lda gy0
C68D  C9 20                 cmp #32
C68F  B0 0E                 bcs fp_off
C691  20 C6 C5              jsr pix_addr
C694  B2 AF                 lda (index1)
C696  25 C0                 and bt0
C698  F0 05                 beq fp_off
C69A  A9 01                 lda #1
C69C  4C EC D6              jmp fac_u8
                    fp_off:
C69F  4C A5 D3              jmp fac_zero
                    
                    ; LINE x1, y1, x2, y2 [, モード]
                    st_line:
C6A2  20 33 C6              jsr get_xy
C6A5  20 C6 A3              jsr chkcom
C6A8  A2 04                 ldx #gx1-gx0
C6AA  20 F9 C5              jsr get_coord
C6AD  20 C6 A3              jsr chkcom
C6B0  A2 06                 ldx #gy1-gx0
C6B2  20 F9 C5              jsr get_coord
C6B5  A9 01                 lda #1
C6B7  20 18 C6              jsr get_mode
                            ; dx = |x1 - x0|、sx = 符号
C6BA  A2 00                 ldx #0
C6BC  20 89 C7              jsr ln_delta            ; gdx, gsx
C6BF  A2 02                 ldx #gy0-gx0
C6C1  20 89 C7              jsr ln_delta            ; gdy, gsy(gdx の2バイト後ろ)
C6C4  38                    sec                     ; dy = -|y1 - y0|
C6C5  A9 00                 lda #0
C6C7  ED E5 02              sbc gdy
C6CA  8D E5 02              sta gdy
C6CD  A9 00                 lda #0
C6CF  ED E6 02              sbc gdy+1
C6D2  8D E6 02              sta gdy+1
C6D5  18                    clc                     ; err = dx + dy
C6D6  AD E3 02              lda gdx
C6D9  6D E5 02              adc gdy
C6DC  8D E9 02              sta gerr
C6DF  AD E4 02              lda gdx+1
C6E2  6D E6 02              adc gdy+1
C6E5  8D EA 02              sta gerr+1
                    ln_loop:
C6E8  20 8B C5              jsr plot
C6EB  AD BD 03              lda brkflag
C6EE  D0 7F                 bne ln_done
C6F0  AD DB 02              lda gx0                 ; 終わりの点か
C6F3  CD DF 02              cmp gx1
C6F6  D0 18                 bne ln_1
C6F8  AD DC 02              lda gx0+1
C6FB  CD E0 02              cmp gx1+1
C6FE  D0 10                 bne ln_1
C700  AD DD 02              lda gy0
C703  CD E1 02              cmp gy1
C706  D0 08                 bne ln_1
C708  AD DE 02              lda gy0+1
C70B  CD E2 02              cmp gy1+1
C70E  F0 5F                 beq ln_done
                    ln_1:
C710  AD E9 02              lda gerr                ; e2 = 2 × err
C713  0A                    asl
C714  85 C2                 sta bt2
C716  AD EA 02              lda gerr+1
C719  2A                    rol
C71A  85 C3                 sta bt3
                            ; e2 >= dy なら err += dy、x += sx
C71C  38                    sec
C71D  A5 C2                 lda bt2
C71F  ED E5 02              sbc gdy
C722  A5 C3                 lda bt3
C724  ED E6 02              sbc gdy+1
C727  30 1B                 bmi ln_2
C729  18                    clc
C72A  AD E9 02              lda gerr
C72D  6D E5 02              adc gdy
C730  8D E9 02              sta gerr
C733  AD EA 02              lda gerr+1
C736  6D E6 02              adc gdy+1
C739  8D EA 02              sta gerr+1
C73C  A2 00                 ldx #0
C73E  AD E7 02              lda gsx
C741  20 70 C7              jsr ln_step
                    ln_2:
                            ; e2 <= dx なら err += dx、y += sy
C744  38                    sec
C745  AD E3 02              lda gdx
C748  E5 C2                 sbc bt2
C74A  AD E4 02              lda gdx+1
C74D  E5 C3                 sbc bt3
C74F  30 97                 bmi ln_loop
C751  18                    clc
C752  AD E9 02              lda gerr
C755  6D E3 02              adc gdx
C758  8D E9 02              sta gerr
C75B  AD EA 02              lda gerr+1
C75E  6D E4 02              adc gdx+1
C761  8D EA 02              sta gerr+1
C764  A2 02                 ldx #gy0-gx0
C766  AD E8 02              lda gsy
C769  20 70 C7              jsr ln_step
C76C  4C E8 C6              jmp ln_loop
                    ln_done:
C76F  60                    rts
                    
                    ; 座標(gx0 から X バイト目)に A(1 か $FF)を足す
                    ln_step:
C770  C9 01                 cmp #1
C772  F0 0C                 beq lsp_inc
C774  BD DB 02              lda gx0,X
C777  D0 03                 bne lsp_1
C779  DE DC 02              dec gx0+1,X
                    lsp_1:
C77C  DE DB 02              dec gx0,X
C77F  60                    rts
                    lsp_inc:
C780  FE DB 02              inc gx0,X
C783  D0 03                 bne lsp_2
C785  FE DC 02              inc gx0+1,X
                    lsp_2:
C788  60                    rts
                    
                    ; X=0 なら x、X=gy0-gx0 なら y について、差の絶対値を gdx+X に、符号を gsx+X/2 に
                    ln_delta:
C789  38                    sec
C78A  BD DF 02              lda gx1,X
C78D  FD DB 02              sbc gx0,X
C790  9D E3 02              sta gdx,X
C793  BD E0 02              lda gx1+1,X
C796  FD DC 02              sbc gx0+1,X
C799  9D E4 02              sta gdx+1,X
C79C  30 04                 bmi ld_neg
C79E  A9 01                 lda #1
C7A0  80 13                 bra ld_1
                    ld_neg:
C7A2  38                    sec
C7A3  A9 00                 lda #0
C7A5  FD E3 02              sbc gdx,X
C7A8  9D E3 02              sta gdx,X
C7AB  A9 00                 lda #0
C7AD  FD E4 02              sbc gdx+1,X
C7B0  9D E4 02              sta gdx+1,X
C7B3  A9 FF                 lda #$FF
                    ld_1:
C7B5  E0 00                 cpx #0
C7B7  D0 04                 bne ld_2
C7B9  8D E7 02              sta gsx
C7BC  60                    rts
                    ld_2:
C7BD  8D E8 02              sta gsy
C7C0  60                    rts
                    
                    ; CIRCLE x, y, r [, モード]
                    st_circle:
C7C1  20 33 C6              jsr get_xy
C7C4  20 C6 A3              jsr chkcom
C7C7  A2 04                 ldx #gx1-gx0
C7C9  20 F9 C5              jsr get_coord           ; r
C7CC  AD E0 02              lda gx1+1
C7CF  10 03                 bpl cir_1
C7D1  4C CA DA              jmp err_fc
                    cir_1:
C7D4  A9 01                 lda #1
C7D6  20 18 C6              jsr get_mode
C7D9  AD DB 02              lda gx0                 ; 中心を gdx, gdy に
C7DC  8D E3 02              sta gdx
C7DF  AD DC 02              lda gx0+1
C7E2  8D E4 02              sta gdx+1
C7E5  AD DD 02              lda gy0
C7E8  8D E5 02              sta gdy
C7EB  AD DE 02              lda gy0+1
C7EE  8D E6 02              sta gdy+1
C7F1  9C E1 02              stz gy1                 ; x = r(gx1)、y = 0(gy1)
C7F4  9C E2 02              stz gy1+1
C7F7  38                    sec                     ; err = 1 - r
C7F8  A9 01                 lda #1
C7FA  ED DF 02              sbc gx1
C7FD  8D E9 02              sta gerr
C800  A9 00                 lda #0
C802  ED E0 02              sbc gx1+1
C805  8D EA 02              sta gerr+1
                    ci_loop:
C808  AD BD 03              lda brkflag
C80B  D0 79                 bne ci_done
C80D  38                    sec                     ; x >= y の間
C80E  AD DF 02              lda gx1
C811  ED E1 02              sbc gy1
C814  AD E0 02              lda gx1+1
C817  ED E2 02              sbc gy1+1
C81A  30 6A                 bmi ci_done
C81C  A2 07                 ldx #7                  ; 8つの点
                    ci_8:
C81E  DA                    phx
C81F  8A                    txa
C820  20 87 C8              jsr cplot
C823  FA                    plx
C824  CA                    dex
C825  10 F7                 bpl ci_8
C827  EE E1 02              inc gy1                 ; y = y + 1
C82A  D0 03                 bne ci_2
C82C  EE E2 02              inc gy1+1
                    ci_2:
C82F  AD EA 02              lda gerr+1
C832  10 1F                 bpl ci_pos
                            ; err += 2y + 1
C834  AD E1 02              lda gy1
C837  0A                    asl
C838  85 C0                 sta bt0
C83A  AD E2 02              lda gy1+1
C83D  2A                    rol
C83E  85 C1                 sta bt1
C840  38                    sec
C841  AD E9 02              lda gerr
C844  65 C0                 adc bt0
C846  8D E9 02              sta gerr
C849  AD EA 02              lda gerr+1
C84C  65 C1                 adc bt1
C84E  8D EA 02              sta gerr+1
C851  80 B5                 bra ci_loop
                    ci_pos:
C853  AD DF 02              lda gx1                 ; x = x - 1
C856  D0 03                 bne ci_3
C858  CE E0 02              dec gx1+1
                    ci_3:
C85B  CE DF 02              dec gx1
C85E  38                    sec                     ; err += 2(y - x) + 1
C85F  AD E1 02              lda gy1
C862  ED DF 02              sbc gx1
C865  85 C0                 sta bt0
C867  AD E2 02              lda gy1+1
C86A  ED E0 02              sbc gx1+1
C86D  85 C1                 sta bt1
C86F  06 C0                 asl bt0
C871  26 C1                 rol bt1
C873  38                    sec
C874  AD E9 02              lda gerr
C877  65 C0                 adc bt0
C879  8D E9 02              sta gerr
C87C  AD EA 02              lda gerr+1
C87F  65 C1                 adc bt1
C881  8D EA 02              sta gerr+1
C884  80 82                 bra ci_loop
                    ci_done:
C886  60                    rts
                    
                    ; 円の1点を描く。A の bit0: x と y を入れ替える、bit1: 横を負に、bit2: 縦を負に。
                    ; 8つの点のうち同じ座標になるもの(x = y のときの入れ替え、横か縦が0のときの負)は描かない。
                    ; 反転(モード2)で同じ点を2回反転すると消えてしまうため
                    cplot:
C887  85 C4                 sta bt4
C889  4A                    lsr
C88A  B0 16                 bcs cp_sw0
C88C  AD DF 02              lda gx1                 ; 横 = x、縦 = y
C88F  85 C0                 sta bt0
C891  AD E0 02              lda gx1+1
C894  85 C1                 sta bt1
C896  AD E1 02              lda gy1
C899  85 C2                 sta bt2
C89B  AD E2 02              lda gy1+1
C89E  85 C3                 sta bt3
C8A0  80 24                 bra cp_1
                    cp_sw0:
C8A2  AD DF 02              lda gx1                 ; x = y なら入れ替えた点は同じ
C8A5  CD E1 02              cmp gy1
C8A8  D0 08                 bne cp_sw
C8AA  AD E0 02              lda gx1+1
C8AD  CD E2 02              cmp gy1+1
C8B0  F0 2C                 beq cp_skip
                    cp_sw:
C8B2  AD E1 02              lda gy1
C8B5  85 C0                 sta bt0
C8B7  AD E2 02              lda gy1+1
C8BA  85 C1                 sta bt1
C8BC  AD DF 02              lda gx1
C8BF  85 C2                 sta bt2
C8C1  AD E0 02              lda gx1+1
C8C4  85 C3                 sta bt3
                    cp_1:
C8C6  A5 C4                 lda bt4                 ; 横が0なら、横を負にした点は同じ
C8C8  29 02                 and #2
C8CA  F0 06                 beq cp_1a
C8CC  A5 C0                 lda bt0
C8CE  05 C1                 ora bt1
C8D0  F0 0C                 beq cp_skip
                    cp_1a:
C8D2  A5 C4                 lda bt4                 ; 縦が0なら、縦を負にした点は同じ
C8D4  29 04                 and #4
C8D6  F0 07                 beq cp_1b
C8D8  A5 C2                 lda bt2
C8DA  05 C3                 ora bt3
C8DC  D0 01                 bne cp_1b
                    cp_skip:
C8DE  60                    rts
                    cp_1b:
C8DF  A5 C4                 lda bt4
C8E1  29 02                 and #2
C8E3  D0 13                 bne cp_xn
C8E5  18                    clc
C8E6  AD E3 02              lda gdx
C8E9  65 C0                 adc bt0
C8EB  8D DB 02              sta gx0
C8EE  AD E4 02              lda gdx+1
C8F1  65 C1                 adc bt1
C8F3  8D DC 02              sta gx0+1
C8F6  80 11                 bra cp_2
                    cp_xn:
C8F8  38                    sec
C8F9  AD E3 02              lda gdx
C8FC  E5 C0                 sbc bt0
C8FE  8D DB 02              sta gx0
C901  AD E4 02              lda gdx+1
C904  E5 C1                 sbc bt1
C906  8D DC 02              sta gx0+1
                    cp_2:
C909  A5 C4                 lda bt4
C90B  29 04                 and #4
C90D  D0 14                 bne cp_yn
C90F  18                    clc
C910  AD E5 02              lda gdy
C913  65 C2                 adc bt2
C915  8D DD 02              sta gy0
C918  AD E6 02              lda gdy+1
C91B  65 C3                 adc bt3
C91D  8D DE 02              sta gy0+1
C920  4C 8B C5              jmp plot
                    cp_yn:
C923  38                    sec
C924  AD E5 02              lda gdy
C927  E5 C2                 sbc bt2
C929  8D DD 02              sta gy0
C92C  AD E6 02              lda gdy+1
C92F  E5 C3                 sbc bt3
C931  8D DE 02              sta gy0+1
C934  4C 8B C5              jmp plot
                    
                    ; ===================================================================
                    ; 音
                    ; ===================================================================
                    
                    ; BEEP [周波数(Hz) [, 長さ(1/100秒)]]。省くと 1000Hz、0.1秒
                    st_beep:
C937  A9 E8                 lda #<1000
C939  A0 03                 ldy #>1000
C93B  20 D9 D6              jsr fac_u16
C93E  20 9E A3              jsr chrgot
C941  F0 03                 beq bp_1
C943  20 40 A9              jsr frmnum
                    bp_1:
C946  A9 CB                 lda #<fpt6              ; f
C948  A0 02                 ldy #>fpt6
C94A  20 45 D3              jsr fac_st
C94D  20 78 D7              jsr getint16            ; 20 から 20000 まで
C950  A5 B6                 lda linnum+1
C952  10 03                 bpl *+5
C954  4C 22 CA              jmp bp_fc
C957  C9 4E                 cmp #>20001
C959  90 0E                 bcc bp_2
C95B  F0 03                 beq *+5
C95D  4C 22 CA              jmp bp_fc
C960  A5 B5                 lda linnum
C962  C9 21                 cmp #<20001
C964  90 03                 bcc *+5
C966  4C 22 CA              jmp bp_fc
                    bp_2:
C969  A5 B6                 lda linnum+1
C96B  D0 09                 bne bp_3
C96D  A5 B5                 lda linnum
C96F  C9 14                 cmp #20
C971  B0 03                 bcs *+5
C973  4C 22 CA              jmp bp_fc
                    bp_3:
C976  A9 0A                 lda #10                 ; d
C978  A0 00                 ldy #0
C97A  20 D9 D6              jsr fac_u16
C97D  20 9E A3              jsr chrgot
C980  C9 2C                 cmp #','
C982  D0 0D                 bne bp_4
C984  20 98 A3              jsr chrget
C987  20 40 A9              jsr frmnum
C98A  A5 85                 lda fac_s
C98C  10 03                 bpl *+5
C98E  4C 22 CA              jmp bp_fc
                    bp_4:
                            ; 半周期の数 = f × d / 50
C991  A9 CB                 lda #<fpt6
C993  A0 02                 ldy #>fpt6
C995  20 1C D3              jsr arg_ld
C998  20 0D D5              jsr fmul
C99B  A9 6F                 lda #<c_50
C99D  A0 DB                 ldy #>c_50
C99F  20 1C D3              jsr arg_ld
C9A2  20 97 D3              jsr swap_fa
C9A5  20 C6 D5              jsr fdiv
C9A8  20 78 D7              jsr getint16
C9AB  A5 B5                 lda linnum
C9AD  8D ED 02              sta bp_cnt
C9B0  A5 B6                 lda linnum+1
C9B2  8D EE 02              sta bp_cnt+1
                            ; 半周期の待ちの回数 = 34786 / f - 6.29(beep_wait の1回が14サイクル)
C9B5  A9 74                 lda #<c_beepk
C9B7  A0 DB                 ldy #>c_beepk
C9B9  20 1C D3              jsr arg_ld
C9BC  A9 CB                 lda #<fpt6
C9BE  A0 02                 ldy #>fpt6
C9C0  20 F3 D2              jsr fac_ld
C9C3  20 C6 D5              jsr fdiv
C9C6  A9 79                 lda #<c_beepofs
C9C8  A0 DB                 ldy #>c_beepofs
C9CA  20 06 CC              jsr addc
C9CD  A5 85                 lda fac_s
C9CF  10 03                 bpl bp_5
C9D1  20 A5 D3              jsr fac_zero
                    bp_5:
C9D4  20 78 D7              jsr getint16
C9D7  A5 B5                 lda linnum
C9D9  05 B6                 ora linnum+1
C9DB  D0 02                 bne bp_6
C9DD  E6 B5                 inc linnum
                    bp_6:
C9DF  A5 B5                 lda linnum
C9E1  8D EB 02              sta bp_half
C9E4  A5 B6                 lda linnum+1
C9E6  8D EC 02              sta bp_half+1
C9E9  9C EF 02              stz bp_lvl
                    bp_loop:
C9EC  AD ED 02              lda bp_cnt
C9EF  0D EE 02              ora bp_cnt+1
C9F2  F0 2A                 beq bp_end
C9F4  AD BD 03              lda brkflag
C9F7  D0 25                 bne bp_end
C9F9  AD EF 02              lda bp_lvl
C9FC  49 01                 eor #1
C9FE  8D EF 02              sta bp_lvl
CA01  8D 20 80              sta BEEP
CA04  AD EB 02              lda bp_half             ; 待つ
CA07  85 C0                 sta bt0
CA09  AD EC 02              lda bp_half+1
CA0C  85 C1                 sta bt1
CA0E  20 0B A0              jsr beep_wait
CA11  AD ED 02              lda bp_cnt
CA14  D0 03                 bne bp_w4
CA16  CE EE 02              dec bp_cnt+1
                    bp_w4:
CA19  CE ED 02              dec bp_cnt
CA1C  80 CE                 bra bp_loop
                    bp_end:
CA1E  9C 20 80              stz BEEP
CA21  60                    rts
                    bp_fc:
CA22  4C CA DA              jmp err_fc
                    
                    ; ===================================================================
                    ; テープ
                    ; ===================================================================
                    
                    ; [文字列] を tname(8文字、足りない分は空白)に。名前があれば bt5 = 1
                    get_tname:
CA25  A2 07                 ldx #7
CA27  A9 20                 lda #' '
                    gtn_1:
CA29  9D F0 02              sta tname,X
CA2C  CA                    dex
CA2D  10 FA                 bpl gtn_1
CA2F  64 C5                 stz bt5
CA31  20 9E A3              jsr chrgot
CA34  F0 20                 beq gtn_done
CA36  20 48 A9              jsr frmstr
CA39  20 07 B1              jsr fac_str
CA3C  48                    pha
CA3D  20 DF B0              jsr free_fac
CA40  68                    pla
CA41  C9 09                 cmp #9
CA43  90 02                 bcc gtn_2
CA45  A9 08                 lda #8
                    gtn_2:
CA47  A8                    tay
CA48  F0 0A                 beq gtn_3
                    gtn_c:
CA4A  88                    dey
CA4B  B1 D2                 lda (strp),Y
CA4D  99 F0 02              sta tname,Y
CA50  C0 00                 cpy #0
CA52  D0 F6                 bne gtn_c
                    gtn_3:
CA54  E6 C5                 inc bt5
                    gtn_done:
CA56  60                    rts
                    
                    ; SAVE ["名前"]
                    st_save:
CA57  20 25 CA              jsr get_tname
CA5A  A2 07                 ldx #7
                    ssv_1:
CA5C  BD F0 02              lda tname,X
CA5F  9D A1 02              sta T_NAME,X
CA62  CA                    dex
CA63  10 F7                 bpl ssv_1
CA65  A9 02                 lda #TT_BASIC
CA67  8D A0 02              sta T_TYPE
CA6A  A9 00                 lda #<PRGSTART
CA6C  8D A9 02              sta T_START
CA6F  A9 08                 lda #>PRGSTART
CA71  8D AA 02              sta T_START+1
CA74  38                    sec
CA75  A5 A1                 lda vartab
CA77  E9 00                 sbc #<PRGSTART
CA79  8D AB 02              sta T_LEN
CA7C  A5 A2                 lda vartab+1
CA7E  E9 08                 sbc #>PRGSTART
CA80  8D AC 02              sta T_LEN+1
CA83  A9 01                 lda #ANN_BUSY
CA85  0C 02 80              tsb LCD_ANN
CA88  20 24 FF              jsr BIOS_TSAVE
CA8B  08                    php
CA8C  A9 01                 lda #ANN_BUSY
CA8E  1C 02 80              trb LCD_ANN
CA91  28                    plp
CA92  90 05                 bcc ssv_2
CA94  A2 11                 ldx #EN_TF              ; テープがいっぱい(テープは保存前のまま)
CA96  4C 8E A8              jmp b_error
                    ssv_2:
CA99  60                    rts
                    
                    ; LOAD ["名前"]
                    ;   名前を省くと最初のプログラム。同じ名前のプログラムがいくつかあれば、最後(最新)のものを読む
                    st_load:
CA9A  20 25 CA              jsr get_tname
CA9D  A9 01                 lda #ANN_BUSY
CA9F  0C 02 80              tsb LCD_ANN
CAA2  64 C6                 stz bt6                 ; bt6/bt7 = 名前の合うプログラムの数
CAA4  64 C7                 stz bt7
CAA6  A5 C5                 lda bt5
CAA8  F0 1D                 beq sld_find            ; 名前を省いたら最初のプログラム
                            ; 1回目: 名前の合うプログラムを数える
CAAA  A9 00                 lda #0
CAAC  20 27 FF              jsr BIOS_TFIND
CAAF  B0 78                 bcs sld_err
                    sld_cnt:
CAB1  20 B8 CB              jsr sld_match
CAB4  D0 06                 bne sld_cn
CAB6  E6 C6                 inc bt6
CAB8  D0 02                 bne sld_cn
CABA  E6 C7                 inc bt7
                    sld_cn:
CABC  A9 01                 lda #1
CABE  20 27 FF              jsr BIOS_TFIND
CAC1  90 EE                 bcc sld_cnt
CAC3  C9 03                 cmp #TE_BAD
CAC5  F0 6E                 beq sld_tp
                            ; 2回目: bt6/bt7 番目(最後)のものを探す
                    sld_find:
CAC7  A9 00                 lda #0
CAC9  20 27 FF              jsr BIOS_TFIND
CACC  B0 5B                 bcs sld_err
                    sld_chk:
CACE  20 B8 CB              jsr sld_match
CAD1  D0 4F                 bne sld_next
CAD3  A5 C6                 lda bt6                 ; 名前を省いたとき(0)は最初のもの
CAD5  05 C7                 ora bt7
CAD7  F0 0E                 beq sld_found
CAD9  A5 C6                 lda bt6
CADB  D0 02                 bne sld_dec
CADD  C6 C7                 dec bt7
                    sld_dec:
CADF  C6 C6                 dec bt6
CAE1  A5 C6                 lda bt6
CAE3  05 C7                 ora bt7
CAE5  D0 3B                 bne sld_next
                    sld_found:
CAE7  18                    clc                     ; 入るか: PRGSTART + 長さ + 256 <= MEMSIZ
CAE8  AD AC 02              lda T_LEN+1
CAEB  69 09                 adc #>PRGSTART+1
CAED  B0 4B                 bcs sld_om
CAEF  C9 80                 cmp #>MEMSIZ
CAF1  B0 47                 bcs sld_om
CAF3  A9 00                 lda #<PRGSTART
CAF5  8D A9 02              sta T_START
CAF8  A9 08                 lda #>PRGSTART
CAFA  8D AA 02              sta T_START+1
CAFD  20 2A FF              jsr BIOS_TLOAD
CB00  B0 30                 bcs sld_bad
CB02  18                    clc
CB03  A9 00                 lda #<PRGSTART
CB05  6D AB 02              adc T_LEN
CB08  85 A1                 sta vartab
CB0A  A9 08                 lda #>PRGSTART
CB0C  6D AC 02              adc T_LEN+1
CB0F  85 A2                 sta vartab+1
CB11  20 DC A6              jsr fix_program
CB14  20 1C A6              jsr relink
CB17  20 C3 A6              jsr clearc
CB1A  A9 01                 lda #ANN_BUSY
CB1C  1C 02 80              trb LCD_ANN
CB1F  4C 83 A2              jmp ready
                    sld_next:
CB22  A9 01                 lda #1
CB24  20 27 FF              jsr BIOS_TFIND
CB27  90 A5                 bcc sld_chk
                    sld_err:
CB29  C9 03                 cmp #TE_BAD
CB2B  F0 08                 beq sld_tp
CB2D  A2 0F                 ldx #EN_NT
CB2F  4C 8E A8              jmp b_error
                    sld_bad:
CB32  20 AD A6              jsr b_new_mem           ; 途中まで読んだプログラムは使えない
                    sld_tp:
CB35  A2 10                 ldx #EN_TP
CB37  4C 8E A8              jmp b_error
                    sld_om:
CB3A  9C 31 80              stz TAPE_CTRL
CB3D  4C E8 A8              jmp err_om
                    
                    ; FILES: テープの中身の一覧
                    st_files:
CB40  64 DF                 stz listrow
CB42  A9 02                 lda #2
CB44  8D BE 03              sta bstate
CB47  A9 00                 lda #0
CB49  20 27 FF              jsr BIOS_TFIND
CB4C  90 09                 bcc sfl_1
CB4E  C9 03                 cmp #TE_BAD
CB50  F0 E3                 beq sld_tp
CB52  A2 0F                 ldx #EN_NT
CB54  4C 8E A8              jmp b_error
                    sfl_1:
CB57  A5 DF                 lda listrow
CB59  C9 03                 cmp #3
CB5B  90 11                 bcc sfl_2
CB5D  20 03 FF              jsr BIOS_GETKEY
CB60  C9 0D                 cmp #K_RET
CB62  F0 08                 beq sfl_k
CB64  C9 14                 cmp #K_DOWN
CB66  F0 04                 beq sfl_k
CB68  C9 20                 cmp #' '
CB6A  D0 43                 bne sfl_end
                    sfl_k:
CB6C  64 DF                 stz listrow
                    sfl_2:
CB6E  20 8E A3              jsr crlf_if
CB71  AD A0 02              lda T_TYPE              ; B: BASIC、M: メモリ
CB74  A2 42                 ldx #'B'
CB76  C9 02                 cmp #TT_BASIC
CB78  F0 08                 beq sfl_3
CB7A  A2 4D                 ldx #'M'
CB7C  C9 01                 cmp #TT_MEM
CB7E  F0 02                 beq sfl_3
CB80  A2 3F                 ldx #'?'
                    sfl_3:
CB82  8A                    txa
CB83  20 00 FF              jsr BIOS_CHROUT
CB86  20 7E BA              jsr out_space
CB89  A2 00                 ldx #0
                    sfl_4:
CB8B  BD A1 02              lda T_NAME,X
CB8E  20 00 FF              jsr BIOS_CHROUT
CB91  E8                    inx
CB92  E0 08                 cpx #8
CB94  D0 F5                 bne sfl_4
CB96  20 7E BA              jsr out_space
CB99  AD AB 02              lda T_LEN
CB9C  AC AC 02              ldy T_LEN+1
CB9F  20 2A A9              jsr linprt
CBA2  E6 DF                 inc listrow
CBA4  A9 01                 lda #1
CBA6  20 27 FF              jsr BIOS_TFIND
CBA9  90 AC                 bcc sfl_1
CBAB  C9 03                 cmp #TE_BAD
CBAD  F0 86                 beq sld_tp
                    sfl_end:
CBAF  9C 31 80              stz TAPE_CTRL
CBB2  A9 01                 lda #1
CBB4  8D BE 03              sta bstate
CBB7  60                    rts
                    
                    ; T_* が LOAD で読むプログラムなら Z=1(BASIC のブロックで、名前を省いたか名前が合う)
                    sld_match:
CBB8  AD A0 02              lda T_TYPE
CBBB  C9 02                 cmp #TT_BASIC
CBBD  D0 13                 bne slm_done
CBBF  A5 C5                 lda bt5
CBC1  F0 0F                 beq slm_done
CBC3  A2 07                 ldx #7
                    slm_1:
CBC5  BD A1 02              lda T_NAME,X
CBC8  DD F0 02              cmp tname,X
CBCB  D0 05                 bne slm_done
CBCD  CA                    dex
CBCE  10 F5                 bpl slm_1
CBD0  A9 00                 lda #0
                    slm_done:
CBD2  60                    rts
                    
                    ; PX-65 BASIC: 数学関数
                    ;
                    ; 係数は basic_const.s(tools/mkfpconst.js)にある。
                    
                    ; FAC を fpt に置く / fpt から読む(A/Y を使う短い呼び方)
                    st3:
CBD3  A9 CC                 lda #<fpt3
CBD5  A0 03                 ldy #>fpt3
CBD7  4C 45 D3              jmp fac_st
                    ld3:
CBDA  A9 CC                 lda #<fpt3
CBDC  A0 03                 ldy #>fpt3
CBDE  4C F3 D2              jmp fac_ld
                    arg3:
CBE1  A9 CC                 lda #<fpt3
CBE3  A0 03                 ldy #>fpt3
CBE5  4C 1C D3              jmp arg_ld
                    st4:
CBE8  A9 D1                 lda #<fpt4
CBEA  A0 03                 ldy #>fpt4
CBEC  4C 45 D3              jmp fac_st
                    ld4:
CBEF  A9 D1                 lda #<fpt4
CBF1  A0 03                 ldy #>fpt4
CBF3  4C F3 D2              jmp fac_ld
                    arg4:
CBF6  A9 D1                 lda #<fpt4
CBF8  A0 03                 ldy #>fpt4
CBFA  4C 1C D3              jmp arg_ld
                    argc:                           ; ARG = 定数(A/Y)
CBFD  4C 1C D3              jmp arg_ld
                    
                    ; FAC = FAC × 定数(A/Y)
                    mulc:
CC00  20 1C D3              jsr arg_ld
CC03  4C 0D D5              jmp fmul
                    
                    ; FAC = FAC + 定数(A/Y)
                    addc:
CC06  20 1C D3              jsr arg_ld
CC09  4C 3C D4              jmp fadd
                    
                    ; ===================================================================
                    ; 多項式: FAC = c0 x^n + c1 x^(n-1) + … + cn(A/Y = 係数の表。先頭は個数)
                    ; ===================================================================
                    poly:
CC0C  8D DA 03              sta poly_p
CC0F  8C DB 03              sty poly_p+1
CC12  A9 C6                 lda #<fpt5              ; x を置く
CC14  A0 02                 ldy #>fpt5
CC16  20 45 D3              jsr fac_st
CC19  AD DA 03              lda poly_p              ; 係数の数
CC1C  85 C8                 sta fptr
CC1E  AD DB 03              lda poly_p+1
CC21  85 C9                 sta fptr+1
CC23  B2 C8                 lda (fptr)
CC25  8D D9 03              sta poly_n
CC28  20 49 CC              jsr poly_next
CC2B  20 F3 D2              jsr fac_ld              ; 最初の係数
                    pl_1:
CC2E  CE D9 03              dec poly_n
CC31  F0 15                 beq pl_done
CC33  A9 C6                 lda #<fpt5              ; FAC = FAC × x + 次の係数
CC35  A0 02                 ldy #>fpt5
CC37  20 1C D3              jsr arg_ld
CC3A  20 0D D5              jsr fmul
CC3D  20 49 CC              jsr poly_next
CC40  20 1C D3              jsr arg_ld
CC43  20 3C D4              jsr fadd
CC46  80 E6                 bra pl_1
                    pl_done:
CC48  60                    rts
                    ; poly_p を次の係数へ進め、その番地を A/Y に
                    poly_next:
CC49  18                    clc
CC4A  AD DA 03              lda poly_p
CC4D  69 01                 adc #1
CC4F  8D DA 03              sta poly_p
CC52  90 03                 bcc pn_a
CC54  EE DB 03              inc poly_p+1
                    pn_a:
CC57  AD DA 03              lda poly_p
CC5A  AC DB 03              ldy poly_p+1
CC5D  48                    pha                     ; 次のためにさらに4バイト進めておく
CC5E  18                    clc
CC5F  69 04                 adc #4
CC61  8D DA 03              sta poly_p
CC64  90 03                 bcc pn_b
CC66  EE DB 03              inc poly_p+1
                    pn_b:
CC69  68                    pla
CC6A  60                    rts
                    
                    ; ===================================================================
                    ; SQR
                    ; ===================================================================
                    fn_sqr:
CC6B  20 61 B0              jsr par_num
                    fsqr:
CC6E  A5 80                 lda fac_e
CC70  F0 3C                 beq fq_done             ; 0
CC72  A5 85                 lda fac_s
CC74  10 03                 bpl fq_1
CC76  4C CA DA              jmp err_fc
                    fq_1:
CC79  20 D3 CB              jsr st3                 ; x
CC7C  A5 80                 lda fac_e               ; 最初の見当: 指数を半分に
CC7E  38                    sec
CC7F  E9 80                 sbc #128
CC81  C9 80                 cmp #$80
CC83  6A                    ror
CC84  18                    clc
CC85  69 80                 adc #128
CC87  85 80                 sta fac_e
CC89  20 E8 CB              jsr st4                 ; g
CC8C  A9 05                 lda #5
CC8E  8D D9 03              sta poly_n
                    fq_2:
CC91  20 E1 CB              jsr arg3                ; g = (g + x / g) / 2
CC94  20 EF CB              jsr ld4
CC97  20 C6 D5              jsr fdiv
CC9A  20 F6 CB              jsr arg4
CC9D  20 3C D4              jsr fadd
CCA0  A5 80                 lda fac_e
CCA2  F0 02                 beq fq_3
CCA4  C6 80                 dec fac_e
                    fq_3:
CCA6  20 E8 CB              jsr st4
CCA9  CE D9 03              dec poly_n
CCAC  D0 E3                 bne fq_2
                    fq_done:
CCAE  60                    rts
                    
                    ; ===================================================================
                    ; EXP, LN, LOG
                    ; ===================================================================
                    fn_exp:
CCAF  20 61 B0              jsr par_num
                    fexp:
CCB2  A5 85                 lda fac_s               ; |x| > 89 なら、正はオーバーフロー、負は 0(大まかな判定)
CCB4  48                    pha
CCB5  64 85                 stz fac_s
CCB7  A9 65                 lda #<c_89
CCB9  A0 DB                 ldy #>c_89
CCBB  20 1C D3              jsr arg_ld
CCBE  20 93 D6              jsr fcmp
CCC1  AA                    tax
CCC2  68                    pla
CCC3  85 85                 sta fac_s
CCC5  E0 FF                 cpx #$FF
CCC7  D0 0A                 bne fe_ok
CCC9  A5 85                 lda fac_s
CCCB  30 03                 bmi fe_zero
CCCD  4C C0 DA              jmp err_ov
                    fe_zero:
CCD0  4C A5 D3              jmp fac_zero
                    fe_ok:
CCD3  20 D3 CB              jsr st3                 ; x
CCD6  A9 29                 lda #<c_inv_ln2         ; n = INT(x / ln2)
CCD8  A0 DB                 ldy #>c_inv_ln2
CCDA  20 00 CC              jsr mulc
CCDD  20 45 D7              jsr fac_int
CCE0  20 E8 CB              jsr st4
CCE3  20 78 D7              jsr getint16            ; n(-129 から 128)
CCE6  A5 B6                 lda linnum+1            ; 指数に足せるのは -128 から 127。
CCE8  D0 07                 bne fe_nm               ; n < -128 なら答えは 2^-128 より小さいので 0、n > 127 ならあふれる
CCEA  A5 B5                 lda linnum
CCEC  10 0A                 bpl fe_nok
CCEE  4C C0 DA              jmp err_ov
                    fe_nm:
CCF1  A5 B5                 lda linnum
CCF3  30 03                 bmi fe_nok
CCF5  4C A5 D3              jmp fac_zero
                    fe_nok:
CCF8  A5 B5                 lda linnum
CCFA  8D D5 02              sta exp_n
                            ; r = x - n × ln2。ln2 を上位(n をかけても正確)と下位に分けて精度を保つ
CCFD  20 EF CB              jsr ld4
CD00  A9 1F                 lda #<c_ln2hi
CD02  A0 DB                 ldy #>c_ln2hi
CD04  20 00 CC              jsr mulc
CD07  20 E1 CB              jsr arg3
CD0A  20 39 D4              jsr fsub                ; x - n × ln2(上位)
CD0D  20 D3 CB              jsr st3
CD10  20 EF CB              jsr ld4
CD13  A9 24                 lda #<c_ln2lo
CD15  A0 DB                 ldy #>c_ln2lo
CD17  20 00 CC              jsr mulc
CD1A  20 E1 CB              jsr arg3
CD1D  20 39 D4              jsr fsub                ; - n × ln2(下位)
CD20  A9 A7                 lda #<exp_poly
CD22  A0 DB                 ldy #>exp_poly
CD24  20 0C CC              jsr poly                ; e^r
CD27  A5 80                 lda fac_e               ; 指数に n を足す
CD29  F0 0E                 beq fex_done
CD2B  18                    clc
CD2C  6D D5 02              adc exp_n
CD2F  AA                    tax
CD30  AD D5 02              lda exp_n
CD33  30 05                 bmi fe_neg
CD35  B0 0C                 bcs fe_ov               ; 255 を超えた
CD37  86 80                 stx fac_e
                    fex_done:
CD39  60                    rts
                    fe_neg:
CD3A  90 94                 bcc fe_zero             ; 0 以下になった
CD3C  E0 00                 cpx #0
CD3E  F0 90                 beq fe_zero
CD40  86 80                 stx fac_e
CD42  60                    rts
                    fe_ov:
CD43  4C C0 DA              jmp err_ov
                    
                    fn_ln:
CD46  20 61 B0              jsr par_num
                    fln:
CD49  A5 85                 lda fac_s
CD4B  30 04                 bmi fl_fc
CD4D  A5 80                 lda fac_e
CD4F  D0 03                 bne fln_1
                    fl_fc:
CD51  4C CA DA              jmp err_fc
                    fln_1:
CD54  38                    sec                     ; k = 指数 - 128、m = 0.5 以上 1 未満
CD55  E9 80                 sbc #128
CD57  8D D5 02              sta exp_n
CD5A  A9 80                 lda #128
CD5C  85 80                 sta fac_e
CD5E  A9 33                 lda #<c_sqrthalf        ; m < √0.5 なら m を2倍、k を1減らす
CD60  A0 DB                 ldy #>c_sqrthalf
CD62  20 1C D3              jsr arg_ld
CD65  20 93 D6              jsr fcmp
CD68  C9 01                 cmp #1
CD6A  D0 05                 bne fl_2
CD6C  E6 80                 inc fac_e
CD6E  CE D5 02              dec exp_n
                    fl_2:
CD71  20 D3 CB              jsr st3                 ; m
CD74  A9 D4                 lda #<c_one             ; s = (m - 1) / (m + 1)
CD76  A0 DA                 ldy #>c_one
CD78  20 1C D3              jsr arg_ld
CD7B  20 3C D4              jsr fadd                ; m + 1
CD7E  20 E8 CB              jsr st4
CD81  20 DA CB              jsr ld3
CD84  A9 D9                 lda #<c_mone
CD86  A0 DA                 ldy #>c_mone
CD88  20 06 CC              jsr addc                ; m - 1
CD8B  20 7C D3              jsr fac_to_arg
CD8E  20 EF CB              jsr ld4
CD91  20 C6 D5              jsr fdiv                ; (m - 1) / (m + 1)
CD94  20 D3 CB              jsr st3                 ; s
CD97  20 7C D3              jsr fac_to_arg
CD9A  20 0D D5              jsr fmul                ; s²
CD9D  A9 E4                 lda #<ln_poly
CD9F  A0 DB                 ldy #>ln_poly
CDA1  20 0C CC              jsr poly
CDA4  20 E1 CB              jsr arg3
CDA7  20 0D D5              jsr fmul                ; s × p
CDAA  A5 80                 lda fac_e               ; × 2
CDAC  F0 02                 beq fl_3
CDAE  E6 80                 inc fac_e
                    fl_3:
CDB0  20 E8 CB              jsr st4
CDB3  AD D5 02              lda exp_n               ; + k × ln2
CDB6  A0 00                 ldy #0
CDB8  C9 80                 cmp #$80
CDBA  90 01                 bcc fl_4
CDBC  88                    dey
                    fl_4:
CDBD  20 F0 D6              jsr fac_s16
CDC0  A9 1A                 lda #<c_ln2
CDC2  A0 DB                 ldy #>c_ln2
CDC4  20 00 CC              jsr mulc
CDC7  20 F6 CB              jsr arg4
CDCA  4C 3C D4              jmp fadd
                    
                    fn_log:
CDCD  20 61 B0              jsr par_num
CDD0  20 49 CD              jsr fln
CDD3  A9 2E                 lda #<c_inv_ln10
CDD5  A0 DB                 ldy #>c_inv_ln10
CDD7  4C 00 CC              jmp mulc
                    
                    ; ===================================================================
                    ; SIN, COS, TAN, ATN
                    ; ===================================================================
                    
                    ; 角度の単位が度ならラジアンにする。FAC は 0 以上(trig_abs の後)。
                    ; 度のときは、先に x - 360 × INT(x / 360) で 0〜360 度に直し(360 は有効数字が少ないので、
                    ; 商が 2^26 未満なら掛けても正確。それ以上は FC)、さらに 90 度ずつ引いて 0〜90 度未満の r にする。
                    ; 90 度を引く計算は正確なので、90 度、180 度などはちょうど r = 0 になる(COS(90) が 0、TAN(90) が /0)。
                    ; r が 45 度を超えたら 90 - r(これも正確)にして、90 度の近くで桁が落ちないようにする。
                    ; 戻ると sin_q = 引いた 90 度の数(0〜3)、bit7 = 90 - r にした印。ラジアンなら sin_q = 0。
                    ; fsin に渡す象限は trig_q で求める
                    to_rad:
CDDA  9C D6 02              stz sin_q
CDDD  AD BA 03              lda angmode
CDE0  D0 01                 bne tr_deg
CDE2  60                    rts
                    tr_deg:
CDE3  20 D3 CB              jsr st3                 ; x
CDE6  A9 42                 lda #<c_inv360
CDE8  A0 DB                 ldy #>c_inv360
CDEA  20 00 CC              jsr mulc
CDED  20 45 D7              jsr fac_int             ; n = INT(x / 360)
CDF0  A5 80                 lda fac_e
CDF2  C9 9B                 cmp #128+27
CDF4  B0 6D                 bcs tr_fc
CDF6  A9 3D                 lda #<c_360
CDF8  A0 DB                 ldy #>c_360
CDFA  20 00 CC              jsr mulc
CDFD  20 E1 CB              jsr arg3
CE00  20 39 D4              jsr fsub                ; y = x - 360 × n
                    tr_fix:
CE03  A5 80                 lda fac_e
CE05  F0 30                 beq tr_ok               ; r = 0
CE07  24 85                 bit fac_s
CE09  10 0C                 bpl tr_hi
CE0B  A9 47                 lda #<c_90              ; r < 0(n が1ずれたとき): 90 度を足す
CE0D  A0 DB                 ldy #>c_90
CE0F  20 06 CC              jsr addc
CE12  CE D6 02              dec sin_q
CE15  80 EC                 bra tr_fix
                    tr_hi:
CE17  A9 47                 lda #<c_90
CE19  A0 DB                 ldy #>c_90
CE1B  20 1C D3              jsr arg_ld
CE1E  20 93 D6              jsr fcmp
CE21  C9 01                 cmp #1
CE23  F0 12                 beq tr_ok               ; r < 90
CE25  20 AC D3              jsr fac_neg             ; r - 90 = -(90 - r)
CE28  A9 47                 lda #<c_90
CE2A  A0 DB                 ldy #>c_90
CE2C  20 06 CC              jsr addc
CE2F  20 AC D3              jsr fac_neg
CE32  EE D6 02              inc sin_q
CE35  80 CC                 bra tr_fix
                    tr_ok:
CE37  AD D6 02              lda sin_q
CE3A  29 03                 and #3
CE3C  8D D6 02              sta sin_q
CE3F  A9 4C                 lda #<c_45              ; r > 45 なら 90 - r
CE41  A0 DB                 ldy #>c_45
CE43  20 1C D3              jsr arg_ld
CE46  20 93 D6              jsr fcmp
CE49  C9 FF                 cmp #$FF
CE4B  D0 0F                 bne tr_rad
CE4D  A9 47                 lda #<c_90
CE4F  A0 DB                 ldy #>c_90
CE51  20 1C D3              jsr arg_ld
CE54  20 39 D4              jsr fsub
CE57  A9 80                 lda #$80
CE59  0C D6 02              tsb sin_q
                    tr_rad:
CE5C  A9 38                 lda #<c_deg2rad
CE5E  A0 DB                 ldy #>c_deg2rad
CE60  4C 00 CC              jmp mulc
                    tr_fc:
CE63  4C CA DA              jmp err_fc
                    
                    ; to_rad の後、X = 0(sin)か 1(cos)のときに fsin に渡す象限を A に。
                    ; 角度 = 90 × k + r なら k + X。90 - r にしたとき(角度 = 90 × (k+1) - r)は
                    ; sin(90 × m - r) = sin(r + (2 - m) × 90)(m = k + 1 + X)なので 1 - k - X
                    trig_q:
CE66  8A                    txa
CE67  18                    clc
CE68  6D D6 02              adc sin_q
CE6B  2C D6 02              bit sin_q
CE6E  10 05                 bpl tq_1
CE70  49 FF                 eor #$FF                ; -(k + X) - 1
CE72  18                    clc
CE73  69 02                 adc #2                  ; 1 - k - X
                    tq_1:
CE75  29 03                 and #3
CE77  60                    rts
                    
                    ; 引数の符号を trig_s に取っておき、FAC を絶対値にする。
                    ; 負の小さい角度を 360 度や π/2 の近くへ移すと桁が落ちるので、絶対値で計算して
                    ; SIN と TAN(奇関数)は最後に符号を戻す。COS(偶関数)は戻さない
                    trig_abs:
CE78  A5 85                 lda fac_s
CE7A  8D D7 02              sta trig_s
CE7D  64 85                 stz fac_s
CE7F  60                    rts
                    ; 引数が負なら FAC の符号を変える
                    trig_sign:
CE80  2C D7 02              bit trig_s
CE83  10 03                 bpl tsg_1
CE85  4C AC D3              jmp fac_neg
                    tsg_1:
CE88  60                    rts
                    
                    fn_sin:
CE89  20 61 B0              jsr par_num
CE8C  20 78 CE              jsr trig_abs
CE8F  20 DA CD              jsr to_rad
CE92  A2 00                 ldx #0
CE94  20 66 CE              jsr trig_q
CE97  20 EE CE              jsr fsin
CE9A  80 E4                 bra trig_sign
                    fn_cos:
CE9C  20 61 B0              jsr par_num
CE9F  20 78 CE              jsr trig_abs
CEA2  20 DA CD              jsr to_rad
CEA5  A2 01                 ldx #1                  ; cos(x) = sin(x + π/2)
CEA7  20 66 CE              jsr trig_q
CEAA  4C EE CE              jmp fsin
                    fn_tan:
CEAD  20 61 B0              jsr par_num
CEB0  20 78 CE              jsr trig_abs
CEB3  20 DA CD              jsr to_rad
CEB6  A2 00                 ldx #0                  ; 象限(fsin が sin_q を書き換えるので先に両方求める)
CEB8  20 66 CE              jsr trig_q
CEBB  48                    pha                     ; sin の象限
CEBC  A2 01                 ldx #1
CEBE  20 66 CE              jsr trig_q
CEC1  48                    pha                     ; cos の象限
CEC2  A9 CB                 lda #<fpt6              ; x を取っておく
CEC4  A0 02                 ldy #>fpt6
CEC6  20 45 D3              jsr fac_st
CEC9  68                    pla
CECA  20 EE CE              jsr fsin                ; cos
CECD  A9 D0                 lda #<fpt7
CECF  A0 02                 ldy #>fpt7
CED1  20 45 D3              jsr fac_st
CED4  A9 CB                 lda #<fpt6
CED6  A0 02                 ldy #>fpt6
CED8  20 F3 D2              jsr fac_ld
CEDB  68                    pla
CEDC  20 EE CE              jsr fsin                ; sin
CEDF  20 7C D3              jsr fac_to_arg
CEE2  A9 D0                 lda #<fpt7
CEE4  A0 02                 ldy #>fpt7
CEE6  20 F3 D2              jsr fac_ld
CEE9  20 C6 D5              jsr fdiv                ; sin / cos
CEEC  80 92                 bra trig_sign
                    
                    ; FAC = sin(FAC + A × π/2)(ラジアン)。A=0 で sin、1 で cos
                    ; q = INT(x / (π/2) + 0.5)(いちばん近い π/2 の倍数)、r = x - q × π/2(π/2 を5つに分けて精度を保つ)。
                    ; r は -π/4 から π/4 なので、答えが 0 に近いとき(x が π/2 の倍数の近く)も r が小さくなって桁が落ちない。
                    ; 象限 (q + A) mod 4 で sin(r) か cos(r) = sin(π/2 - |r|) を選び、符号を決める
                    fsin:
CEEE  8D D6 02              sta sin_q
CEF1  20 D3 CB              jsr st3                 ; x
CEF4  A9 F7                 lda #<c_2_pi
CEF6  A0 DA                 ldy #>c_2_pi
CEF8  20 00 CC              jsr mulc
CEFB  A9 CF                 lda #<c_half            ; 四捨五入
CEFD  A0 DA                 ldy #>c_half
CEFF  20 06 CC              jsr addc
CF02  20 45 D7              jsr fac_int             ; q
CF05  A5 80                 lda fac_e               ; q が 2^32 以上(x が約 6.7E9 以上)なら正確に引けないので FC
CF07  C9 A1                 cmp #128+33
CF09  90 03                 bcc fsn_qok
CF0B  4C CA DA              jmp err_fc
                    fsn_qok:
CF0E  20 E8 CB              jsr st4
                            ; q mod 4 = q - 4 × INT(q / 4)(q が大きくても使えるように浮動小数点で)
CF11  A5 80                 lda fac_e
CF13  F0 28                 beq fsn_q0
CF15  38                    sec
CF16  E9 02                 sbc #2
CF18  90 23                 bcc fsn_q0
CF1A  F0 21                 beq fsn_q0
CF1C  85 80                 sta fac_e               ; q / 4
CF1E  20 45 D7              jsr fac_int
CF21  A5 80                 lda fac_e
CF23  F0 05                 beq fsn_qz
CF25  18                    clc
CF26  69 02                 adc #2
CF28  85 80                 sta fac_e               ; 4 × INT(q / 4)
                    fsn_qz:
CF2A  20 7C D3              jsr fac_to_arg
CF2D  20 EF CB              jsr ld4
CF30  20 97 D3              jsr swap_fa
CF33  20 39 D4              jsr fsub                ; q - 4 × INT(q / 4)
CF36  20 78 D7              jsr getint16
CF39  A5 B5                 lda linnum
CF3B  80 08                 bra fsn_q1
                    fsn_q0:
CF3D  20 EF CB              jsr ld4                 ; |q| が小さい
CF40  20 78 D7              jsr getint16
CF43  A5 B5                 lda linnum
                    fsn_q1:
CF45  18                    clc
CF46  6D D6 02              adc sin_q
CF49  29 03                 and #3
CF4B  8D D6 02              sta sin_q
                            ; r = x - q × π/2。π/2 を5つに分けて順に引く(1〜4 は8ビットなので、q が 2^24 未満なら掛けても正確)
CF4E  A9 01                 lda #<c_pio2_1
CF50  A0 DB                 ldy #>c_pio2_1
CF52  20 EF CF              jsr fsn_sub
CF55  A9 06                 lda #<c_pio2_2
CF57  A0 DB                 ldy #>c_pio2_2
CF59  20 EF CF              jsr fsn_sub
CF5C  A9 0B                 lda #<c_pio2_3
CF5E  A0 DB                 ldy #>c_pio2_3
CF60  20 EF CF              jsr fsn_sub
CF63  A9 10                 lda #<c_pio2_4
CF65  A0 DB                 ldy #>c_pio2_4
CF67  20 EF CF              jsr fsn_sub
CF6A  A9 15                 lda #<c_pio2_5
CF6C  A0 DB                 ldy #>c_pio2_5
CF6E  20 EF CF              jsr fsn_sub             ; r
                            ; |q| が大きいと x × 2/π に小数部の桁が残らず、q が1ずれることがある。
                            ; |r| が π/4 以下になるまで、π/2 を足し引きして象限を合わせる
                    fsn_fix:
CF71  A5 80                 lda fac_e
CF73  F0 39                 beq fsn_rok             ; r = 0
CF75  A5 85                 lda fac_s
CF77  48                    pha
CF78  64 85                 stz fac_s
CF7A  A9 FC                 lda #<c_pio4
CF7C  A0 DA                 ldy #>c_pio4
CF7E  20 1C D3              jsr arg_ld
CF81  20 93 D6              jsr fcmp
CF84  AA                    tax
CF85  68                    pla
CF86  85 85                 sta fac_s
CF88  E0 FF                 cpx #$FF
CF8A  D0 22                 bne fsn_rok             ; |r| <= π/4
CF8C  24 85                 bit fac_s
CF8E  10 0C                 bpl fsn_hi
CF90  A9 F2                 lda #<c_halfpi          ; r < -π/4: r + π/2、象限を1つ戻す
CF92  A0 DA                 ldy #>c_halfpi
CF94  20 06 CC              jsr addc
CF97  CE D6 02              dec sin_q
CF9A  80 D5                 bra fsn_fix
                    fsn_hi:
CF9C  20 AC D3              jsr fac_neg             ; r > π/4: r - π/2、象限を1つ進める
CF9F  A9 F2                 lda #<c_halfpi
CFA1  A0 DA                 ldy #>c_halfpi
CFA3  20 06 CC              jsr addc
CFA6  20 AC D3              jsr fac_neg
CFA9  EE D6 02              inc sin_q
CFAC  80 C3                 bra fsn_fix
                    fsn_rok:
CFAE  AD D6 02              lda sin_q               ; 象限が奇数なら cos(r) = sin(π/2 - |r|)
CFB1  29 01                 and #1
CFB3  F0 19                 beq fsn_3
CFB5  A5 80                 lda fac_e               ; r = 0 なら cos(0) = 1 ちょうど
CFB7  D0 09                 bne fsn_c               ; (多項式で sin(π/2) を求めると 1 より 1ビット小さくなる)
CFB9  A9 D4                 lda #<c_one
CFBB  A0 DA                 ldy #>c_one
CFBD  20 F3 D2              jsr fac_ld
CFC0  80 22                 bra fsn_sg
                    fsn_c:
CFC2  64 85                 stz fac_s
CFC4  A9 F2                 lda #<c_halfpi
CFC6  A0 DA                 ldy #>c_halfpi
CFC8  20 1C D3              jsr arg_ld
CFCB  20 39 D4              jsr fsub
                    fsn_3:
CFCE  20 D3 CB              jsr st3
CFD1  20 7C D3              jsr fac_to_arg
CFD4  20 0D D5              jsr fmul                ; r²
CFD7  A9 7E                 lda #<sin_poly
CFD9  A0 DB                 ldy #>sin_poly
CFDB  20 0C CC              jsr poly
CFDE  20 E1 CB              jsr arg3
CFE1  20 0D D5              jsr fmul                ; r × p(r²)
                    fsn_sg:
CFE4  AD D6 02              lda sin_q               ; 象限が 2, 3 なら負
CFE7  29 02                 and #2
CFE9  F0 03                 beq fsn_4
CFEB  20 AC D3              jsr fac_neg
                    fsn_4:
CFEE  60                    rts
                    
                    ; fpt3 = fpt3 - q(fpt4) × 定数(A/Y)。FAC にも同じ値を残す
                    fsn_sub:
CFEF  48                    pha
CFF0  5A                    phy
CFF1  20 EF CB              jsr ld4
CFF4  7A                    ply
CFF5  68                    pla
CFF6  20 00 CC              jsr mulc
CFF9  20 E1 CB              jsr arg3
CFFC  20 39 D4              jsr fsub
CFFF  4C D3 CB              jmp st3
                    
                    fn_atn:
D002  20 61 B0              jsr par_num
D005  A5 85                 lda fac_s
D007  8D D7 02              sta atn_s
D00A  64 85                 stz fac_s
D00C  9C D8 02              stz atn_f               ; bit0: 1/x にした、bit1: π/6 ずらした
D00F  A9 D4                 lda #<c_one             ; |x| > 1 なら 1/x
D011  A0 DA                 ldy #>c_one
D013  20 1C D3              jsr arg_ld
D016  20 93 D6              jsr fcmp
D019  C9 FF                 cmp #$FF
D01B  D0 08                 bne fa_2
D01D  20 AC D0              jsr fdiv_1x
D020  A9 01                 lda #1
D022  0C D8 02              tsb atn_f
                    fa_2:
D025  A9 56                 lda #<c_tan15           ; x > tan 15° なら (x√3 - 1) / (x + √3)
D027  A0 DB                 ldy #>c_tan15
D029  20 1C D3              jsr arg_ld
D02C  20 93 D6              jsr fcmp
D02F  C9 FF                 cmp #$FF
D031  D0 2C                 bne fa_3
D033  20 D3 CB              jsr st3
D036  A9 5B                 lda #<c_sqrt3
D038  A0 DB                 ldy #>c_sqrt3
D03A  20 06 CC              jsr addc                ; x + √3
D03D  20 E8 CB              jsr st4
D040  20 DA CB              jsr ld3
D043  A9 5B                 lda #<c_sqrt3
D045  A0 DB                 ldy #>c_sqrt3
D047  20 00 CC              jsr mulc
D04A  A9 D9                 lda #<c_mone
D04C  A0 DA                 ldy #>c_mone
D04E  20 06 CC              jsr addc                ; x√3 - 1
D051  20 7C D3              jsr fac_to_arg
D054  20 EF CB              jsr ld4
D057  20 C6 D5              jsr fdiv
D05A  A9 02                 lda #2
D05C  0C D8 02              tsb atn_f
                    fa_3:
D05F  20 D3 CB              jsr st3                 ; t
D062  20 7C D3              jsr fac_to_arg
D065  20 0D D5              jsr fmul                ; t²
D068  A9 0D                 lda #<atn_poly
D06A  A0 DC                 ldy #>atn_poly
D06C  20 0C CC              jsr poly
D06F  20 E1 CB              jsr arg3
D072  20 0D D5              jsr fmul                ; t × p(t²)
D075  AD D8 02              lda atn_f
D078  29 02                 and #2
D07A  F0 07                 beq fa_4
D07C  A9 60                 lda #<c_pi6
D07E  A0 DB                 ldy #>c_pi6
D080  20 06 CC              jsr addc
                    fa_4:
D083  AD D8 02              lda atn_f
D086  29 01                 and #1
D088  F0 0A                 beq fa_5
D08A  A9 F2                 lda #<c_halfpi          ; π/2 - y
D08C  A0 DA                 ldy #>c_halfpi
D08E  20 1C D3              jsr arg_ld
D091  20 39 D4              jsr fsub
                    fa_5:
D094  AD D7 02              lda atn_s
D097  85 85                 sta fac_s
D099  A5 80                 lda fac_e
D09B  D0 02                 bne fa_6
D09D  64 85                 stz fac_s
                    fa_6:
D09F  AD BA 03              lda angmode
D0A2  F0 07                 beq fa_7
D0A4  A9 51                 lda #<c_rad2deg
D0A6  A0 DB                 ldy #>c_rad2deg
D0A8  4C 00 CC              jmp mulc
                    fa_7:
D0AB  60                    rts
                    
                    ; FAC = 1 / FAC
                    fdiv_1x:
D0AC  A9 D4                 lda #<c_one
D0AE  A0 DA                 ldy #>c_one
D0B0  20 1C D3              jsr arg_ld              ; ARG = 1
D0B3  4C C6 D5              jmp fdiv
                    
                    ; ===================================================================
                    ; べき乗: FAC = ARG ^ FAC
                    ; ===================================================================
                    fpow:
D0B6  A9 CB                 lda #<fpt6              ; 指数 y
D0B8  A0 02                 ldy #>fpt6
D0BA  20 45 D3              jsr fac_st
D0BD  20 97 D3              jsr swap_fa
D0C0  20 D3 CB              jsr st3                 ; 底 x(fpt3)
D0C3  A9 CB                 lda #<fpt6
D0C5  A0 02                 ldy #>fpt6
D0C7  20 F3 D2              jsr fac_ld
D0CA  A5 80                 lda fac_e
D0CC  D0 07                 bne fpw_1
D0CE  A9 D4                 lda #<c_one             ; x^0 = 1
D0D0  A0 DA                 ldy #>c_one
D0D2  4C F3 D2              jmp fac_ld
                    fpw_1:
D0D5  AD CC 03              lda fpt3                ; 底が0
D0D8  D0 0A                 bne fpw_2
D0DA  A5 85                 lda fac_s
D0DC  10 03                 bpl fp_zero
D0DE  4C C5 DA              jmp err_div0
                    fp_zero:
D0E1  4C A5 D3              jmp fac_zero
                    fpw_2:
                            ; 指数が -32767 から 32767 の整数なら、かけ算をくり返す(正確)
D0E4  A5 80                 lda fac_e
D0E6  C9 90                 cmp #128+16
D0E8  B0 04                 bcs fp_genj
D0EA  C9 81                 cmp #129
D0EC  B0 03                 bcs fp_int
                    fp_genj:
D0EE  4C F4 D1              jmp fp_gen              ; |y| < 1 か大きすぎる
                    fp_int:
D0F1  20 09 D7              jsr fac_chop
D0F4  F0 03                 beq fp_int2
D0F6  4C ED D1              jmp fp_gen2             ; 小数がある
                    fp_int2:
D0F9  20 78 D7              jsr getint16            ; n
                            ; |n| が 32 を超え、底が整数でも2のべきでもないなら、EXP(n × LN(|x|)) で計算する。
                            ; 底が 1 に近い小数(1.0001^10000 など)は、かけ算をくり返すと誤差がたまるため。
                            ; 底が整数か2のべきなら、かけ算のほうが正確(ちょうど表せる答えはちょうどになる)
D0FC  A5 B6                 lda linnum+1
D0FE  30 0A                 bmi fpb_neg
D100  D0 12                 bne fpb_big
D102  A5 B5                 lda linnum
D104  C9 21                 cmp #33
D106  90 4B                 bcc fp_mul              ; 0〜32
D108  80 0A                 bra fpb_big
                    fpb_neg:
D10A  C9 FF                 cmp #$FF
D10C  D0 06                 bne fpb_big
D10E  A5 B5                 lda linnum
D110  C9 E0                 cmp #$E0
D112  B0 3F                 bcs fp_mul              ; -32〜-1
                    fpb_big:
D114  AD CD 03              lda fpt3+1              ; 底の仮数が 1000…0 なら2のべき
D117  29 7F                 and #$7F
D119  0D CE 03              ora fpt3+2
D11C  0D CF 03              ora fpt3+3
D11F  0D D0 03              ora fpt3+4
D122  F0 2F                 beq fp_mul
D124  AD CC 03              lda fpt3                ; |x| >= 2^32 なら整数、|x| < 1 なら整数でない
D127  C9 A0                 cmp #128+32
D129  B0 28                 bcs fp_mul
D12B  C9 81                 cmp #129
D12D  90 08                 bcc fpb_gen
D12F  20 DA CB              jsr ld3
D132  20 09 D7              jsr fac_chop
D135  F0 1C                 beq fp_mul              ; 小数がない
                    fpb_gen:
D137  AD CD 03              lda fpt3+1
D13A  30 03                 bmi fpb_ng
D13C  4C ED D1              jmp fp_gen2
                    fpb_ng:
D13F  29 7F                 and #$7F                ; 底が負: |x| で計算し、n が奇数なら符号を変える
D141  8D CD 03              sta fpt3+1
D144  A5 B5                 lda linnum
D146  29 01                 and #1
D148  48                    pha
D149  20 ED D1              jsr fp_gen2
D14C  68                    pla
D14D  F0 03                 beq fpb_done
D14F  4C AC D3              jmp fac_neg
                    fpb_done:
D152  60                    rts
                    fp_mul:
D153  A5 B5                 lda linnum
D155  8D D9 02              sta pow_n
D158  A5 B6                 lda linnum+1
D15A  8D DA 02              sta pow_n+1
D15D  10 47                 bpl fp_i1
D15F  38                    sec                     ; |n|
D160  A9 00                 lda #0
D162  ED D9 02              sbc pow_n
D165  8D D9 02              sta pow_n
D168  A9 00                 lda #0
D16A  ED DA 02              sbc pow_n+1
D16D  8D DA 02              sta pow_n+1
                            ; 負の指数: ふつうは x^|n| を求めてから逆数にする(誤差が小さい)。
                            ; ただし x^|n| が範囲を超えそうなとき(|n| × |log2 x| >= 127)は、
                            ; 途中であふれないように、先に底を逆数にしてから |n| 乗する
D170  AD DA 02              lda pow_n+1
D173  D0 26                 bne fp_inv
D175  AD CC 03              lda fpt3                ; 底の指数 e。|log2 x| <= k = e-128(e>128)、129-e(e<=128)
D178  C9 81                 cmp #129
D17A  90 04                 bcc fp_k1
D17C  E9 80                 sbc #128
D17E  80 06                 bra fp_k2
                    fp_k1:
D180  A9 81                 lda #129
D182  38                    sec
D183  ED CC 03              sbc fpt3
                    fp_k2:
D186  85 C0                 sta bt0
D188  AE D9 02              ldx pow_n               ; k を |n| 回足して 127 以上になるか
D18B  A9 00                 lda #0
                    fp_k3:
D18D  18                    clc
D18E  65 C0                 adc bt0
D190  B0 09                 bcs fp_inv
D192  C9 7F                 cmp #127
D194  B0 05                 bcs fp_inv
D196  CA                    dex
D197  D0 F4                 bne fp_k3
D199  80 0B                 bra fp_i1
                    fp_inv:
D19B  20 DA CB              jsr ld3                 ; 底 = 1/底(1/底があふれるなら答えもあふれる)
D19E  20 AC D0              jsr fdiv_1x
D1A1  20 D3 CB              jsr st3
D1A4  64 B6                 stz linnum+1            ; 最後の逆数は要らない
                    fp_i1:
D1A6  A9 D4                 lda #<c_one             ; 結果 = 1(fpt4)、底(fpt3)
D1A8  A0 DA                 ldy #>c_one
D1AA  20 F3 D2              jsr fac_ld
D1AD  20 E8 CB              jsr st4
                    fp_i2:
D1B0  AD D9 02              lda pow_n
D1B3  0D DA 02              ora pow_n+1
D1B6  F0 2A                 beq fp_i4
D1B8  4E DA 02              lsr pow_n+1
D1BB  6E D9 02              ror pow_n
D1BE  90 0C                 bcc fp_i3
D1C0  20 E1 CB              jsr arg3                ; 結果 × 底
D1C3  20 EF CB              jsr ld4
D1C6  20 0D D5              jsr fmul
D1C9  20 E8 CB              jsr st4
                    fp_i3:
D1CC  AD D9 02              lda pow_n
D1CF  0D DA 02              ora pow_n+1
D1D2  F0 0E                 beq fp_i4
D1D4  20 DA CB              jsr ld3                 ; 底 × 底
D1D7  20 7C D3              jsr fac_to_arg
D1DA  20 0D D5              jsr fmul
D1DD  20 D3 CB              jsr st3
D1E0  80 CE                 bra fp_i2
                    fp_i4:
D1E2  20 EF CB              jsr ld4
D1E5  A5 B6                 lda linnum+1            ; 指数が負なら 1/結果
D1E7  10 03                 bpl fp_i5
D1E9  4C AC D0              jmp fdiv_1x
                    fp_i5:
D1EC  60                    rts
                    fp_gen2:
D1ED  A9 CB                 lda #<fpt6              ; 切り捨てで壊したので y を読み直す
D1EF  A0 02                 ldy #>fpt6
D1F1  20 F3 D2              jsr fac_ld
                    fp_gen:
D1F4  AD CD 03              lda fpt3+1              ; 底が負ならできない
D1F7  10 03                 bpl fp_g1
D1F9  4C CA DA              jmp err_fc
                    fp_g1:
D1FC  20 DA CB              jsr ld3                 ; exp(y × ln x)
D1FF  20 49 CD              jsr fln
D202  A9 CB                 lda #<fpt6
D204  A0 02                 ldy #>fpt6
D206  20 1C D3              jsr arg_ld
D209  20 0D D5              jsr fmul
D20C  4C B2 CC              jmp fexp
                    
                    ; ===================================================================
                    ; RND, RANDOMIZE
                    ; ===================================================================
                    fn_rnd:
D20F  20 61 B0              jsr par_num
D212  A5 80                 lda fac_e
D214  D0 07                 bne frn_1
D216  A9 B5                 lda #<rndlast           ; RND(0): 直前の値
D218  A0 03                 ldy #>rndlast
D21A  4C F3 D2              jmp fac_ld
                    frn_1:
D21D  A5 85                 lda fac_s
D21F  10 19                 bpl fr_gen
D221  A5 81                 lda fac_m1              ; 負: その数で種を決める
D223  45 80                 eor fac_e
D225  8D B1 03              sta rndseed
D228  A5 82                 lda fac_m2
D22A  8D B2 03              sta rndseed+1
D22D  A5 83                 lda fac_m3
D22F  8D B3 03              sta rndseed+2
D232  A5 84                 lda fac_m4
D234  8D B4 03              sta rndseed+3
D237  20 66 D2              jsr seed_fix
                    fr_gen:
D23A  20 78 D2              jsr xorshift
D23D  AD B4 03              lda rndseed+3           ; 0 以上 1 未満
D240  85 81                 sta fac_m1
D242  AD B3 03              lda rndseed+2
D245  85 82                 sta fac_m2
D247  AD B2 03              lda rndseed+1
D24A  85 83                 sta fac_m3
D24C  AD B1 03              lda rndseed
D24F  85 84                 sta fac_m4
D251  64 86                 stz fac_x
D253  64 85                 stz fac_s
D255  A9 80                 lda #128
D257  85 80                 sta fac_e
D259  20 DD D3              jsr fac_norm
D25C  A9 B5                 lda #<rndlast
D25E  A0 03                 ldy #>rndlast
D260  20 45 D3              jsr fac_st
D263  64 9C                 stz valtyp
D265  60                    rts
                    
                    ; 種が0なら1にする
                    seed_fix:
D266  AD B1 03              lda rndseed
D269  0D B2 03              ora rndseed+1
D26C  0D B3 03              ora rndseed+2
D26F  0D B4 03              ora rndseed+3
D272  D0 03                 bne sfx_1
D274  EE B1 03              inc rndseed
                    sfx_1:
D277  60                    rts
                    
                    ; 32ビットの xorshift(rndseed は下位から)
                    xorshift:
                            ; x ^= x << 13
D278  64 C0                 stz bt0
D27A  AD B1 03              lda rndseed
D27D  85 C1                 sta bt1
D27F  AD B2 03              lda rndseed+1
D282  85 C2                 sta bt2
D284  AD B3 03              lda rndseed+2
D287  85 C3                 sta bt3
D289  A2 05                 ldx #5
                    xs_1:
D28B  06 C0                 asl bt0
D28D  26 C1                 rol bt1
D28F  26 C2                 rol bt2
D291  26 C3                 rol bt3
D293  CA                    dex
D294  D0 F5                 bne xs_1
D296  20 CF D2              jsr xs_xor
                            ; x ^= x >> 17
D299  AD B3 03              lda rndseed+2
D29C  85 C0                 sta bt0
D29E  AD B4 03              lda rndseed+3
D2A1  85 C1                 sta bt1
D2A3  64 C2                 stz bt2
D2A5  64 C3                 stz bt3
D2A7  46 C1                 lsr bt1
D2A9  66 C0                 ror bt0
D2AB  20 CF D2              jsr xs_xor
                            ; x ^= x << 5
D2AE  AD B1 03              lda rndseed
D2B1  85 C0                 sta bt0
D2B3  AD B2 03              lda rndseed+1
D2B6  85 C1                 sta bt1
D2B8  AD B3 03              lda rndseed+2
D2BB  85 C2                 sta bt2
D2BD  AD B4 03              lda rndseed+3
D2C0  85 C3                 sta bt3
D2C2  A2 05                 ldx #5
                    xs_2:
D2C4  06 C0                 asl bt0
D2C6  26 C1                 rol bt1
D2C8  26 C2                 rol bt2
D2CA  26 C3                 rol bt3
D2CC  CA                    dex
D2CD  D0 F5                 bne xs_2
                    xs_xor:
D2CF  A2 03                 ldx #3
                    xs_3:
D2D1  BD B1 03              lda rndseed,X
D2D4  55 C0                 eor bt0,X
D2D6  9D B1 03              sta rndseed,X
D2D9  CA                    dex
D2DA  10 F5                 bpl xs_3
D2DC  60                    rts
                    
                    st_randomize:
D2DD  A5 F2                 lda ticks
D2DF  4D B1 03              eor rndseed
D2E2  8D B1 03              sta rndseed
D2E5  A5 F3                 lda ticks+1
D2E7  4D B2 03              eor rndseed+1
D2EA  8D B2 03              sta rndseed+1
D2ED  20 66 D2              jsr seed_fix
D2F0  4C 78 D2              jmp xorshift
                    
                    ; PX-65 BASIC: 浮動小数点の四則演算、比較、変換
                    ;
                    ; FAC と ARG は basic.s を参照。メモリ上の数は5バイト(tools/mkfpconst.js を参照)。
                    ; 2つの数をとる演算は ARG(左)と FAC(右)を使い、結果を FAC に置く。
                    
                    ; ===================================================================
                    ; 読み書きとコピー
                    ; ===================================================================
                    
                    ; FAC = (A=下位, Y=上位) の番地の数
                    fac_ld:
D2F3  85 C8                 sta fptr
D2F5  84 C9                 sty fptr+1
D2F7  A0 04                 ldy #4
D2F9  B1 C8                 lda (fptr),Y
D2FB  85 84                 sta fac_m4
D2FD  88                    dey
D2FE  B1 C8                 lda (fptr),Y
D300  85 83                 sta fac_m3
D302  88                    dey
D303  B1 C8                 lda (fptr),Y
D305  85 82                 sta fac_m2
D307  88                    dey
D308  B1 C8                 lda (fptr),Y
D30A  AA                    tax
D30B  09 80                 ora #$80
D30D  85 81                 sta fac_m1
D30F  8A                    txa
D310  29 80                 and #$80
D312  85 85                 sta fac_s
D314  88                    dey
D315  B1 C8                 lda (fptr),Y
D317  85 80                 sta fac_e
D319  64 86                 stz fac_x
D31B  60                    rts
                    
                    ; ARG = (A, Y) の番地の数
                    arg_ld:
D31C  85 C8                 sta fptr
D31E  84 C9                 sty fptr+1
D320  A0 04                 ldy #4
D322  B1 C8                 lda (fptr),Y
D324  85 8B                 sta arg_m4
D326  88                    dey
D327  B1 C8                 lda (fptr),Y
D329  85 8A                 sta arg_m3
D32B  88                    dey
D32C  B1 C8                 lda (fptr),Y
D32E  85 89                 sta arg_m2
D330  88                    dey
D331  B1 C8                 lda (fptr),Y
D333  AA                    tax
D334  09 80                 ora #$80
D336  85 88                 sta arg_m1
D338  8A                    txa
D339  29 80                 and #$80
D33B  85 8C                 sta arg_s
D33D  88                    dey
D33E  B1 C8                 lda (fptr),Y
D340  85 87                 sta arg_e
D342  64 8D                 stz arg_x
D344  60                    rts
                    
                    ; (A, Y) の番地に FAC を書く(丸めてから)
                    fac_st:
D345  85 C8                 sta fptr
D347  84 C9                 sty fptr+1
D349  20 B7 D3              jsr fac_round
D34C  A0 00                 ldy #0
D34E  A5 80                 lda fac_e
D350  91 C8                 sta (fptr),Y
D352  F0 19                 beq fst_zero
D354  C8                    iny
D355  A5 81                 lda fac_m1
D357  29 7F                 and #$7F
D359  05 85                 ora fac_s
D35B  91 C8                 sta (fptr),Y
D35D  C8                    iny
D35E  A5 82                 lda fac_m2
D360  91 C8                 sta (fptr),Y
D362  C8                    iny
D363  A5 83                 lda fac_m3
D365  91 C8                 sta (fptr),Y
D367  C8                    iny
D368  A5 84                 lda fac_m4
D36A  91 C8                 sta (fptr),Y
D36C  60                    rts
                    fst_zero:
D36D  A9 00                 lda #0
D36F  C8                    iny
D370  91 C8                 sta (fptr),Y
D372  C8                    iny
D373  91 C8                 sta (fptr),Y
D375  C8                    iny
D376  91 C8                 sta (fptr),Y
D378  C8                    iny
D379  91 C8                 sta (fptr),Y
D37B  60                    rts
                    
                    ; ARG = FAC(丸めてから)
                    fac_to_arg:
D37C  20 B7 D3              jsr fac_round
D37F  A2 05                 ldx #5
                    fta_1:
D381  B5 80                 lda fac_e,X
D383  95 87                 sta arg_e,X
D385  CA                    dex
D386  10 F9                 bpl fta_1
D388  64 8D                 stz arg_x
D38A  60                    rts
                    
                    ; FAC = ARG
                    arg_to_fac:
D38B  A2 05                 ldx #5
                    atf_1:
D38D  B5 87                 lda arg_e,X
D38F  95 80                 sta fac_e,X
D391  CA                    dex
D392  10 F9                 bpl atf_1
D394  64 86                 stz fac_x
D396  60                    rts
                    
                    ; FAC と ARG を入れ替える(丸め用のバイトも)
                    swap_fa:
D397  A2 06                 ldx #6
                    sfa_1:
D399  B5 80                 lda fac_e,X
D39B  B4 87                 ldy arg_e,X
D39D  95 87                 sta arg_e,X
D39F  94 80                 sty fac_e,X
D3A1  CA                    dex
D3A2  10 F5                 bpl sfa_1
D3A4  60                    rts
                    
                    ; FAC = 0
                    fac_zero:
D3A5  64 80                 stz fac_e
D3A7  64 85                 stz fac_s
D3A9  64 86                 stz fac_x
D3AB  60                    rts
                    
                    ; FAC = -FAC
                    fac_neg:
D3AC  A5 80                 lda fac_e
D3AE  F0 06                 beq fng_1
D3B0  A5 85                 lda fac_s
D3B2  49 80                 eor #$80
D3B4  85 85                 sta fac_s
                    fng_1:
D3B6  60                    rts
                    
                    ; ===================================================================
                    ; 丸めと正規化
                    ; ===================================================================
                    
                    ; 丸め用のバイトを仮数に丸め込む
                    fac_round:
D3B7  A5 86                 lda fac_x
D3B9  10 1F                 bpl frd_done
D3BB  A5 80                 lda fac_e
D3BD  F0 1B                 beq frd_done
D3BF  E6 84                 inc fac_m4
D3C1  D0 17                 bne frd_done
D3C3  E6 83                 inc fac_m3
D3C5  D0 13                 bne frd_done
D3C7  E6 82                 inc fac_m2
D3C9  D0 0F                 bne frd_done
D3CB  E6 81                 inc fac_m1
D3CD  D0 0B                 bne frd_done
D3CF  A9 80                 lda #$80                ; 仮数があふれた
D3D1  85 81                 sta fac_m1
D3D3  E6 80                 inc fac_e
D3D5  D0 03                 bne frd_done
D3D7  4C C0 DA              jmp err_ov
                    frd_done:
D3DA  64 86                 stz fac_x
D3DC  60                    rts
                    
                    ; 仮数の最上位ビットが1になるように左へずらす(指数を減らす)
                    fac_norm:
D3DD  A5 80                 lda fac_e
D3DF  F0 C4                 beq fac_zero
                    fnm_byte:
D3E1  A5 81                 lda fac_m1
D3E3  D0 29                 bne fnm_bit
D3E5  A5 82                 lda fac_m2              ; 1バイトずつずらす
D3E7  05 83                 ora fac_m3
D3E9  05 84                 ora fac_m4
D3EB  05 86                 ora fac_x
D3ED  F0 B6                 beq fac_zero
D3EF  A5 82                 lda fac_m2
D3F1  85 81                 sta fac_m1
D3F3  A5 83                 lda fac_m3
D3F5  85 82                 sta fac_m2
D3F7  A5 84                 lda fac_m4
D3F9  85 83                 sta fac_m3
D3FB  A5 86                 lda fac_x
D3FD  85 84                 sta fac_m4
D3FF  64 86                 stz fac_x
D401  A5 80                 lda fac_e
D403  38                    sec
D404  E9 08                 sbc #8
D406  90 9D                 bcc fac_zero
D408  F0 9B                 beq fac_zero
D40A  85 80                 sta fac_e
D40C  80 D3                 bra fnm_byte
                    fnm_bit:
D40E  30 12                 bmi fnm_done
                    fnm_1:
D410  06 86                 asl fac_x
D412  26 84                 rol fac_m4
D414  26 83                 rol fac_m3
D416  26 82                 rol fac_m2
D418  26 81                 rol fac_m1
D41A  C6 80                 dec fac_e
D41C  F0 87                 beq fac_zero
D41E  A5 81                 lda fac_m1
D420  10 EE                 bpl fnm_1
                    fnm_done:
D422  60                    rts
                    
                    ; ft8/ft9(符号付き16ビット)を指数にする。1未満なら0、255を超えたらオーバーフロー
                    set_exp16:
D423  A5 97                 lda ft9
D425  10 03                 bpl *+5
D427  4C A5 D3              jmp fac_zero
D42A  D0 0A                 bne se_ov
D42C  A5 96                 lda ft8
D42E  D0 03                 bne *+5
D430  4C A5 D3              jmp fac_zero
D433  85 80                 sta fac_e
D435  60                    rts
                    se_ov:
D436  4C C0 DA              jmp err_ov
                    
                    ; ===================================================================
                    ; 加減算
                    ; ===================================================================
                    
                    ; FAC = ARG - FAC
                    fsub:
D439  20 AC D3              jsr fac_neg
                            ; そのまま fadd へ
                    
                    ; FAC = ARG + FAC
                    fadd:
D43C  A5 87                 lda arg_e
D43E  D0 01                 bne fad_1
D440  60                    rts                     ; ARG が0
                    fad_1:
D441  A5 80                 lda fac_e
D443  D0 03                 bne fad_2
D445  4C 8B D3              jmp arg_to_fac          ; FAC が0
                    fad_2:
D448  C5 87                 cmp arg_e               ; 指数の大きい方を FAC に
D44A  B0 03                 bcs fad_3
D44C  20 97 D3              jsr swap_fa
                    fad_3:
D44F  38                    sec
D450  A5 80                 lda fac_e
D452  E5 87                 sbc arg_e
D454  C9 29                 cmp #41
D456  90 01                 bcc fad_4
D458  60                    rts                     ; ARG は小さすぎて影響しない
                    fad_4:
D459  AA                    tax
D45A  20 DF D4              jsr arg_shr
D45D  A5 85                 lda fac_s
D45F  45 8C                 eor arg_s
D461  30 33                 bmi fad_sub
D463  18                    clc                     ; 同じ符号: 仮数を足す
D464  A5 86                 lda fac_x
D466  65 8D                 adc arg_x
D468  85 86                 sta fac_x
D46A  A5 84                 lda fac_m4
D46C  65 8B                 adc arg_m4
D46E  85 84                 sta fac_m4
D470  A5 83                 lda fac_m3
D472  65 8A                 adc arg_m3
D474  85 83                 sta fac_m3
D476  A5 82                 lda fac_m2
D478  65 89                 adc arg_m2
D47A  85 82                 sta fac_m2
D47C  A5 81                 lda fac_m1
D47E  65 88                 adc arg_m1
D480  85 81                 sta fac_m1
D482  90 11                 bcc fad_done
D484  66 81                 ror fac_m1              ; 繰り上がり: 右へ1ビット
D486  66 82                 ror fac_m2
D488  66 83                 ror fac_m3
D48A  66 84                 ror fac_m4
D48C  66 86                 ror fac_x
D48E  E6 80                 inc fac_e
D490  D0 03                 bne fad_done
D492  4C C0 DA              jmp err_ov
                    fad_done:
D495  60                    rts
                    fad_sub:
D496  38                    sec                     ; 違う符号: 仮数を引く
D497  A5 86                 lda fac_x
D499  E5 8D                 sbc arg_x
D49B  85 86                 sta fac_x
D49D  A5 84                 lda fac_m4
D49F  E5 8B                 sbc arg_m4
D4A1  85 84                 sta fac_m4
D4A3  A5 83                 lda fac_m3
D4A5  E5 8A                 sbc arg_m3
D4A7  85 83                 sta fac_m3
D4A9  A5 82                 lda fac_m2
D4AB  E5 89                 sbc arg_m2
D4AD  85 82                 sta fac_m2
D4AF  A5 81                 lda fac_m1
D4B1  E5 88                 sbc arg_m1
D4B3  85 81                 sta fac_m1
D4B5  B0 25                 bcs fad_norm
D4B7  A5 85                 lda fac_s               ; 引きすぎた: 符号を反対にして仮数を2の補数に
D4B9  49 80                 eor #$80
D4BB  85 85                 sta fac_s
D4BD  38                    sec
D4BE  A9 00                 lda #0
D4C0  E5 86                 sbc fac_x
D4C2  85 86                 sta fac_x
D4C4  A9 00                 lda #0
D4C6  E5 84                 sbc fac_m4
D4C8  85 84                 sta fac_m4
D4CA  A9 00                 lda #0
D4CC  E5 83                 sbc fac_m3
D4CE  85 83                 sta fac_m3
D4D0  A9 00                 lda #0
D4D2  E5 82                 sbc fac_m2
D4D4  85 82                 sta fac_m2
D4D6  A9 00                 lda #0
D4D8  E5 81                 sbc fac_m1
D4DA  85 81                 sta fac_m1
                    fad_norm:
D4DC  4C DD D3              jmp fac_norm
                    
                    ; ARG の仮数を X ビット右へずらす(丸め用のバイトまで)
                    arg_shr:
                    ash_1:
D4DF  E0 08                 cpx #8
D4E1  90 18                 bcc ash_2
D4E3  A5 8B                 lda arg_m4
D4E5  85 8D                 sta arg_x
D4E7  A5 8A                 lda arg_m3
D4E9  85 8B                 sta arg_m4
D4EB  A5 89                 lda arg_m2
D4ED  85 8A                 sta arg_m3
D4EF  A5 88                 lda arg_m1
D4F1  85 89                 sta arg_m2
D4F3  64 88                 stz arg_m1
D4F5  8A                    txa
D4F6  E9 08                 sbc #8                  ; C=1
D4F8  AA                    tax
D4F9  80 E4                 bra ash_1
                    ash_2:
D4FB  E0 00                 cpx #0
D4FD  F0 0D                 beq ash_done
                    ash_3:
D4FF  46 88                 lsr arg_m1
D501  66 89                 ror arg_m2
D503  66 8A                 ror arg_m3
D505  66 8B                 ror arg_m4
D507  66 8D                 ror arg_x
D509  CA                    dex
D50A  D0 F3                 bne ash_3
                    ash_done:
D50C  60                    rts
                    
                    ; ===================================================================
                    ; 乗除算
                    ; ===================================================================
                    
                    ; FAC = ARG × FAC
                    fmul:
D50D  A5 80                 lda fac_e
D50F  D0 03                 bne *+5             ; 0 × x = 0
D511  4C BC D5              jmp fml_ret
D514  A5 87                 lda arg_e
D516  D0 03                 bne fml_1
D518  4C A5 D3              jmp fac_zero
                    fml_1:
D51B  18                    clc                     ; 指数 = ARG + FAC - 128(16ビット)
D51C  65 80                 adc fac_e
D51E  85 96                 sta ft8
D520  A9 00                 lda #0
D522  69 00                 adc #0
D524  85 97                 sta ft9
D526  38                    sec
D527  A5 96                 lda ft8
D529  E9 80                 sbc #128
D52B  85 96                 sta ft8
D52D  A5 97                 lda ft9
D52F  E9 00                 sbc #0
D531  85 97                 sta ft9
D533  A5 85                 lda fac_s
D535  45 8C                 eor arg_s
D537  85 85                 sta fac_s
D539  A5 81                 lda fac_m1              ; 乗数を ft0-ft3 に移し、FAC の仮数を積にする
D53B  85 8E                 sta ft0
D53D  A5 82                 lda fac_m2
D53F  85 8F                 sta ft1
D541  A5 83                 lda fac_m3
D543  85 90                 sta ft2
D545  A5 84                 lda fac_m4
D547  85 91                 sta ft3
D549  64 81                 stz fac_m1
D54B  64 82                 stz fac_m2
D54D  64 83                 stz fac_m3
D54F  64 84                 stz fac_m4
D551  64 86                 stz fac_x
D553  64 92                 stz ft4
D555  A2 03                 ldx #3                  ; 乗数の下のバイトから
                    fml_byte:
D557  B5 8E                 lda ft0,X
D559  D0 18                 bne fml_bits
D55B  A5 86                 lda fac_x               ; 0 のバイト: 積を8ビット右へずらすだけ
D55D  85 92                 sta ft4
D55F  A5 84                 lda fac_m4
D561  85 86                 sta fac_x
D563  A5 83                 lda fac_m3
D565  85 84                 sta fac_m4
D567  A5 82                 lda fac_m2
D569  85 83                 sta fac_m3
D56B  A5 81                 lda fac_m1
D56D  85 82                 sta fac_m2
D56F  64 81                 stz fac_m1
D571  80 30                 bra fml_next
                    fml_bits:
D573  85 93                 sta ft5
D575  A0 08                 ldy #8
                    fml_loop:
D577  46 93                 lsr ft5
D579  90 19                 bcc fml_shift
D57B  18                    clc
D57C  A5 84                 lda fac_m4
D57E  65 8B                 adc arg_m4
D580  85 84                 sta fac_m4
D582  A5 83                 lda fac_m3
D584  65 8A                 adc arg_m3
D586  85 83                 sta fac_m3
D588  A5 82                 lda fac_m2
D58A  65 89                 adc arg_m2
D58C  85 82                 sta fac_m2
D58E  A5 81                 lda fac_m1
D590  65 88                 adc arg_m1
D592  85 81                 sta fac_m1
                    fml_shift:
D594  66 81                 ror fac_m1
D596  66 82                 ror fac_m2
D598  66 83                 ror fac_m3
D59A  66 84                 ror fac_m4
D59C  66 86                 ror fac_x
D59E  66 92                 ror ft4
D5A0  88                    dey
D5A1  D0 D4                 bne fml_loop
                    fml_next:
D5A3  CA                    dex
D5A4  10 B1                 bpl fml_byte
D5A6  A5 81                 lda fac_m1              ; 積は 0.25 以上なので、ずらすのは多くても1ビット
D5A8  30 0F                 bmi fml_exp
D5AA  06 92                 asl ft4
D5AC  26 86                 rol fac_x
D5AE  26 84                 rol fac_m4
D5B0  26 83                 rol fac_m3
D5B2  26 82                 rol fac_m2
D5B4  26 81                 rol fac_m1
D5B6  20 BD D5              jsr dec_exp16
                    fml_exp:
D5B9  4C 23 D4              jmp set_exp16
                    fml_ret:
D5BC  60                    rts
                    
                    ; ft8/ft9 を1減らす
                    dec_exp16:
D5BD  A5 96                 lda ft8
D5BF  D0 02                 bne dex_1
D5C1  C6 97                 dec ft9
                    dex_1:
D5C3  C6 96                 dec ft8
D5C5  60                    rts
                    
                    ; FAC = ARG / FAC
                    fdiv:
D5C6  A5 80                 lda fac_e
D5C8  D0 03                 bne fdv_1
D5CA  4C C5 DA              jmp err_div0
                    fdv_1:
D5CD  A5 87                 lda arg_e
D5CF  D0 03                 bne fdv_2
D5D1  4C A5 D3              jmp fac_zero
                    fdv_2:
D5D4  38                    sec                     ; 指数 = ARG - FAC + 129(16ビット)
D5D5  E5 80                 sbc fac_e
D5D7  85 96                 sta ft8
D5D9  A9 00                 lda #0
D5DB  E9 00                 sbc #0
D5DD  85 97                 sta ft9
D5DF  18                    clc
D5E0  A5 96                 lda ft8
D5E2  69 81                 adc #129
D5E4  85 96                 sta ft8
D5E6  A5 97                 lda ft9
D5E8  69 00                 adc #0
D5EA  85 97                 sta ft9
D5EC  A5 85                 lda fac_s
D5EE  45 8C                 eor arg_s
D5F0  85 85                 sta fac_s
D5F2  A5 81                 lda fac_m1              ; 除数を ft0-ft3 に。余りは ft4 + ARG の仮数
D5F4  85 8E                 sta ft0
D5F6  A5 82                 lda fac_m2
D5F8  85 8F                 sta ft1
D5FA  A5 83                 lda fac_m3
D5FC  85 90                 sta ft2
D5FE  A5 84                 lda fac_m4
D600  85 91                 sta ft3
D602  64 92                 stz ft4
D604  A2 28                 ldx #40                 ; 商を40ビット作る
                    fdv_loop:
D606  38                    sec                     ; 余り - 除数
D607  A5 8B                 lda arg_m4
D609  E5 91                 sbc ft3
D60B  85 93                 sta ft5
D60D  A5 8A                 lda arg_m3
D60F  E5 90                 sbc ft2
D611  85 94                 sta ft6
D613  A5 89                 lda arg_m2
D615  E5 8F                 sbc ft1
D617  85 95                 sta ft7
D619  A5 88                 lda arg_m1
D61B  E5 8E                 sbc ft0
D61D  A8                    tay
D61E  A5 92                 lda ft4
D620  E9 00                 sbc #0
D622  90 10                 bcc fdv_bit             ; 引けない: 商のビットは0(C=0)
D624  85 92                 sta ft4                 ; 引ける: 余りを更新、商のビットは1(C=1)
D626  84 88                 sty arg_m1
D628  A5 95                 lda ft7
D62A  85 89                 sta arg_m2
D62C  A5 94                 lda ft6
D62E  85 8A                 sta arg_m3
D630  A5 93                 lda ft5
D632  85 8B                 sta arg_m4
                    fdv_bit:
D634  26 86                 rol fac_x
D636  26 84                 rol fac_m4
D638  26 83                 rol fac_m3
D63A  26 82                 rol fac_m2
D63C  26 81                 rol fac_m1
D63E  06 8D                 asl arg_x               ; 余りを左へ(ARG の丸め用のバイトも割られる数に含める)
D640  26 8B                 rol arg_m4
D642  26 8A                 rol arg_m3
D644  26 89                 rol arg_m2
D646  26 88                 rol arg_m1
D648  26 92                 rol ft4
D64A  CA                    dex
D64B  D0 B9                 bne fdv_loop
D64D  A5 81                 lda fac_m1              ; 商は 0.5 より大きいので、ずらすのは多くても1ビット
D64F  30 0D                 bmi fdv_exp
D651  06 86                 asl fac_x
D653  26 84                 rol fac_m4
D655  26 83                 rol fac_m3
D657  26 82                 rol fac_m2
D659  26 81                 rol fac_m1
D65B  20 BD D5              jsr dec_exp16
                    fdv_exp:
D65E  4C 23 D4              jmp set_exp16
                    
                    ; ARG = FAC(丸め用のバイトも写す。丸めない)
                    fac_to_arg_x:
D661  A2 06                 ldx #6
                    ftx_1:
D663  B5 80                 lda fac_e,X
D665  95 87                 sta arg_e,X
D667  CA                    dex
D668  10 F9                 bpl ftx_1
D66A  60                    rts
                    
                    ; FAC = FAC × 10(仮数をずらして足すので速い。丸め用のバイトも使う)
                    mul10:
D66B  A5 80                 lda fac_e
D66D  F0 16                 beq m10_done
D66F  20 61 D6              jsr fac_to_arg_x        ; ARG = FAC × 2、FAC = FAC × 8
D672  E6 87                 inc arg_e
D674  F0 0C                 beq m10_ov
D676  A5 80                 lda fac_e
D678  18                    clc
D679  69 03                 adc #3
D67B  B0 05                 bcs m10_ov
D67D  85 80                 sta fac_e
D67F  4C 3C D4              jmp fadd
                    m10_ov:
D682  4C C0 DA              jmp err_ov
                    m10_done:
D685  60                    rts
                    
                    ; FAC = FAC / 10
                    div10:
D686  20 61 D6              jsr fac_to_arg_x
D689  A9 DE                 lda #<c_ten
D68B  A0 DA                 ldy #>c_ten
D68D  20 F3 D2              jsr fac_ld
D690  4C C6 D5              jmp fdiv
                    
                    ; ===================================================================
                    ; 比較
                    ; ===================================================================
                    
                    ; ARG と FAC を比べる。A = 0(等しい)、1(ARG が大きい)、$FF(ARG が小さい)
                    fcmp:
D693  20 B7 D3              jsr fac_round
                    ; 丸めずに比べる(FAC の丸め用のバイトは無視する)
                    fcmp_nr:
D696  A5 87                 lda arg_e
D698  D0 0A                 bne fcp_1
D69A  A5 80                 lda fac_e
D69C  F0 23                 beq fcp_eq
                    fcp_fsign:
D69E  A5 85                 lda fac_s               ; FAC が負なら ARG が大きい
D6A0  30 31                 bmi fcp_gt
D6A2  80 32                 bra fcp_lt
                    fcp_1:
D6A4  A5 80                 lda fac_e
D6A6  D0 06                 bne fcp_2
D6A8  A5 8C                 lda arg_s               ; FAC が0: ARG の符号で決まる
D6AA  30 2A                 bmi fcp_lt
D6AC  80 25                 bra fcp_gt
                    fcp_2:
D6AE  A5 8C                 lda arg_s
D6B0  45 85                 eor fac_s
D6B2  30 EA                 bmi fcp_fsign           ; 符号が違う
D6B4  A2 00                 ldx #0                  ; 同じ符号: 指数、仮数の順に比べる
                    fcp_3:
D6B6  B5 87                 lda arg_e,X
D6B8  D5 80                 cmp fac_e,X
D6BA  D0 08                 bne fcp_4
D6BC  E8                    inx
D6BD  E0 05                 cpx #5
D6BF  D0 F5                 bne fcp_3
                    fcp_eq:
D6C1  A9 00                 lda #0
D6C3  60                    rts
                    fcp_4:
D6C4  A9 01                 lda #1                  ; C=1 なら |ARG| > |FAC|
D6C6  B0 02                 bcs fcp_5
D6C8  A9 FF                 lda #$FF
                    fcp_5:
D6CA  24 8C                 bit arg_s
D6CC  10 02                 bpl fcp_6
D6CE  49 FE                 eor #$FE                ; 負なら逆
                    fcp_6:
D6D0  C9 00                 cmp #0
D6D2  60                    rts
                    fcp_gt:
D6D3  A9 01                 lda #1
D6D5  60                    rts
                    fcp_lt:
D6D6  A9 FF                 lda #$FF
D6D8  60                    rts
                    
                    ; ===================================================================
                    ; 整数との変換
                    ; ===================================================================
                    
                    ; FAC = A(下位)Y(上位)の符号なし16ビット整数
                    fac_u16:
D6D9  84 81                 sty fac_m1
D6DB  85 82                 sta fac_m2
D6DD  64 83                 stz fac_m3
D6DF  64 84                 stz fac_m4
D6E1  64 86                 stz fac_x
D6E3  64 85                 stz fac_s
D6E5  A9 90                 lda #128+16
D6E7  85 80                 sta fac_e
D6E9  4C DD D3              jmp fac_norm
                    
                    ; FAC = A の 0-255
                    fac_u8:
D6EC  A0 00                 ldy #0
D6EE  80 E9                 bra fac_u16
                    
                    ; FAC = A(下位)Y(上位)の符号付き16ビット整数
                    fac_s16:
D6F0  C0 80                 cpy #$80
D6F2  90 E5                 bcc fac_u16
D6F4  49 FF                 eor #$FF                ; 絶対値にする
D6F6  18                    clc
D6F7  69 01                 adc #1
D6F9  AA                    tax
D6FA  98                    tya
D6FB  49 FF                 eor #$FF
D6FD  69 00                 adc #0
D6FF  A8                    tay
D700  8A                    txa
D701  20 D9 D6              jsr fac_u16
D704  A9 80                 lda #$80
D706  85 85                 sta fac_s
D708  60                    rts
                    
                    ; FAC の小数部を切り捨てる(0 に向けて)。A = 切り捨てたビットがあれば0以外
                    ; (FAC は丸め済みで、指数が 129 から 159 のとき)
                    fac_chop:
D709  38                    sec
D70A  A5 80                 lda fac_e
D70C  E9 80                 sbc #128
D70E  85 8E                 sta ft0                 ; 整数部のビット数
D710  64 8F                 stz ft1                 ; 切り捨てたビット
D712  A2 00                 ldx #0
                    fch_1:
D714  A5 8E                 lda ft0
D716  C9 08                 cmp #8
D718  B0 17                 bcs fch_full
D71A  A8                    tay
D71B  B9 3D D7              lda chop_mask,Y
D71E  49 FF                 eor #$FF
D720  35 81                 and fac_m1,X
D722  05 8F                 ora ft1
D724  85 8F                 sta ft1
D726  B9 3D D7              lda chop_mask,Y
D729  35 81                 and fac_m1,X
D72B  95 81                 sta fac_m1,X
D72D  64 8E                 stz ft0
D72F  80 04                 bra fch_next
                    fch_full:
D731  E9 08                 sbc #8
D733  85 8E                 sta ft0
                    fch_next:
D735  E8                    inx
D736  E0 04                 cpx #4
D738  D0 DA                 bne fch_1
D73A  A5 8F                 lda ft1
D73C  60                    rts
                    chop_mask:
D73D  00 80 C0 E0 +         .byte $00, $80, $C0, $E0, $F0, $F8, $FC, $FE
                    
                    ; FAC = FAC 以下の最大の整数(INT)
                    fac_int:
D745  20 B7 D3              jsr fac_round
D748  A5 80                 lda fac_e
D74A  C9 A0                 cmp #128+32
D74C  B0 29                 bcs fint_done           ; すでに整数
D74E  C9 81                 cmp #129
D750  B0 12                 bcs fint_chop
D752  A5 80                 lda fac_e               ; |x| < 1
D754  F0 21                 beq fint_done
D756  A5 85                 lda fac_s
D758  30 03                 bmi fint_m1
D75A  4C A5 D3              jmp fac_zero
                    fint_m1:
D75D  A9 D9                 lda #<c_mone
D75F  A0 DA                 ldy #>c_mone
D761  4C F3 D2              jmp fac_ld
                    fint_chop:
D764  20 09 D7              jsr fac_chop
D767  F0 0E                 beq fint_done
D769  A5 85                 lda fac_s
D76B  10 0A                 bpl fint_done
D76D  A9 D9                 lda #<c_mone            ; 負で小数があった: さらに1を引く
D76F  A0 DA                 ldy #>c_mone
D771  20 1C D3              jsr arg_ld
D774  4C 3C D4              jmp fadd
                    fint_done:
D777  60                    rts
                    
                    ; FAC を整数に(0 に向けて切り捨て)して linnum に置く。-32768 から 65535 まで。
                    ; 範囲外なら FC エラー
                    getint16:
D778  20 B7 D3              jsr fac_round
D77B  64 B5                 stz linnum
D77D  64 B6                 stz linnum+1
D77F  A5 80                 lda fac_e
D781  C9 81                 cmp #129
D783  90 38                 bcc gi_done             ; |x| < 1 なら 0
D785  C9 91                 cmp #128+17
D787  B0 35                 bcs gi_fc               ; 65536 以上
D789  A5 81                 lda fac_m1
D78B  85 B6                 sta linnum+1
D78D  A5 82                 lda fac_m2
D78F  85 B5                 sta linnum
D791  38                    sec
D792  A9 90                 lda #128+16
D794  E5 80                 sbc fac_e
D796  AA                    tax
D797  F0 07                 beq gi_sign
                    gi_1:
D799  46 B6                 lsr linnum+1
D79B  66 B5                 ror linnum
D79D  CA                    dex
D79E  D0 F9                 bne gi_1
                    gi_sign:
D7A0  A5 85                 lda fac_s
D7A2  10 19                 bpl gi_done
D7A4  A5 B6                 lda linnum+1            ; 負: 32768 まで
D7A6  C9 80                 cmp #$80
D7A8  90 06                 bcc gi_neg
D7AA  D0 12                 bne gi_fc
D7AC  A5 B5                 lda linnum
D7AE  D0 0E                 bne gi_fc
                    gi_neg:
D7B0  38                    sec
D7B1  A9 00                 lda #0
D7B3  E5 B5                 sbc linnum
D7B5  85 B5                 sta linnum
D7B7  A9 00                 lda #0
D7B9  E5 B6                 sbc linnum+1
D7BB  85 B6                 sta linnum+1
                    gi_done:
D7BD  60                    rts
                    gi_fc:
D7BE  4C CA DA              jmp err_fc
                    
                    ; FAC を 0-255 の整数にして A と X に。範囲外なら FC エラー
                    getbyte:
D7C1  20 78 D7              jsr getint16
D7C4  A5 B6                 lda linnum+1
D7C6  D0 F6                 bne gi_fc
D7C8  A5 B5                 lda linnum
D7CA  AA                    tax
D7CB  60                    rts
                    
                    ; FAC(0 以上、2^32 未満)を32ビット整数にして ft0-ft3(上位から)に置く。切り捨て
                    fac_u32:
D7CC  A5 81                 lda fac_m1
D7CE  85 8E                 sta ft0
D7D0  A5 82                 lda fac_m2
D7D2  85 8F                 sta ft1
D7D4  A5 83                 lda fac_m3
D7D6  85 90                 sta ft2
D7D8  A5 84                 lda fac_m4
D7DA  85 91                 sta ft3
D7DC  38                    sec
D7DD  A9 A0                 lda #128+32
D7DF  E5 80                 sbc fac_e
D7E1  AA                    tax
D7E2  F0 0B                 beq fu32_done
                    fu32_1:
D7E4  46 8E                 lsr ft0
D7E6  66 8F                 ror ft1
D7E8  66 90                 ror ft2
D7EA  66 91                 ror ft3
D7EC  CA                    dex
D7ED  D0 F5                 bne fu32_1
                    fu32_done:
D7EF  60                    rts
                    
                    ; ===================================================================
                    ; 文字列から数へ
                    ; ===================================================================
                    
                    ; txtptr の位置から数を読んで FAC に置く(先頭の + - も読む)。
                    ; 読み終わると txtptr は数の次の文字を指す
                    fin:
D7F0  20 A5 D3              jsr fac_zero
D7F3  64 CA                 stz fin_dexp            ; 読むあいだは fin_dexph と合わせた16ビット
D7F5  9C F9 02              stz fin_dexph
D7F8  64 CB                 stz fin_pt
D7FA  64 CC                 stz fin_neg
D7FC  64 CD                 stz fin_nd
D7FE  20 9E A3              jsr chrgot
D801  C9 2D                 cmp #'-'
D803  D0 04                 bne fin_p
D805  C6 CC                 dec fin_neg
D807  80 09                 bra fin_next
                    fin_p:
D809  C9 2B                 cmp #'+'
D80B  F0 05                 beq fin_next
D80D  20 9E A3              jsr chrgot              ; C を「数字か」に戻す
D810  80 03                 bra fin_loop
                    fin_next:
D812  20 98 A3              jsr chrget
                    fin_loop:
D815  B0 3D                 bcs fin_notdig          ; chrget: 数字なら C=0
D817  29 0F                 and #$0F
D819  48                    pha
D81A  A5 80                 lda fac_e               ; 先頭の0は桁に数えない
D81C  D0 04                 bne fin_count
D81E  68                    pla
D81F  48                    pha
D820  F0 08                 beq fin_zero
                    fin_count:
D822  A5 CD                 lda fin_nd
D824  C9 0A                 cmp #10
D826  B0 1E                 bcs fin_skip            ; 10桁を超えた分は読み捨てる
D828  E6 CD                 inc fin_nd
                    fin_zero:
D82A  20 6B D6              jsr mul10
D82D  20 7C D3              jsr fac_to_arg
D830  68                    pla
D831  20 EC D6              jsr fac_u8
D834  20 3C D4              jsr fadd
D837  A5 CB                 lda fin_pt
D839  F0 D7                 beq fin_next
D83B  A5 CA                 lda fin_dexp            ; 小数点より後の桁: 指数を1減らす(16ビット。文字列は255文字までなので正確に数えられる)
D83D  D0 03                 bne fin_dd
D83F  CE F9 02              dec fin_dexph
                    fin_dd:
D842  C6 CA                 dec fin_dexp
D844  80 CC                 bra fin_next
                    fin_skip:
D846  68                    pla
D847  A5 CB                 lda fin_pt
D849  D0 C7                 bne fin_next
D84B  E6 CA                 inc fin_dexp            ; 小数点より前の読み捨てた桁: 指数を1増やす(16ビット)
D84D  D0 C3                 bne fin_next
D84F  EE F9 02              inc fin_dexph           ; 読み捨てる桁が256を超えたとき。文字列は255文字までなので今は通らないが、
                                                    ; 16ビットの数え方をそろえておく
D852  80 BE                 bra fin_next
                    fin_notdig:
D854  C9 2E                 cmp #'.'
D856  D0 08                 bne fin_e
D858  A5 CB                 lda fin_pt
D85A  D0 0C                 bne fin_endj            ; 2つ目の小数点で終わり
D85C  E6 CB                 inc fin_pt
D85E  80 B2                 bra fin_next
                    fin_e:
D860  C9 45                 cmp #'E'
D862  F0 07                 beq fin_e1
D864  C9 65                 cmp #'e'
D866  F0 03                 beq fin_e1
                    fin_endj:
D868  4C EA D8              jmp fin_clamp           ; 数の終わり(fin_clamp は遠いので中継する)
                    fin_e1:
                            ; 指数部: E [+-] 数字(fin_evh と合わせた16ビット)
D86B  64 CE                 stz fin_ev
D86D  9C FA 02              stz fin_evh
D870  64 CF                 stz fin_eneg
D872  20 98 A3              jsr chrget
D875  C9 2D                 cmp #'-'
D877  D0 04                 bne fin_ep
D879  C6 CF                 dec fin_eneg
D87B  80 09                 bra fin_en
                    fin_ep:
D87D  C9 2B                 cmp #'+'
D87F  F0 05                 beq fin_en
D881  20 9E A3              jsr chrgot
D884  80 03                 bra fin_eloop
                    fin_en:
D886  20 98 A3              jsr chrget
                    fin_eloop:
D889  B0 39                 bcs fin_edone
D88B  29 0F                 and #$0F
D88D  85 8E                 sta ft0
D88F  AD FA 02              lda fin_evh             ; ev = ev × 10 + 数字。100 以上に10をかけるなら 1000 にする
D892  D0 25                 bne fin_ebig            ; (1000 は、桁から決めた指数(最大 ±255)と打ち消し合っても、
D894  A5 CE                 lda fin_ev              ;  必ずあふれるか 0 になる大きさ)
D896  C9 64                 cmp #100
D898  B0 1F                 bcs fin_ebig
D89A  0A                    asl                     ; 2ev(198 以下)
D89B  85 8F                 sta ft1
D89D  0A                    asl                     ; 4ev
D89E  2E FA 02              rol fin_evh
D8A1  0A                    asl                     ; 8ev
D8A2  2E FA 02              rol fin_evh
D8A5  18                    clc
D8A6  65 8F                 adc ft1                 ; 8ev + 2ev
D8A8  90 03                 bcc fin_e2
D8AA  EE FA 02              inc fin_evh
                    fin_e2:
D8AD  18                    clc
D8AE  65 8E                 adc ft0
D8B0  85 CE                 sta fin_ev
D8B2  90 D2                 bcc fin_en
D8B4  EE FA 02              inc fin_evh
D8B7  80 CD                 bra fin_en
                    fin_ebig:
D8B9  A9 E8                 lda #<1000
D8BB  85 CE                 sta fin_ev
D8BD  A9 03                 lda #>1000
D8BF  8D FA 02              sta fin_evh
D8C2  80 C2                 bra fin_en
                    fin_edone:
D8C4  24 CF                 bit fin_eneg            ; 指数 = 桁から決めた指数 ± 指数部(16ビット)
D8C6  30 12                 bmi fin_esub
D8C8  18                    clc
D8C9  A5 CA                 lda fin_dexp
D8CB  65 CE                 adc fin_ev
D8CD  85 CA                 sta fin_dexp
D8CF  AD F9 02              lda fin_dexph
D8D2  6D FA 02              adc fin_evh
D8D5  8D F9 02              sta fin_dexph
D8D8  80 10                 bra fin_clamp
                    fin_esub:
D8DA  38                    sec
D8DB  A5 CA                 lda fin_dexp
D8DD  E5 CE                 sbc fin_ev
D8DF  85 CA                 sta fin_dexp
D8E1  AD F9 02              lda fin_dexph
D8E4  ED FA 02              sbc fin_evh
D8E7  8D F9 02              sta fin_dexph
                    fin_clamp:
                            ; 16ビットの指数を、符号付き1バイト(-128 から 127)に収める。
                            ; 収まらないほど大きければ答えは ?OV、小さければ 0 なので、端に止めてよい
D8EA  A5 CA                 lda fin_dexp
D8EC  30 09                 bmi fcl_neg
D8EE  AD F9 02              lda fin_dexph           ; 下位が 0-127: 上位が 0 なら収まる
D8F1  F0 18                 beq fin_scale
D8F3  30 12                 bmi fcl_min
D8F5  80 0A                 bra fcl_max
                    fcl_neg:
D8F7  AD F9 02              lda fin_dexph           ; 下位が 128-255: 上位が $FF なら収まる
D8FA  C9 FF                 cmp #$FF
D8FC  F0 0D                 beq fin_scale
D8FE  AA                    tax
D8FF  30 06                 bmi fcl_min
                    fcl_max:
D901  A9 7F                 lda #127
D903  85 CA                 sta fin_dexp
D905  80 04                 bra fin_scale
                    fcl_min:
D907  A9 80                 lda #$80
D909  85 CA                 sta fin_dexp
                    fin_scale:
D90B  A5 CA                 lda fin_dexp            ; 10 のべき乗をかける
D90D  F0 10                 beq fin_sign
D90F  30 07                 bmi fin_down
D911  20 6B D6              jsr mul10
D914  C6 CA                 dec fin_dexp
D916  80 F3                 bra fin_scale
                    fin_down:
D918  20 86 D6              jsr div10
D91B  E6 CA                 inc fin_dexp
D91D  80 EC                 bra fin_scale
                    fin_sign:
D91F  A5 CC                 lda fin_neg
D921  F0 03                 beq fin_done
D923  20 AC D3              jsr fac_neg
                    fin_done:
D926  60                    rts
                    
                    ; ===================================================================
                    ; 数から文字列へ
                    ; ===================================================================
                    
                    ; FAC を文字列にして fbuffr に置く(0 で終わる)。先頭は符号(空白か -)
                    ; 有効数字9桁。大きすぎる数、小さすぎる数は 1.2345E+12 の形にする
                    fout:
D927  A9 20                 lda #' '
D929  A6 85                 ldx fac_s
D92B  10 02                 bpl fo_1
D92D  A9 2D                 lda #'-'
                    fo_1:
D92F  8D 98 03              sta fbuffr
D932  A5 80                 lda fac_e
D934  D0 09                 bne fo_nz
D936  A9 30                 lda #'0'
D938  8D 99 03              sta fbuffr+1
D93B  9C 9A 03              stz fbuffr+2
D93E  60                    rts
                    fo_nz:
D93F  64 85                 stz fac_s
D941  64 CA                 stz fin_dexp
                    fo_big:
D943  A9 E8                 lda #<c_1e9             ; 1E9 以上なら 10 で割る
D945  A0 DA                 ldy #>c_1e9
D947  20 1C D3              jsr arg_ld
D94A  20 96 D6              jsr fcmp_nr
D94D  C9 01                 cmp #1
D94F  F0 07                 beq fo_small
D951  20 86 D6              jsr div10
D954  E6 CA                 inc fin_dexp
D956  80 EB                 bra fo_big
                    fo_small:
D958  A9 E3                 lda #<c_1e8             ; 1E8 未満なら 10 をかける
D95A  A0 DA                 ldy #>c_1e8
D95C  20 1C D3              jsr arg_ld
D95F  20 96 D6              jsr fcmp_nr
D962  C9 01                 cmp #1
D964  D0 07                 bne fo_round
D966  20 6B D6              jsr mul10
D969  C6 CA                 dec fin_dexp
D96B  80 EB                 bra fo_small
                    fo_round:
D96D  A9 CF                 lda #<c_half            ; 四捨五入して整数に
D96F  A0 DA                 ldy #>c_half
D971  20 1C D3              jsr arg_ld
D974  20 3C D4              jsr fadd
D977  20 CC D7              jsr fac_u32             ; 切り捨て(丸めると x.97 が繰り上がってしまう)
D97A  A5 8E                 lda ft0                 ; 1E9 になったら 1E8 にする
D97C  C9 3B                 cmp #$3B
D97E  D0 20                 bne fo_digits
D980  A5 8F                 lda ft1
D982  C9 9A                 cmp #$9A
D984  D0 1A                 bne fo_digits
D986  A5 90                 lda ft2
D988  C9 CA                 cmp #$CA
D98A  D0 14                 bne fo_digits
D98C  A5 91                 lda ft3
D98E  D0 10                 bne fo_digits
D990  A9 05                 lda #$05
D992  85 8E                 sta ft0
D994  A9 F5                 lda #$F5
D996  85 8F                 sta ft1
D998  A9 E1                 lda #$E1
D99A  85 90                 sta ft2
D99C  64 91                 stz ft3
D99E  E6 CA                 inc fin_dexp
                    fo_digits:
D9A0  A2 00                 ldx #0                  ; 10^8 から順に引いて各桁を出す
D9A2  A0 00                 ldy #0
                    fo_d1:
D9A4  A9 30                 lda #'0'
D9A6  99 A8 03              sta fodig,Y
                    fo_d2:
D9A9  38                    sec
D9AA  A5 91                 lda ft3
D9AC  FD 43 DC              sbc pow10_tab+3,X
D9AF  85 95                 sta ft7
D9B1  A5 90                 lda ft2
D9B3  FD 42 DC              sbc pow10_tab+2,X
D9B6  85 94                 sta ft6
D9B8  A5 8F                 lda ft1
D9BA  FD 41 DC              sbc pow10_tab+1,X
D9BD  85 93                 sta ft5
D9BF  A5 8E                 lda ft0
D9C1  FD 40 DC              sbc pow10_tab,X
D9C4  90 17                 bcc fo_d3
D9C6  85 8E                 sta ft0
D9C8  A5 93                 lda ft5
D9CA  85 8F                 sta ft1
D9CC  A5 94                 lda ft6
D9CE  85 90                 sta ft2
D9D0  A5 95                 lda ft7
D9D2  85 91                 sta ft3
D9D4  B9 A8 03              lda fodig,Y
D9D7  1A                    inc
D9D8  99 A8 03              sta fodig,Y
D9DB  80 CC                 bra fo_d2
                    fo_d3:
D9DD  E8                    inx
D9DE  E8                    inx
D9DF  E8                    inx
D9E0  E8                    inx
D9E1  C8                    iny
D9E2  C0 09                 cpy #9
D9E4  D0 BE                 bne fo_d1
                            ; 最後の0を除いた桁数
D9E6  A0 09                 ldy #9
                    fo_t1:
D9E8  C0 01                 cpy #1
D9EA  F0 0A                 beq fo_t2
D9EC  B9 A7 03              lda fodig-1,Y
D9EF  C9 30                 cmp #'0'
D9F1  D0 03                 bne fo_t2
D9F3  88                    dey
D9F4  80 F2                 bra fo_t1
                    fo_t2:
D9F6  8C D8 03              sty fo_nd
D9F9  18                    clc                     ; 小数点の位置 = 指数 + 9
D9FA  A5 CA                 lda fin_dexp
D9FC  69 09                 adc #9
D9FE  8D D7 03              sta fo_e
DA01  A2 01                 ldx #1                  ; fbuffr の書く位置
DA03  A0 00                 ldy #0                  ; fodig の読む位置
DA05  AD D7 03              lda fo_e
DA08  30 59                 bmi fo_sci
DA0A  F0 37                 beq fo_frac
DA0C  C9 0A                 cmp #10
DA0E  B0 53                 bcs fo_sci
                            ; 1 <= E <= 9: 整数部と小数部
                    fo_i1:
DA10  CC D7 03              cpy fo_e
DA13  F0 11                 beq fo_i3
DA15  A9 30                 lda #'0'
DA17  CC D8 03              cpy fo_nd
DA1A  B0 03                 bcs fo_i2
DA1C  B9 A8 03              lda fodig,Y
                    fo_i2:
DA1F  9D 98 03              sta fbuffr,X
DA22  E8                    inx
DA23  C8                    iny
DA24  80 EA                 bra fo_i1
                    fo_i3:
DA26  CC D8 03              cpy fo_nd
DA29  90 03                 bcc *+5
DA2B  4C BC DA              jmp fo_end
DA2E  A9 2E                 lda #'.'
DA30  9D 98 03              sta fbuffr,X
DA33  E8                    inx
                    fo_i4:
DA34  B9 A8 03              lda fodig,Y
DA37  9D 98 03              sta fbuffr,X
DA3A  E8                    inx
DA3B  C8                    iny
DA3C  CC D8 03              cpy fo_nd
DA3F  D0 F3                 bne fo_i4
DA41  80 79                 bra fo_end
                    fo_frac:
                            ; E = 0 か -1: .ddd か .0ddd
DA43  A9 2E                 lda #'.'
DA45  9D 98 03              sta fbuffr,X
DA48  E8                    inx
DA49  AD D7 03              lda fo_e
DA4C  F0 06                 beq fo_f2
DA4E  A9 30                 lda #'0'
DA50  9D 98 03              sta fbuffr,X
DA53  E8                    inx
                    fo_f2:
DA54  B9 A8 03              lda fodig,Y
DA57  9D 98 03              sta fbuffr,X
DA5A  E8                    inx
DA5B  C8                    iny
DA5C  CC D8 03              cpy fo_nd
DA5F  D0 F3                 bne fo_f2
DA61  80 59                 bra fo_end
                    fo_sci:
DA63  C9 FF                 cmp #$FF                ; E = -1 も小数の形
DA65  F0 DC                 beq fo_frac
DA67  AD A8 03              lda fodig               ; d.dddE+xx
DA6A  9D 98 03              sta fbuffr,X
DA6D  E8                    inx
DA6E  C8                    iny
DA6F  CC D8 03              cpy fo_nd
DA72  F0 13                 beq fo_s2
DA74  A9 2E                 lda #'.'
DA76  9D 98 03              sta fbuffr,X
DA79  E8                    inx
                    fo_s1:
DA7A  B9 A8 03              lda fodig,Y
DA7D  9D 98 03              sta fbuffr,X
DA80  E8                    inx
DA81  C8                    iny
DA82  CC D8 03              cpy fo_nd
DA85  D0 F3                 bne fo_s1
                    fo_s2:
DA87  A9 45                 lda #'E'
DA89  9D 98 03              sta fbuffr,X
DA8C  E8                    inx
DA8D  AD D7 03              lda fo_e                ; 指数 = E - 1
DA90  38                    sec
DA91  E9 01                 sbc #1
DA93  30 04                 bmi fo_sneg
DA95  A0 2B                 ldy #'+'
DA97  80 07                 bra fo_s3
                    fo_sneg:
DA99  49 FF                 eor #$FF
DA9B  18                    clc
DA9C  69 01                 adc #1
DA9E  A0 2D                 ldy #'-'
                    fo_s3:
DAA0  48                    pha
DAA1  98                    tya
DAA2  9D 98 03              sta fbuffr,X
DAA5  E8                    inx
DAA6  68                    pla
DAA7  A0 2F                 ldy #'0'-1              ; 10 の位
                    fo_s4:
DAA9  C8                    iny
DAAA  38                    sec
DAAB  E9 0A                 sbc #10
DAAD  B0 FA                 bcs fo_s4
DAAF  69 3A                 adc #10+'0'
DAB1  48                    pha
DAB2  98                    tya
DAB3  9D 98 03              sta fbuffr,X
DAB6  E8                    inx
DAB7  68                    pla
DAB8  9D 98 03              sta fbuffr,X
DABB  E8                    inx
                    fo_end:
DABC  9E 98 03              stz fbuffr,X
DABF  60                    rts
                    
                    ; ---- エラー ----
                    err_ov:
DAC0  A2 01                 ldx #EN_OV
DAC2  4C 8E A8              jmp b_error
                    err_div0:
DAC5  A2 02                 ldx #EN_DIV0
DAC7  4C 8E A8              jmp b_error
                    err_fc:
DACA  A2 03                 ldx #EN_FC
DACC  4C 8E A8              jmp b_error
                    
                    ; 浮動小数点の定数(tools/mkfpconst.js が生成。手で直さないこと)
                    
DACF  80 00 00 00 + c_half:       .byte $80, $00, $00, $00, $00   ; 0.5
DAD4  81 00 00 00 + c_one:        .byte $81, $00, $00, $00, $00   ; 1
DAD9  81 80 00 00 + c_mone:       .byte $81, $80, $00, $00, $00   ; -1
DADE  84 20 00 00 + c_ten:        .byte $84, $20, $00, $00, $00   ; 10
DAE3  9B 3E BC 20 + c_1e8:        .byte $9B, $3E, $BC, $20, $00   ; 100000000
DAE8  9E 6E 6B 28 + c_1e9:        .byte $9E, $6E, $6B, $28, $00   ; 1000000000
DAED  82 49 0F DA + c_pi:         .byte $82, $49, $0F, $DA, $A2   ; 3.141592653589793
DAF2  81 49 0F DA + c_halfpi:     .byte $81, $49, $0F, $DA, $A2   ; 1.5707963267948966
DAF7  80 22 F9 83 + c_2_pi:       .byte $80, $22, $F9, $83, $6E   ; 0.6366197723675814
DAFC  80 49 0F DA + c_pio4:       .byte $80, $49, $0F, $DA, $A2   ; 0.7853981633974483
DB01  81 49 00 00 + c_pio2_1:     .byte $81, $49, $00, $00, $00   ; 1.5703125
DB06  75 7D 00 00 + c_pio2_2:     .byte $75, $7D, $00, $00, $00   ; 0.0004825592041015625
DB0B  6D 2A 00 00 + c_pio2_3:     .byte $6D, $2A, $00, $00, $00   ; 0.0000012665987014770508
DB10  63 08 00 00 + c_pio2_4:     .byte $63, $08, $00, $00, $00   ; 9.89530235528946e-10
DB15  5A 34 61 1A + c_pio2_5:     .byte $5A, $34, $61, $1A, $62   ; 2.563344151594519e-12
DB1A  80 31 72 17 + c_ln2:        .byte $80, $31, $72, $17, $F8   ; 0.6931471805599453
DB1F  80 31 80 00 + c_ln2hi:      .byte $80, $31, $80, $00, $00   ; 0.693359375
DB24  74 DE 80 82 + c_ln2lo:      .byte $74, $DE, $80, $82, $E3   ; -0.00021219444005471377
DB29  81 38 AA 3B + c_inv_ln2:    .byte $81, $38, $AA, $3B, $29   ; 1.4426950408889634
DB2E  7F 5E 5B D8 + c_inv_ln10:   .byte $7F, $5E, $5B, $D8, $A9   ; 0.43429448190325176
DB33  80 35 04 F3 + c_sqrthalf:   .byte $80, $35, $04, $F3, $34   ; 0.7071067811865476
DB38  7B 0E FA 35 + c_deg2rad:    .byte $7B, $0E, $FA, $35, $13   ; 0.017453292519943295
DB3D  89 34 00 00 + c_360:        .byte $89, $34, $00, $00, $00   ; 360
DB42  78 36 0B 60 + c_inv360:     .byte $78, $36, $0B, $60, $B6   ; 0.002777777777777778
DB47  87 34 00 00 + c_90:         .byte $87, $34, $00, $00, $00   ; 90
DB4C  86 34 00 00 + c_45:         .byte $86, $34, $00, $00, $00   ; 45
DB51  86 65 2E E0 + c_rad2deg:    .byte $86, $65, $2E, $E0, $D3   ; 57.29577951308232
DB56  7F 09 30 A2 + c_tan15:      .byte $7F, $09, $30, $A2, $F5   ; 0.2679491924311227
DB5B  81 5D B3 D7 + c_sqrt3:      .byte $81, $5D, $B3, $D7, $43   ; 1.7320508075688772
DB60  80 06 0A 91 + c_pi6:        .byte $80, $06, $0A, $91, $C1   ; 0.5235987755982988
DB65  87 32 00 00 + c_89:         .byte $87, $32, $00, $00, $00   ; 89
DB6A  90 00 00 00 + c_32768:      .byte $90, $00, $00, $00, $00   ; 32768
DB6F  86 48 00 00 + c_50:         .byte $86, $48, $00, $00, $00   ; 50
DB74  90 07 E2 00 + c_beepk:      .byte $90, $07, $E2, $00, $00   ; 34786
DB79  83 C9 47 AE + c_beepofs:    .byte $83, $C9, $47, $AE, $14   ; -6.29
                    
                    sin_poly:
DB7E  08                    .byte 8
DB7F  58 D7 3F 9F +         .byte $58, $D7, $3F, $9F, $3A   ; -7.647163731819816e-13
DB84  60 30 92 30 +         .byte $60, $30, $92, $30, $9D   ; 1.6059043836821613e-10
