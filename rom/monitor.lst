                    ; オペコード -> アドレッシングの番号
                    op_mode:
F9A3  00 06 11 10 +         .byte $00, $06, $11, $10, $03, $03, $03, $03, $00, $02, $01, $10, $09, $09, $09, $0F   ; $00
F9B3  0E 07 08 10 +         .byte $0E, $07, $08, $10, $03, $04, $04, $03, $00, $0B, $01, $10, $09, $0A, $0A, $0F   ; $10
F9C3  09 06 11 10 +         .byte $09, $06, $11, $10, $03, $03, $03, $03, $00, $02, $01, $10, $09, $09, $09, $0F   ; $20
