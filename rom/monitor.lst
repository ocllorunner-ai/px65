F9F3  0E 07 08 10 +         .byte $0E, $07, $08, $10, $11, $04, $04, $03, $00, $0B, $00, $10, $12, $0A, $0A, $0F   ; $50
FA03  00 06 11 10 +         .byte $00, $06, $11, $10, $03, $03, $03, $03, $00, $02, $01, $10, $0C, $09, $09, $0F   ; $60
FA13  0E 07 08 10 +         .byte $0E, $07, $08, $10, $04, $04, $04, $03, $00, $0B, $00, $10, $0D, $0A, $0A, $0F   ; $70
FA23  0E 06 11 10 +         .byte $0E, $06, $11, $10, $03, $03, $03, $03, $00, $02, $00, $10, $09, $09, $09, $0F   ; $80
FA33  0E 07 08 10 +         .byte $0E, $07, $08, $10, $04, $04, $05, $03, $00, $0B, $00, $10, $09, $0A, $0A, $0F   ; $90
FA43  02 06 02 10 +         .byte $02, $06, $02, $10, $03, $03, $03, $03, $00, $02, $00, $10, $09, $09, $09, $0F   ; $A0
