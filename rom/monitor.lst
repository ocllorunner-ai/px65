FA63  02 06 11 10 +         .byte $02, $06, $11, $10, $03, $03, $03, $03, $00, $02, $00, $00, $09, $09, $09, $0F   ; $C0
FA73  0E 07 08 10 +         .byte $0E, $07, $08, $10, $11, $04, $04, $03, $00, $0B, $00, $00, $12, $0A, $0A, $0F   ; $D0
FA83  02 06 11 10 +         .byte $02, $06, $11, $10, $03, $03, $03, $03, $00, $02, $00, $10, $09, $09, $09, $0F   ; $E0
FA93  0E 07 08 10 +         .byte $0E, $07, $08, $10, $11, $04, $04, $03, $00, $0B, $00, $10, $12, $0A, $0A, $0F   ; $F0
                    
                    ; ニーモニック(3文字ずつ)。RMB/SMB/BBR/BBS のビット番号は表示するときに付け足す
                    mnem_text:
FAA3  42 52 4B              .byte "BRK"   ; 0
FAA6  4F 52 41              .byte "ORA"   ; 1
