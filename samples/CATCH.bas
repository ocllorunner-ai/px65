10 CLS:RANDOMIZE:P=44:S=0:M=0
20 X=INT(RND(1)*92)+2:Y=8
30 K$=INKEY$
40 IF K$=CHR$(17) AND P>0 THEN P=P-4
50 IF K$=CHR$(18) AND P<88 THEN P=P+4
60 LINE 0,31,95,31,0:LINE P,31,P+7,31
70 PSET X,Y,0:Y=Y+1:PSET X,Y
80 IF Y<30 THEN 30
90 IF X>=P AND X<=P+7 THEN S=S+1:BEEP 1500,3:GOTO 100
95 M=M+1:BEEP 200,20
100 PSET X,Y,0:LOCATE 0,0:PRINT "HIT";S;"MISS";M
110 IF M<3 THEN 20
120 LOCATE 0,1:PRINT "GAME OVER"
